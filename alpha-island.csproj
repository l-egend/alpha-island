<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- 必须带 Windows 目标平台版本，才能拿到 WinRT 投影（SMTC / Windows.Media.Control） -->
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Nested modules' build caches must never be compiled into the WPF application. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<!-- 只在 Windows x64 Release 发布时预编译；开发构建继续使用普通 IL。 -->
		<PublishReadyToRun Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">true</PublishReadyToRun>
		<!-- 项目/程序集名带连字符，C# 命名空间不允许 '-'，必须显式指定根命名空间 -->
		<RootNamespace>alpha_island</RootNamespace>
		<!-- C 组①：exe 的 Win32 图标（多尺寸 16/24/32/48/64/256，由 tools\make-icon.ps1 生成） -->
		<ApplicationIcon>Assets\alpha-island.ico</ApplicationIcon>
		<!-- 程序集元数据：任务管理器/文件属性里显示的品牌信息 -->
		<AssemblyTitle>Alpha Island</AssemblyTitle>
		<Product>Alpha Island</Product>
		<Company>Alpha Island</Company>
		<Description>灵动岛风格的桌面状态面板与 AI 助手</Description>
		<Version>0.1.114</Version>
		<FileVersion>0.1.114.0</FileVersion>
		<Copyright>© Alpha Island</Copyright>
	</PropertyGroup>

	<ItemGroup>
	  <!-- Pin runtime packs for installers without overriding the Windows SDK projection pack. -->
	  <FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App;Microsoft.WindowsDesktop.App.WPF;Microsoft.WindowsDesktop.App.WindowsForms"
	                      RuntimeFrameworkVersion="$(InstallerRuntimeVersion)" Condition="'$(InstallerRuntimeVersion)' != ''" />
	  <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="NAudio" Version="2.2.1" />
	  <PackageReference Include="ZXing.Net" Version="0.16.11" />
	  <Compile Remove="tools\RegressionTests\**\*.cs" />
	  <Compile Remove="tools\PluginFixture\**\*.cs" />
	  <Compile Remove="PluginSdk\**\*.cs;examples\**\*.cs" />
	  <Compile Remove="Hardware\**\*.cs;ConversationCore\**\*.cs" />
      <Page Remove="ConversationCore\**\*.xaml" />
      <ProjectReference Include="ConversationCore\AlphaIsland.ConversationCore.csproj" />
	  <Page Remove="PluginSdk\**\*.xaml;examples\**\*.xaml" />
	  <ProjectReference Include="PluginSdk\AlphaIsland.PluginSdk.csproj" />
	  <ProjectReference Include="Hardware\AlphaIsland.Hardware.csproj" />
	  <InternalsVisibleTo Include="AlphaIsland.RegressionTests" />
	</ItemGroup>

	<!-- WPF 资源：窗口 Icon 与托盘图标都从这里按 pack URI 取（用户可在 exe 旁替换同名文件重编译，或直接放 user 覆盖图标） -->
	<ItemGroup>
	  <Resource Include="Assets\alpha-island.ico" />
	  <Resource Include="Assets\alpha-island-source.png" />
	  <Resource Include="Assets\Bluetooth\*.svg" />
  <Resource Include="Assets\Messengers\*.png" />
  <Content Include="Assets\Messengers\SOURCES.md" CopyToOutputDirectory="PreserveNewest" />
	  <Resource Include="Assets\Agents\Gemini\*.png;Assets\Agents\Gemini\manifest.json" />
	  <Resource Include="Assets\Agents\Codex\*.png;Assets\Agents\Codex\manifest.json" />
	  <Resource Include="Assets\Agents\DeepSeek\*.png;Assets\Agents\DeepSeek\manifest.json" />
	  <Resource Include="Assets\Agents\Claude\*.png;Assets\Agents\Claude\manifest.json" />
	  <Content Include="Assets\Bluetooth\LICENSE.bootstrap-icons.txt;Assets\Bluetooth\SOURCES.md" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
