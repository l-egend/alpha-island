<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><EnableDynamicLoading>true</EnableDynamicLoading><AssemblyName>AlphaIsland.Plugins.ApiChat</AssemblyName></PropertyGroup><ItemGroup><ProjectReference Include="$(AlphaIslandSdkProject)" Private="false"/><ProjectReference Include="$(AlphaIslandConversationProject)" Private="false"/><EmbeddedResource Include="Personas/*.txt"/><None Update="plugin.json;README.md;README.en.md" CopyToOutputDirectory="PreserveNewest"/><InternalsVisibleTo Include="AlphaIsland.RegressionTests"/></ItemGroup><Target Name="DeployApiChatPlugin" AfterTargets="Build" Condition="'$(DeployPlugin)' != 'false'">
  <ItemGroup><ApiChatFiles Include="$(TargetPath);$(TargetDir)$(TargetName).pdb;$(TargetDir)$(TargetName).deps.json;$(MSBuildProjectDirectory)\plugin.json;$(MSBuildProjectDirectory)\README.md" /></ItemGroup>
  <Copy SourceFiles="@(ApiChatFiles)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\bin\$(Configuration)\net8.0-windows10.0.19041.0\plugins\ai.api-chat" SkipUnchangedFiles="true" />
</Target></Project>