<UserControl xmlns:loc="clr-namespace:AlphaIsland.PluginSdk.Localization;assembly=AlphaIsland.PluginSdk" x:Class="AlphaIsland.Plugins.ApiChat.ApiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:AlphaIsland.PluginSdk;assembly=AlphaIsland.PluginSdk">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/alpha-island;component/Themes/Win11Settings.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="AiActionButton" TargetType="Button" BasedOn="{StaticResource W11Button}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="96"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="AiEditor" TargetType="TextBox" BasedOn="{StaticResource W11TextBox}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="10,7"/>
            </Style>
            <Style x:Key="AiHint" TargetType="TextBlock" BasedOn="{StaticResource W11RowHint}">
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="AiLabel" TargetType="TextBlock" BasedOn="{StaticResource W11RowLabel}">
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="AiPasswordEditor" TargetType="PasswordBox">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource W11TextPrimary}"/>
                <Setter Property="CaretBrush" Value="{StaticResource W11TextPrimary}"/>
                <Setter Property="Background" Value="{StaticResource W11ControlFill}"/>
                <Setter Property="BorderBrush" Value="{StaticResource W11ControlBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource W11AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel x:Name="AiSettingsRoot" Margin="16,0,16,16">
        <TextBlock Margin="0,26,0,16" Style="{StaticResource W11CardTitle}" Text="{loc:Text Key=S69825479A95E}"/>
        <Border Style="{StaticResource W11Card}">
            <StackPanel>
                <Grid Style="{StaticResource W11Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_AiEnabled">
                        <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text="&#xE99A;"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource AiLabel}" Text="{loc:Text Key=S69825479A95E}"/>
                        <TextBlock Style="{StaticResource AiHint}" Text="{loc:Text Key=S429B0013C89C}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ManageAiHistoryButton" Content="{loc:Text Key=SBCB0CC140BD5}" Click="ManageAiHistory_Click"
                                Style="{StaticResource AiActionButton}" Margin="0,0,12,0"/>
                        <CheckBox x:Name="AiEnabledToggle" Style="{StaticResource W11Switch}" IsEnabled="False"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" VerticalAlignment="Center"
                                  ToolTip="{loc:Text Key=SE7A3DEE88280}"/>
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource W11RowDivider}"/>
                <Grid Style="{StaticResource W11Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="248"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_AiBaseUrl">
                        <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text="&#xE774;"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource AiLabel}" Text="{loc:Text Key=S03B11112DC97}"/>
                        <TextBlock Style="{StaticResource AiHint}" Text="{loc:Text Key=S17C1CCDBB1D8}"/>
                    </StackPanel>
                    <TextBox x:Name="AiBaseUrlBox" Grid.Column="2" Style="{StaticResource AiEditor}"
                             VerticalAlignment="Center" TextChanged="TextBox_Changed"/>
                </Grid>
                <Border Style="{StaticResource W11RowDivider}"/>
                <Grid Style="{StaticResource W11Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="248"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_AiApiKey">
                        <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text="&#xE72E;"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource AiLabel}" Text="API Key"/>
                        <TextBlock x:Name="AiApiKeyState" Style="{StaticResource AiHint}" Text="{loc:Text Key=S3739B2FE9BA4}"/>
                    </StackPanel>
                    <PasswordBox x:Name="AiApiKeyBox" Grid.Column="2" Style="{StaticResource AiPasswordEditor}"
                                 VerticalAlignment="Center" PasswordChanged="PasswordBox_Changed"/>
                </Grid>
                <Grid x:Name="AiKeyActions" Width="248" HorizontalAlignment="Right" Margin="0,0,16,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="SaveAiKeyButton" Content="{loc:Text Key=SA334BB468ABA}" Click="SaveAiKeyButton_Click"
                            Style="{StaticResource AiActionButton}" Margin="0,0,4,0"/>
                    <Button x:Name="ClearAiKeyButton" Grid.Column="1" Content="{loc:Text Key=S311D71A2B67A}" Click="ClearAiKeyButton_Click"
                            Style="{StaticResource AiActionButton}" Margin="4,0,0,0"/>
                </Grid>
                <Border Style="{StaticResource W11RowDivider}"/>
                <Grid Style="{StaticResource W11Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="248"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_AiModel">
                        <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text="&#xE9D9;"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource AiLabel}" Text="{loc:Text Key=SC98E118E0A43}"/>
                        <TextBlock Style="{StaticResource AiHint}" Text="{loc:Text Key=S2101E5D2CA09}"/>
                    </StackPanel>
                    <ComboBox x:Name="AiModelBox" Grid.Column="2" IsEditable="True" IsTextSearchEnabled="False" MinHeight="36"
                              VerticalAlignment="Center" MaxDropDownHeight="240" SelectionChanged="AiModel_SelectionChanged" FontSize="12"/>
                </Grid>
                <Grid x:Name="AiModelActions" Width="248" HorizontalAlignment="Right" Margin="0,0,16,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="ConnectAiModelsButton" Content="{loc:Text Key=S1CEB123DAB26}" Click="ConnectAiModelsButton_Click"
                            Style="{StaticResource AiActionButton}" Margin="0,0,8,0"/>
                    <Button x:Name="TestAiModelButton" Grid.Column="1" Content="{loc:Text Key=SD4BEE4A21713}" IsEnabled="False"
                            Click="TestAiModelButton_Click" Style="{StaticResource AiActionButton}" ToolTip="{loc:Text Key=S5BFC64A72C69}"/>
                </Grid>
                <TextBlock x:Name="AiConnectionStatus" Text="{loc:Text Key=S4807F9F188C5}" Style="{StaticResource AiHint}" Margin="62,0,16,14"/>
                <Border Style="{StaticResource W11RowDivider}"/>
                <Grid Style="{StaticResource W11Row}" Margin="16,12,16,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="248"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_AiSystemPrompt">
                        <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text="&#xE8D2;"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AiPersonaTitleText" Style="{StaticResource AiLabel}" Text="{loc:Text Key=SFB14099D469D}"/>
                        <TextBlock Style="{StaticResource AiHint}" Text="{loc:Text Key=SE737FB58D792}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBox x:Name="AiSystemPromptBox" Style="{StaticResource AiEditor}" Height="80" MaxLength="8000"
                                 VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" TextChanged="TextBox_Changed"/>
                        <TextBlock x:Name="AiPersonaStatusText" Style="{StaticResource AiHint}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" Margin="0,6,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button x:Name="AiPersonaImportButton" Content="{loc:Text Key=S7F1F2C50C396}" Style="{StaticResource AiActionButton}" Click="ImportPersona_Click"/>
                            <Button x:Name="AiPersonaFolderButton" Grid.Column="2" Content="{loc:Text Key=SED66422B6CEE}" Style="{StaticResource AiActionButton}" Click="OpenPersonaFolder_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                <Button x:Name="OpenAiConversationButton" Content="{loc:Text Key=SBD0E4C65B874}" Click="OpenAiConversation_Click"
                        Style="{StaticResource AiActionButton}" HorizontalAlignment="Right" Margin="16,0,16,16"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
