<UserControl xmlns:loc="clr-namespace:AlphaIsland.PluginSdk.Localization;assembly=AlphaIsland.PluginSdk" x:Class="AlphaIsland.Plugins.ApiChat.ApiChatView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="clr-namespace:AlphaIsland.PluginSdk;assembly=AlphaIsland.PluginSdk"><Grid x:Name="AiCardLayer">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 行 0：头部（状态徽标、模型/状态文字、复制/重试/停止/清空） -->
                            <Grid Grid.Row="0" Margin="6,6,6,4">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="AiAvatarHost" Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                        Background="#2200E5FF" BorderBrush="#3300E5FF" BorderThickness="1">
                                    <icons:GlyphIcon x:Name="AiStatusGlyph" Text="&#xE99A;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentCyan}"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Text Key=S69825479A95E}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="AiStatusText" Text="{loc:Text Key=SB073DB9C0BD6}" FontSize="9.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextTertiary}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="AiCopyButton" Style="{StaticResource TransportButton}"
                                            Width="26" Height="26" FontSize="11" Content="&#xE8C8;"
                                            ToolTip="{loc:Text Key=S9B393193D999}" Click="AiCopyButton_Click"/>
                                    <Button x:Name="AiRetryButton" Style="{StaticResource TransportButton}"
                                            Width="26" Height="26" FontSize="14" Margin="4,0,0,0" Content="&#xE777;"
                                            ToolTip="{loc:Text Key=S137CC41A5B20}" Click="AiRetryButton_Click"/>
                                    <Button x:Name="AiStopButton" Style="{StaticResource TransportButton}"
                                            Width="26" Height="26" FontSize="11" Margin="4,0,0,0" Content="&#xE71A;"
                                            ToolTip="{loc:Text Key=S9AD0AAC32EA3}" Visibility="Collapsed" Click="AiStopButton_Click"/>
                                    <Button x:Name="AiClearButton" Style="{StaticResource TransportButton}"
                                            Width="26" Height="26" FontSize="17" Margin="4,0,0,0" Content="&#xE74D;"
                                            ToolTip="{loc:Text Key=S66EE5475EF04}" Click="AiClearButton_Click"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button x:Name="AiHistoryButton" Content="{loc:Text Key=S7FBCBCA49EC5}" Width="74" Height="26" Click="AiHistoryButton_Click"/>
                                    <Button x:Name="AiNewButton" Content="{loc:Text Key=S6897A8EF070B}" Width="74" Height="26" Margin="6,0,0,0" Click="AiNewButton_Click"/>
                                    <Button Content="{loc:Text Key=S3179AD447F64}" Width="74" Height="26" Margin="6,0,0,0" Click="AiContextButton_Click"/>
                                    <Button x:Name="AiEnableButton" Content="{loc:Text Key=S8D07216266AE}" Width="68" Height="26" Margin="6,0,0,0" Click="AiEnableButton_Click" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>

                            <!-- 行 1：气泡区（可滚动；空态提示浮在上面） -->
                            <Grid Grid.Row="1" Margin="6,0,6,0">
                                <ScrollViewer x:Name="AiScrollViewer" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <StackPanel x:Name="AiBubbleStack" Margin="0,2,4,2"/>
                                </ScrollViewer>
                                <TextBlock x:Name="AiEmptyText" Text="{loc:Text Key=SA5D93F6F786F}"
                                           FontSize="10.5" Foreground="{StaticResource TextTertiary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="20,0"
                                           IsHitTestVisible="False"/>
                            </Grid>

                            <!-- 行 2：输入框 + 发送 -->
                            <Border x:Name="AiInputBorder" Grid.Row="2" Margin="6,4,6,6" CornerRadius="8"
                                    Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="AiInputBox" Background="Transparent" BorderThickness="0"
                                                 CaretBrush="{StaticResource TextPrimary}"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 FontSize="11.5" Padding="9,0" MaxLength="4000"
                                                 VerticalContentAlignment="Center" AcceptsReturn="False"
                                                 TextWrapping="NoWrap"
                                                 PreviewMouseLeftButtonDown="AiInputBox_PreviewMouseLeftButtonDown"
                                                 GotKeyboardFocus="AiInputBox_GotKeyboardFocus"
                                                 LostKeyboardFocus="AiInputBox_LostKeyboardFocus"
                                                 PreviewKeyDown="AiInputBox_PreviewKeyDown"
                                                 TextChanged="AiInputBox_TextChanged"/>
                                        <TextBlock x:Name="AiInputHint" Text="{loc:Text Key=S73ACD616C8A4}"
                                                   FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                    </Grid>

                                    <Button x:Name="AiSendButton" Grid.Column="1" Style="{StaticResource TransportButton}"
                                            Width="28" Height="28" FontSize="12" Margin="4" Content="&#xE724;"
                                            ToolTip="{loc:Text Key=S134FDD6479C8}" Click="AiSendButton_Click"/>
                                </Grid>
                            </Border>
                        </Grid></UserControl>
