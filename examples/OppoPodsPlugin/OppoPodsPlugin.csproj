<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>AlphaIsland.Plugins.OppoPods</AssemblyName>
    <Version>0.1.4</Version>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AlphaIslandSdkProject)">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <InternalsVisibleTo Include="AlphaIsland.RegressionTests" />
    <EmbeddedResource Include="upstream\Data\DeviceModels.json" LogicalName="OppoPodsManager.DeviceModels.json" />
    <EmbeddedResource Include="upstream\Data\EqModeNames*.json" LogicalName="OppoPodsManager.%(Filename)%(Extension)" />
    <EmbeddedResource Include="upstream2\Data\Vivo.DeviceModels.json" LogicalName="AlphaIsland.EarbudsV2.Assets.Vivo.Data.DeviceModels.json" />
    <EmbeddedResource Include="upstream2\Data\Oplus.DeviceModels.json" LogicalName="AlphaIsland.EarbudsV2.Assets.Oplus.Data.DeviceModels.json" />
    <EmbeddedResource Include="upstream2\Data\Oplus.EqModeNames.json" LogicalName="AlphaIsland.EarbudsV2.Assets.Oplus.Data.EqModeNames.json" />
    <EmbeddedResource Include="upstream2\Data\Strings.json" LogicalName="AlphaIsland.EarbudsV2.Assets.Localization.Strings.json" />
    <None Update="plugin.json;LICENSE;THIRD-PARTY-NOTICES.md;README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="DeployEarbudsPlugin" AfterTargets="Build" Condition="'$(DeployPlugin)' != 'false'">
    <ItemGroup>
      <PluginFiles Include="$(TargetPath);$(TargetDir)$(TargetName).pdb;$(TargetDir)$(TargetName).deps.json;$(MSBuildProjectDirectory)\plugin.json;$(MSBuildProjectDirectory)\LICENSE;$(MSBuildProjectDirectory)\THIRD-PARTY-NOTICES.md;$(MSBuildProjectDirectory)\README.md" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\bin\$(Configuration)\net8.0-windows10.0.19041.0\plugins\oppo.pods" SkipUnchangedFiles="true" />
  </Target>
</Project>
