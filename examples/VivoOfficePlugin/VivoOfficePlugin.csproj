<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>AlphaIsland.Plugins.VivoOffice</AssemblyName>
    <Version>0.1.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AlphaIslandSdkProject)">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <InternalsVisibleTo Include="AlphaIsland.RegressionTests" />
    <None Update="plugin.json;README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="DeployVivoPlugin" AfterTargets="Build" Condition="'$(DeployPlugin)' != 'false'">
    <ItemGroup>
      <PluginFiles Include="$(TargetPath);$(TargetDir)$(TargetName).pdb;$(TargetDir)$(TargetName).deps.json;$(MSBuildProjectDirectory)\plugin.json;$(MSBuildProjectDirectory)\README.md" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\bin\$(Configuration)\net8.0-windows10.0.19041.0\plugins\vivo.office" SkipUnchangedFiles="true" />
  </Target>
</Project>
