<Window xmlns:loc="clr-namespace:AlphaIsland.PluginSdk.Localization;assembly=AlphaIsland.PluginSdk" x:Class="alpha_island.Controls.ChatHistoryWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Text Key=S19546BAD7ABA}" Width="860" Height="600" MinWidth="740" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource W11WindowBrush}"
        Foreground="{DynamicResource W11TextPrimary}" FontFamily="{DynamicResource AppFontFamily}" UseLayoutRounding="True"
        Topmost="True" ShowInTaskbar="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/alpha-island;component/Themes/LiquidGlass.xaml"/>
                <ResourceDictionary Source="/alpha-island;component/Themes/Win11Settings.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource W11Button}">
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource ThemedTextBox}">
                <Setter Property="Background" Value="{DynamicResource W11ControlFill}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource W11ControlBorder}"/>
            </Style>
            <Style TargetType="ListBox" BasedOn="{StaticResource ThemedListBox}"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20" Background="{DynamicResource W11WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="{loc:Text Key=SAEE887434131}" Click="Refresh_Click"/>
                <Button Content="{loc:Text Key=SDA99EA1331DC}" Click="OpenDirectory_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Text Key=S7FBCBCA49EC5}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Text Key=S106CD6616008}" Foreground="{DynamicResource W11TextSecondary}" Margin="0,4,8,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="SessionList" SelectionChanged="Session_Changed">
                    <ListBox.ItemTemplate>
                        <DataTemplate><StackPanel>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,5,0,0" FontSize="11.5" Foreground="{DynamicResource W11TextSecondary}">
                                <Run Text="{Binding Updated, StringFormat={}{0:MM-dd HH:mm}}"/><Run Text=" · "/>
                                <Run Text="{Binding MessageCount}"/><Run Text="{loc:Text Key=S19923BC198F7}"/>
                            </TextBlock>
                        </StackPanel></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="ContinueButton" Content="{loc:Text Key=S5D44AF892C1B}" Click="Continue_Click"/>
                    <Button x:Name="DeleteSessionButton" Content="{loc:Text Key=SFF852DE52D1F}" Click="DeleteSession_Click"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="RenameButton" DockPanel.Dock="Right" Content="{loc:Text Key=SA759DD2529F1}" Margin="8,0,0,0" Click="Rename_Click"/>
                    <TextBox x:Name="TitleBox" ToolTip="{loc:Text Key=S26C4FA32203A}"/>
                </DockPanel>
                <ListBox x:Name="MessageList" Grid.Row="1" SelectionChanged="Message_Changed">
                    <ListBox.ItemTemplate>
                        <DataTemplate><StackPanel>
                            <TextBlock Text="{Binding Role}" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyan}"/>
                            <TextBlock Text="{Binding Preview}" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis"/>
                        </StackPanel></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="{loc:Text Key=SD0ED07F05AEE}" Foreground="{DynamicResource W11TextSecondary}" Margin="0,10,0,6"/>
                <TextBox x:Name="MessageEditor" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="SaveMessageButton" Content="{loc:Text Key=S991BB7CFE5A8}" Click="SaveMessage_Click"/>
                    <Button x:Name="DeleteMessageButton" Content="{loc:Text Key=S053D6B4DD1F3}" Click="DeleteMessage_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="{loc:Text Key=S8BDEE3AB9DE9}" Foreground="{DynamicResource W11TextSecondary}" Margin="0,14,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
