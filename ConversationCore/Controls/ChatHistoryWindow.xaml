<Window x:Class="alpha_island.Controls.ChatHistoryWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="对话历史 · Alpha Island" Width="860" Height="600" MinWidth="740" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#202020" Foreground="White" FontFamily="Segoe UI"
        Topmost="True" ShowInTaskbar="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/alpha-island;component/Themes/LiquidGlass.xaml"/>
                <ResourceDictionary Source="/alpha-island;component/Themes/Win11Settings.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource ThemedButton}">
                <Setter Property="Background" Value="#333333"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#555555"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource ThemedTextBox}">
                <Setter Property="Background" Value="#282828"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#555555"/>
                <Setter Property="CaretBrush" Value="White"/>
            </Style>
            <Style TargetType="ListBox">
                <Setter Property="Background" Value="#282828"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20" Background="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click"/>
                <Button Content="打开数据目录" Click="OpenDirectory_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="对话历史" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="记录保存在本机；修改历史不会自动重新生成回复。" Foreground="#BBBBBB" Margin="0,4,8,0"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="SessionList" SelectionChanged="Session_Changed">
                    <ListBox.ItemTemplate>
                        <DataTemplate><StackPanel>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#BBBBBB">
                                <Run Text="{Binding Updated, StringFormat={}{0:MM-dd HH:mm}}"/><Run Text=" · "/>
                                <Run Text="{Binding MessageCount}"/><Run Text=" 条消息"/>
                            </TextBlock>
                        </StackPanel></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="ContinueButton" Content="继续对话" Click="Continue_Click"/>
                    <Button x:Name="DeleteSessionButton" Content="删除对话" Click="DeleteSession_Click"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="RenameButton" DockPanel.Dock="Right" Content="保存名称" Margin="8,0,0,0" Click="Rename_Click"/>
                    <TextBox x:Name="TitleBox" ToolTip="对话名称"/>
                </DockPanel>
                <ListBox x:Name="MessageList" Grid.Row="1" SelectionChanged="Message_Changed">
                    <ListBox.ItemTemplate>
                        <DataTemplate><StackPanel>
                            <TextBlock Text="{Binding Role}" FontWeight="SemiBold" Foreground="#73D7E7"/>
                            <TextBlock Text="{Binding Preview}" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis"/>
                        </StackPanel></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="选中一条消息，可查看全文或编辑内容：" Foreground="#BBBBBB" Margin="0,10,0,6"/>
                <TextBox x:Name="MessageEditor" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="SaveMessageButton" Content="保存修改" Click="SaveMessage_Click"/>
                    <Button x:Name="DeleteMessageButton" Content="删除消息" Click="DeleteMessage_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="选择左侧会话查看记录" Foreground="#BBBBBB" Margin="0,14,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
