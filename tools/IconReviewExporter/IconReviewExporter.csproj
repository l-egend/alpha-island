<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>AlphaIsland.IconReviewExporter</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- .cs.txt keeps the application's default recursive Compile glob untouched. -->
    <Compile Include="Program.cs.txt" />
    <Compile Include="RemainingIcons.cs.txt" />
    <ProjectReference Include="..\..\alpha-island.csproj" Condition="'$(IconSourceDirectory)' == ''" />
    <Reference Include="alpha-island" Condition="'$(IconSourceDirectory)' != ''">
      <HintPath>$(IconSourceDirectory)\alpha-island.dll</HintPath>
    </Reference>
    <Reference Include="AlphaIsland.PluginSdk" Condition="'$(IconSourceDirectory)' != ''">
      <HintPath>$(IconSourceDirectory)\AlphaIsland.PluginSdk.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
