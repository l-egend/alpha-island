<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AlphaIsland.RegressionTests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App;Microsoft.WindowsDesktop.App.WPF;Microsoft.WindowsDesktop.App.WindowsForms"
                             RuntimeFrameworkVersion="$(InstallerRuntimeVersion)" Condition="'$(InstallerRuntimeVersion)' != ''" />
    <ProjectReference Include="..\..\alpha-island.csproj" />
    <ProjectReference Include="..\..\examples\ApiChatPlugin\ApiChatPlugin.csproj" />
    <ProjectReference Include="..\..\examples\LocalAgentsPlugin\LocalAgentsPlugin.csproj" />
    <ProjectReference Include="..\..\examples\ClockPlugin\ClockPlugin.csproj" ReferenceOutputAssembly="false" AdditionalProperties="DeployPlugin=false" />
    <ProjectReference Include="..\..\examples\TrafficMonitorPlugin\TrafficMonitorPlugin.csproj" AdditionalProperties="DeployPlugin=false" />
    <ProjectReference Include="..\..\examples\OppoPodsPlugin\OppoPodsPlugin.csproj" AdditionalProperties="DeployPlugin=false" />
    <ProjectReference Include="..\..\examples\VivoOfficePlugin\VivoOfficePlugin.csproj" AdditionalProperties="DeployPlugin=false" />
    <ProjectReference Include="..\..\examples\DeviceBatteryPlugin\DeviceBatteryPlugin.csproj" AdditionalProperties="DeployPlugin=false" />
    <ProjectReference Include="..\PluginFixture\PluginFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- Fixtures load each plugin from its own project output. Their root-level
       manifests and readmes must not collide in the self-contained test host. -->
  <Target Name="ExcludePluginPackageContentFromRegressionHost" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.RelativePath)' == 'plugin.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'README.md'" />
    </ItemGroup>
  </Target>
</Project>
