<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="clr-namespace:AlphaIsland.PluginSdk;assembly=AlphaIsland.PluginSdk"
                    xmlns:motion="clr-namespace:alpha_island.Animation">
    <icons:GlyphContentConverter x:Key="GlyphContentConverter"/>

    <!-- ============================================================
         Windows 11 深色主题（设置界面专用）
         页面与导航使用 #202020，卡片使用 #2A2A2A，强调色为 #4DB1FF。
           Win11 深色主题下开关打开 = 强调色轨道 + 黑色圆钮
         与 Themes/LiquidGlass.xaml（灵动岛本体主题）完全独立。
         ============================================================ -->

    <Color x:Key="W11AccentColor">#FF4DB1FF</Color>

    <SolidColorBrush x:Key="W11WindowBrush" Color="#202020"/>
    <SolidColorBrush x:Key="W11WindowBorderBrush" Color="#28FFFFFF"/>
    <SolidColorBrush x:Key="W11NavBrush" Color="#202020"/>
    <SolidColorBrush x:Key="W11CardBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="W11CardBorderBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="W11DividerBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="W11AccentBrush" Color="#4DB1FF"/>
    <SolidColorBrush x:Key="W11AccentSoftBrush" Color="#264DB1FF"/>

    <SolidColorBrush x:Key="W11TextPrimary" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="W11TextSecondary" Color="#C5FFFFFF"/>
    <SolidColorBrush x:Key="W11TextTertiary" Color="#87FFFFFF"/>
    <SolidColorBrush x:Key="W11TextDisabled" Color="#5DFFFFFF"/>

    <SolidColorBrush x:Key="W11ControlFill" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="W11ControlHover" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="W11ControlPressed" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="W11ControlBorder" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="W11ControlStrong" Color="#8AFFFFFF"/>
    <SolidColorBrush x:Key="W11TrackBrush" Color="#33FFFFFF"/>

    <!-- ============================================================
         文本
         ============================================================ -->

    <Style x:Key="W11PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="27"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource W11TextPrimary}"/>
    </Style>

    <Style x:Key="W11PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource W11TextSecondary}"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 卡片上方的小标题 -->
    <Style x:Key="W11CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource W11TextPrimary}"/>
        <Setter Property="Margin" Value="2,0,0,8"/>
    </Style>

    <Style x:Key="W11RowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource W11TextPrimary}"/>
    </Style>

    <Style x:Key="W11RowHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource W11TextSecondary}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="W11Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource W11TextSecondary}"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================================================
         卡片容器
         ============================================================ -->

    <Style x:Key="W11Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource W11CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource W11CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <!-- 同一张卡片内的行分隔线：左侧从图标之后起，Win11 就是这么缩进的 -->
    <Style x:Key="W11RowDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource W11DividerBrush}"/>
        <Setter Property="Margin" Value="62,0,16,0"/>
    </Style>

    <Style x:Key="W11Row" TargetType="Grid">
        <Setter Property="Margin" Value="16,0,16,0"/>
        <Setter Property="MinHeight" Value="64"/>
    </Style>

    <!-- 行首的图标槽：32x32 圆角方块，用户后续把图标填进 Content -->
    <Style x:Key="W11IconTile" TargetType="Border">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="#14FFFFFF"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="W11IconGlyph" TargetType="icons:GlyphIcon">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource W11TextSecondary}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================================================
         导航项（RadioButton）
         ============================================================ -->

    <Style x:Key="W11NavItem" TargetType="RadioButton">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="0,1,0,1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource W11TextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border Background="Transparent" CornerRadius="6" x:Name="Bg"/>
                        <ContentPresenter Margin="16,0,10,0" VerticalAlignment="Center" x:Name="Presenter"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource W11ControlFill}"/>
                            <Setter Property="Foreground" Value="{StaticResource W11TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource W11ControlFill}"/>
                            <Setter Property="Foreground" Value="{StaticResource W11TextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         开关（CheckBox）—— Win11 ToggleSwitch：40x20 胶囊，打开时深色圆钮压在强调色轨道上
         ============================================================ -->

    <Style x:Key="W11Switch" TargetType="CheckBox">
        <Setter Property="motion:SettingsControlMotion.Enabled" Value="True"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border Background="{StaticResource W11ControlFill}" CornerRadius="10"
                                BorderBrush="{StaticResource W11ControlStrong}" BorderThickness="1" x:Name="Track"/>
                        <Ellipse Fill="#C5FFFFFF" Height="12" HorizontalAlignment="Left"
                                 Margin="4,0,0,0" Width="12" x:Name="Knob"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="#FFFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource W11AccentBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="#1A1A1A"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         滑杆（Slider）—— 4px 细轨 + 白圈强调色内点
         ============================================================ -->

    <Style x:Key="W11SliderTrackFill" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" CornerRadius="2" Height="4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="W11SliderTrackEmpty" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" Height="4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="W11SliderThumb" TargetType="Thumb">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Ellipse Fill="#FFFFFFFF" x:Name="Ring"/>
                        <Ellipse Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" Height="12" Width="12" x:Name="Core"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Core" Property="Height" Value="10"/>
                            <Setter TargetName="Core" Property="Width" Value="10"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Core" Property="Height" Value="6"/>
                            <Setter TargetName="Core" Property="Width" Value="6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="W11Slider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource W11AccentBrush}"/>
        <Setter Property="Background" Value="{StaticResource W11TrackBrush}"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Height="4"/>
                        <Track VerticalAlignment="Center" x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource W11SliderTrackFill}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource W11SliderTrackEmpty}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource W11SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         按钮
         ============================================================ -->

    <Style x:Key="W11Button" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource W11TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{StaticResource W11ControlFill}"
                            BorderBrush="{StaticResource W11ControlBorder}" BorderThickness="1"
                            CornerRadius="6" x:Name="Bg">
                        <ContentPresenter Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource GlyphContentConverter}}" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource W11ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource W11ControlPressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource W11AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标题栏的最小化 / 关闭按钮：无边框，关闭按钮悬停变红 -->
    <Style x:Key="W11TitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource W11TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" CornerRadius="4" Margin="0,4,2,4" x:Name="Bg">
                        <ContentPresenter Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource GlyphContentConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource W11ControlFill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="W11CloseButton" BasedOn="{StaticResource W11TitleBarButton}" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" CornerRadius="4" Margin="0,4,4,4" x:Name="Bg">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#C42B1C"/>
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 搜索框（导航面板顶部） -->
    <Style x:Key="W11TextBox" TargetType="TextBox" BasedOn="{StaticResource ThemedTextBox}">
        <Setter Property="Background" Value="{StaticResource W11ControlFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource W11ControlBorder}"/>
        <Setter Property="Foreground" Value="{StaticResource W11TextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource W11AccentBrush}"/>
    </Style>
    <Style x:Key="W11SearchBox" TargetType="TextBox" BasedOn="{StaticResource W11TextBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource W11TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource W11TextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource W11AccentBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 导航栏收起按钮：Segoe MDL2 的 E700 = 三横线（GlobalNavButton），即 Win11 的收起汉堡 -->
    <Style x:Key="W11NavCollapse" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource W11TextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="Transparent" CornerRadius="4" x:Name="Bg"/>
                        <icons:GlyphIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE700;"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource W11ControlFill}"/>
                            <Setter Property="Foreground" Value="{StaticResource W11TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource W11ControlPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "关于"页里的大图标演示：SVG 转成的 Path -->
    <Style x:Key="W11HeroIcon" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="{StaticResource W11AccentBrush}"/>
    </Style>

</ResourceDictionary>
