<Window x:Class="DynamicIslandDemo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵动岛设置" Height="220" Width="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#18181C"
        Foreground="White"
        FontFamily="Segoe UI, Microsoft YaHei">

    <Grid Margin="22">
        <StackPanel VerticalAlignment="Center">
            <!-- 标题栏 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Ellipse Width="10" Height="10" Fill="#00F0FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="外观与质感个性化" FontSize="15" FontWeight="Bold"/>
            </StackPanel>

            <!-- 通透度调节卡片 -->
            <Border Background="#24242B" CornerRadius="10" Padding="14,12" BorderBrush="#15FFFFFF" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="玻璃通透度 (不透明度)" FontSize="12" Foreground="#CCCCCC"/>
                        <TextBlock x:Name="OpacityValueText" Text="85%" FontSize="12" Foreground="#00F0FF" 
                                   HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- 滑动条：范围 45% (轻盈通透) 到 96% (沉稳厚重) -->
                    <Slider x:Name="OpacitySlider" 
                            Minimum="0.45" Maximum="0.96" Value="0.85" 
                            TickFrequency="0.01" IsSnapToTickEnabled="False"
                            ValueChanged="OpacitySlider_ValueChanged"/>

                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="更通透清脆" FontSize="10" Foreground="#66FFFFFF"/>
                        <TextBlock Text="高对比易读" FontSize="10" Foreground="#66FFFFFF" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="提示：设置会自动实时生效并应用到灵动岛" 
                       FontSize="11" Foreground="#55FFFFFF" Margin="2,12,0,0"/>
        </StackPanel>
    </Grid>
</Window>