<Window x:Class="alpha_island.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:alpha_island.Controls"
        xmlns:pluginUi="clr-namespace:AlphaIsland.PluginSdk;assembly=AlphaIsland.PluginSdk"
        Title="Alpha Island"
        Icon="Assets/alpha-island.ico"
        Width="1200" Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewDragEnter="Window_DragEnter"
        PreviewDragOver="Window_DragOver"
        PreviewDragLeave="Window_DragLeave"
        PreviewDrop="Window_Drop"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <!-- 根容器：包含岛附近的顶部拖放感应区与居中岛体 -->
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- 只在岛外拖动靠近时临时启用；实际文件载荷经 OLE 验证后才展开。 -->
        <Border x:Name="TopDropZone"
                Height="60"
                Width="560"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Background="{x:Null}"
                AllowDrop="True"
                IsHitTestVisible="False"
                Panel.ZIndex="0"/>

        <!-- 岛体容器：岛体始终水平居中、贴屏幕顶部 -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="1">
            <!-- ============ 岛体本体：液态玻璃 ============
                 所有材质层共用 IslandBody.CornerRadius（用 Binding 跟随），
                 所以动画器只改一个 CornerRadius，内阴影/流光/高光全部同步变形。 -->
            <Border x:Name="IslandBody"
                Width="130" Height="10"
                CornerRadius="0,0,10,10"
                ClipToBounds="True"
                Cursor="Hand"
                BorderThickness="1"
                BorderBrush="{StaticResource GlassEdgeBrush}"
                AllowDrop="True"
                MouseEnter="IslandBody_MouseEnter"
                MouseLeftButtonDown="IslandBody_MouseLeftButtonDown"
                PreviewMouseLeftButtonDown="IslandBody_PreviewMouseLeftButtonDown"
                PreviewMouseMove="IslandBody_PreviewMouseMove"
                PreviewMouseLeftButtonUp="IslandBody_PreviewMouseLeftButtonUp"
                PreviewMouseRightButtonUp="IslandBody_PreviewMouseRightButtonUp"
                PreviewMouseWheel="IslandBody_PreviewMouseWheel"
                RenderTransformOrigin="0.5,0.5">
            <Border.Background>
                <LinearGradientBrush x:Name="GlassGradient" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="GlassTopStop" Color="#D916161D" Offset="0"/>
                    <GradientStop x:Name="GlassBottomStop" Color="#E509090D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.RenderTransform>
                <!-- 顺序很重要：先挤压形变，再位移。
                     反过来的话 IsolaTranslate.Y 会被 ScaleY 在窗口坐标里缩放，
                     贴顶位置会随挤压量上下漂。 -->
                <TransformGroup>
                    <ScaleTransform x:Name="IslandSquash" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="IslandTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="IslandShadow" BlurRadius="26" ShadowDepth="7" Direction="270"
                                  Color="#000000" Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <!-- ⓪ 流体波浪层：整岛最底层，满幅出血。
                     必须放在"岛体根容器"里（而不是 CardLayer 里）——
                     放在 CardLayer 里时它的绘制区域会被 CardLayer 的 392 宽布局盒裁掉，
                     左右各剩 14px 的纯玻璃黑边（实测屏幕 764..1152 vs 岛体 750..1170）。
                     放在这里由 IslandBody.ClipToBounds 按圆角裁切，左右铺满、圆角自然。 -->
                <controls:WaveVisualizer x:Name="CardWave"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                         Margin="-2"
                                         IsHitTestVisible="False"
                                         Opacity="0"
                                         PointCount="56"
                                         Amplitude="1.25"
                                         BassBoost="0.68" Smoothing="0.35"
                                         Sensitivity="2.0"
                                         FillOpacity="0.50"
                                         GlowRadius="14" GlowOpacity="0.55"
                                         IsActive="False">
                    <!-- 下缘化开：波浪的色量本来就堆在底部，正好压着进度条。
                         用户要求"淡一点、融进其他元素"，所以整体再降一档 alpha。 -->
                    <controls:WaveVisualizer.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#B3FFFFFF" Offset="0.55"/>
                            <GradientStop Color="#59FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </controls:WaveVisualizer.OpacityMask>
                </controls:WaveVisualizer>

                <!-- 充放电动态光波纹特效（全岛体底层背景展开，不遮挡任何内容层） -->
                <controls:BatteryRippleEffect x:Name="BatteryRipple" IsHitTestVisible="False"/>

                <!-- ① 内层厚度：让玻璃看起来有壁厚而不是一张纸 -->
                <Border Margin="1"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBody}"
                        Background="{StaticResource GlassInnerShadowBrush}"
                        IsHitTestVisible="False"/>

                <!-- ② 折射流光：凝胶形变时横向扫过（IslandAnimator 驱动 SheenTranslate.X） -->
                <Border x:Name="SheenLayer"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBody}"
                        Background="{StaticResource GlassSheenBrush}"
                        Opacity="0.55"
                        IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SheenTranslate" X="0" Y="0"/>
                    </Border.RenderTransform>
                </Border>

                <!-- ③ 顶缘高光 -->
                <Rectangle Height="1" VerticalAlignment="Top" Margin="14,1,14,0"
                           Fill="{StaticResource GlassTopHighlightBrush}"
                           IsHitTestVisible="False"/>

                <!-- ③b 镜面高光条：凝胶形变时随形变量加长，并沿顶边滑行
                     （IslandAnimator 逐帧驱动 Width / Opacity / SpecularTranslate.X） -->
                <Rectangle x:Name="SpecularBar" Height="2" RadiusX="1" RadiusY="1"
                           Width="90" Opacity="0"
                           VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,1,0,0"
                           Fill="{StaticResource GlassTopHighlightBrush}"
                           IsHitTestVisible="False">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="SpecularTranslate" X="0" Y="0"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- ③c 细条常驻指示（A 组①网速 / A 组②内存）：细条态右/中侧常驻数字。
                     细条只有 10px 高，字号压到 8px 才放得下（数字与箭头都没有下伸部，不会被裁）；
                     显隐由 MainWindow.SyncBarIndicators() 控制（只有 Bar 态 + 主弹簧收满 + 至少一侧有内容时才画），
                     整层不参与命中测试，细条整条仍是拖拽/点击热区。 -->
                <Grid x:Name="BarSpeedLayer" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="BarSpeedDownText" FontSize="8" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Text=""/>
                        <TextBlock x:Name="BarSpeedUpText" FontSize="8" FontWeight="SemiBold" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextSecondary}" Text=""/>
                        <!-- 内存占用百分比（A 组②）：没有流量时它就是细条上唯一的内容 -->
                        <TextBlock x:Name="BarMemText" FontSize="8" FontWeight="SemiBold" Margin="8,0,0,0"
                                   Foreground="{StaticResource TextTertiary}" Text=""/>
                        <!-- 飞行模式指示（A 组④）：只在飞行模式真的开着时亮（Warning 色），平时不可见 -->
                        <TextBlock x:Name="BarAirText" FontSize="9" FontFamily="Segoe MDL2 Assets" Margin="8,0,0,0"
                                   Foreground="#FFFFB900" Text="&#xE709;" Visibility="Collapsed"/>
                        <!-- 麦克风 / 摄像头占用小圆点（A 组⑤）：各自独立亮灭。
                             颜色与屏幕右上角那盏灯一致（橙=麦克风 / 绿=摄像头，对齐 iOS 17）。 -->
                        <StackPanel x:Name="BarPrivacyDots" Margin="8,0,0,0" Orientation="Horizontal"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <Ellipse x:Name="BarMicDot" Fill="#FFFF9F0A" Height="4" Visibility="Collapsed" Width="4"/>
                            <Ellipse x:Name="BarCamDot" Fill="#FF30D158" Height="4" Margin="4,0,0,0"
                                     Visibility="Collapsed" Width="4"/>
                        </StackPanel>
                        <!-- agent 运行状态色点（B 组③）：颜色随状态走（思考紫/输出青/等授权黄/出错红），
                             空闲时整点收起 —— 细条上不能常驻一个"什么也没干"的点。 -->
                        <Ellipse x:Name="BarAgentDot" Fill="#FF8A5CFF" Height="6" Margin="8,0,0,0"
                                 Visibility="Collapsed" Width="6"/>
                    </StackPanel>
                </Grid>

                <!-- ================= 一级展开：长椭圆 =================
                     左侧圆角封面 + 中间当前歌词 + 右侧可视化 -->
                <Grid x:Name="PillLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PillLayerScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="PillLayerTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="PillCoverHost" Grid.Column="0"
                            Width="32" Height="32" CornerRadius="8"
                            BorderBrush="#33FFFFFF" BorderThickness="1"
                            Background="#1AFFFFFF" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="PillCoverPlaceholder" Text="&#xE767;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="#8CFFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <ImageBrush x:Name="PillCoverBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 中间歌词：放得下就居中静止，放不下就先让岛体变宽、实在放不下再走马灯。
                         宽度实测、换行过场与伸缩动画由 MainWindow.UpdatePillLyricScroll() 负责。
                         两层结构：Stage 负责换行的"上移 + 淡入"，Track 负责跑马灯的横向位移，
                         两个通道各用一条 TranslateTransform，互不打断。 -->
                    <Grid x:Name="PillLyricHost" Grid.Column="1" Margin="10,0"
                          ClipToBounds="True" VerticalAlignment="Center"
                          SizeChanged="PillLyricHost_SizeChanged">
                        <Grid x:Name="PillLyricStage" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <!-- 换行过场：新歌词从下方 +RollDistance 处上移到 0 -->
                                    <TranslateTransform x:Name="PillLyricRoll"/>
                                    <!-- 跑马灯：整条轨道的横向位移（含居中偏移） -->
                                    <TranslateTransform x:Name="PillLyricScroll"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <StackPanel x:Name="PillLyricTrack" Orientation="Horizontal"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="PillLyric"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="Alpha Island"/>
                                <!-- 跑马灯的第二份：接在第一份后面，形成无缝循环 -->
                                <TextBlock x:Name="PillLyricEcho"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="56,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>

                        <!-- 上一句歌词：换行时留在原处继续上移并淡出。单独一层，
                             所以淡出过程中新歌词已经可以同时从下方上移淡入（交叉过场）。 -->
                        <TextBlock x:Name="PillLyricGhost"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Opacity="0" IsHitTestVisible="False">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="PillLyricGhostRoll"/>
                                    <TranslateTransform x:Name="PillLyricGhostScroll"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>

                    <!-- 一级胶囊右侧：音频频谱（缩减至五段，统一色相无渐变，柱体胶囊形，多出宽度留给歌词） -->
                    <Grid Grid.Column="2" Width="Auto" Height="26">
                        <controls:SpectrumVisualizer x:Name="PillSpectrum"
                                                     Width="28" Height="22"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     BarCount="5" BarGap="2.5" UniformColor="True"
                                                     MinBarHeight="2.5" CenterEmphasis="0.40"
                                                     GlowRadius="1.6" GlowOpacity="0.26"
                                                     IsActive="False"/>

                        <!-- 换曲 / 暂停提示：右侧状态指示 -->
                        <StackPanel x:Name="PillUpNext" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed" IsHitTestVisible="False" Opacity="0">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="PillUpNextTranslate" Y="0"/>
                            </StackPanel.RenderTransform>
                            <TextBlock x:Name="PillUpNextIcon" Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentCyan}"/>
                            <TextBlock x:Name="PillUpNextText" Text="接下来"
                                       FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= 启动问候层（与 PillLayer 同级同尺寸） ================= -->
                <Grid x:Name="GreetingLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：问候流光徽标 -->
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#2200E5FF" BorderBrush="#3300E5FF" BorderThickness="1">
                        <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#00E5FF"/>
                    </Border>

                    <!-- 中间：欢迎文字 -->
                    <TextBlock x:Name="GreetingText" Grid.Column="1"
                               Margin="12,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Text="欢迎回来"/>

                    <!-- 右侧：品牌徽标 -->
                    <Border Grid.Column="2" Padding="8,4" CornerRadius="10"
                            Background="#1AFFFFFF" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="Alpha Island" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </Border>
                </Grid>

                <!-- ================= 蓝牙通知层（与 PillLayer 同级同尺寸，互斥显示） =================
                     蓝牙设备连接时弹出：左侧 3D 旋转模型/矢量图标、中间设备名称、右侧电量。
                     布局尺寸与 PillLayer 完全一致，复用 Pill 形态的 IslandBody 尺寸。 -->
                <Grid x:Name="BtNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：3D 设备模型（耳机）或专属外设矢量图标（键鼠手柄） -->
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            ClipToBounds="True" Background="#1AFFFFFF" x:Name="BtIconContainer">
                        <Grid>
                            <controls:DeviceModelView x:Name="BtDeviceModel"
                                                      Width="32" Height="32"
                                                      IsRotating="False"/>
                            <TextBlock x:Name="BtDeviceIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimary}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- 中间：蓝牙设备名称 -->
                    <TextBlock x:Name="BtDeviceName" Grid.Column="1"
                               Margin="10,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               Text="蓝牙设备"/>

                    <!-- 右侧：连接状态 + 电池图标 + 电量百分比 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock x:Name="BtStatusText" Text="已连接" FontSize="11" Margin="0,0,6,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                        <pluginUi:DeviceBatteryIndicator x:Name="BtBatteryIcon" Width="28" Height="16"
                                                        VerticalAlignment="Center"/>
                        <TextBlock x:Name="BtBatteryText"
                                   FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="—"/>
                    </StackPanel>
                </Grid>

                <!-- ================= 系统音量调节层（与 PillLayer 同级同尺寸，互斥显示） =================
                     音量调节时弹出：左侧自适应音量图标、中间音量进度条、右侧数字百分比。 -->
                <Grid x:Name="VolumeNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Cursor="Hand" ToolTip="点击展开音量调节卡片"
                      MouseLeftButtonDown="VolumeNotifyLayer_MouseLeftButtonDown"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：音量状态圆形徽标（随音量大小和静音状态变化） -->
                    <Border x:Name="VolumeIconContainer" Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#2200E5FF" BorderBrush="#3300E5FF" BorderThickness="1">
                        <TextBlock x:Name="VolumeIcon" Text="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#00E5FF"/>
                    </Border>

                    <!-- 中间：音量大小进度条 -->
                    <Grid x:Name="VolumeTrackContainer" Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Height="24"
                          Background="Transparent" Cursor="Hand"
                          PreviewMouseLeftButtonDown="CardVolumeSliderTrack_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="CardVolumeSliderTrack_MouseMove"
                          PreviewMouseLeftButtonUp="CardVolumeSliderTrack_MouseLeftButtonUp"
                          LostMouseCapture="CardVolumeSliderTrack_LostMouseCapture"
                          MouseEnter="VolumeTrack_MouseEnter" MouseLeave="VolumeTrack_MouseLeave">
                        <Grid x:Name="VolumeCapsule" Height="5" Background="#38FFFFFF" VerticalAlignment="Center"
                              IsHitTestVisible="False" SizeChanged="VolumeCapsule_SizeChanged">
                            <Border x:Name="VolumeProgressFill" Background="#9FFFFFFF" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                    </Grid>

                    <!-- 右侧：数字形式展现 -->
                    <TextBlock x:Name="VolumeText" Grid.Column="2"
                               Margin="0,0,4,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Text="50%"/>
                </Grid>

                <!-- ================= 网速提示层（A 组①：下行持续超过阈值时弹一次） ================= -->
                <Grid x:Name="NetSpeedNotifyLayer" Opacity="0" Width="158" Height="36"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <controls:NetworkSpeedPill x:Name="NetSpeedRates"/>
                </Grid>

                <!-- ================= 下载进度提示层（浏览器 / Steam 下载期间常显） =================
                     数据来自 MainWindow.Downloads.cs：下载中每拍（2s）续期一次，所以它是**常显**的；
                     下载完成时同一层换成「下载完成」再挂 6 秒。进度百分比放在右侧大字上，一眼能看到。 -->
                <Grid x:Name="DownloadNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#2234D399" BorderBrush="#3334D399" BorderThickness="1">
                        <TextBlock x:Name="DownloadNotifyGlyph" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#34D399"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DownloadNotifyTitle" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Text="正在下载"/>
                        <TextBlock x:Name="DownloadNotifyDetail" FontSize="10.5" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSecondary}" Text=""/>
                    </StackPanel>

                    <TextBlock x:Name="DownloadNotifyValue" Grid.Column="2" Margin="0,0,4,0"
                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                               Foreground="#34D399" Text=""/>
                </Grid>

                <!-- ================= 系统状态通用提示层（A 组②③④⑤ 共用） =================
                     内存整理/内存偏高/功率/飞行模式/隐私灯都用这一层：图标字形、标题、说明、右侧数值
                     全部由代码在弹出前写入（SysNotifyGlyph/Title/Detail/Value），
                     所以加新提示不需要再加 XAML 层，只要 _layers.ShowSeconds("system", n)。 -->
                <Grid x:Name="SystemNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#2222D3EE" BorderBrush="#3322D3EE" BorderThickness="1">
                        <TextBlock x:Name="SysNotifyGlyph" Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#22D3EE"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SysNotifyTitle" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Text=""/>
                        <TextBlock x:Name="SysNotifyDetail" FontSize="10.5" Margin="0,1,0,0"
                                   Foreground="{StaticResource TextSecondary}" Text=""/>
                    </StackPanel>

                    <TextBlock x:Name="SysNotifyValue" Grid.Column="2" Margin="0,0,4,0"
                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Text=""/>
                </Grid>

                <!-- ================= agent 运行状态层（B 组③：思考 / 输出 / 等待授权 / 出错） =================
                     状态由 Core\AgentStatus.cs 统一持有（AI 卡片页与将来的桥接都写它）。
                     这一层是被 AgentStatus.Changed 与 1 秒 ticker 共同驱动的：只要状态不是 Idle 就占住胶囊，
                     音乐图层自动让位（IslandLayerHost 的 ForceActive 语义），归零时由 SyncNotificationLayers 收回。 -->
                <Grid x:Name="AgentNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#228A5CFF" BorderBrush="#338A5CFF" BorderThickness="1">
                        <TextBlock x:Name="AgentNotifyGlyph" Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#8A5CFF"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AgentNotifyTitle" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Text="思考中"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="AgentNotifyDetail" FontSize="10.5" Margin="0,1,0,0"
                                   Foreground="{StaticResource TextSecondary}" Text=""
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock x:Name="AgentNotifyValue" Grid.Column="2" Margin="0,0,4,0"
                               VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}" Text=""/>
                </Grid>

                <!-- ================= agent 工具权限审批层（B 组④） =================
                     外部 agent 通过本机回环 HTTP（Services\AgentBridgeService.cs）发起审批，
                     这里只负责"显示 + 收 Y/N + 把裁决回传"。标准 Button 负责按下、捕获与松手点击，
                     整层由 IslandLayerHost 在可见时才打开 IsHitTestVisible（见 SyncNotificationLayers）。 -->
                <Grid x:Name="ApprovalLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#228A5CFF" BorderBrush="#338A5CFF" BorderThickness="1">
                        <TextBlock x:Name="ApprovalGlyph" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#8A5CFF"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ApprovalTitle" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Text="agent 请求工具权限"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ApprovalDetail" FontSize="10" Margin="0,1,0,0"
                                   Foreground="{StaticResource TextSecondary}" Text=""
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ApprovalAllowButton" Style="{StaticResource ThemedButton}"
                                Background="#3334C759" BorderBrush="#6634C759"
                                BorderThickness="1" Margin="0,0,6,0" Padding="9,3" MinHeight="24"
                                ToolTip="仅允许本次操作" Click="ApprovalAllow_Click">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FFDFFFE6" Text="允许 Y"/>
                        </Button>
                        <Button x:Name="ApprovalDenyButton" Style="{StaticResource ThemedButton}"
                                Background="#33FF5A5F" BorderBrush="#66FF5A5F"
                                BorderThickness="1" Padding="9,3" MinHeight="24"
                                Click="ApprovalDeny_Click">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FFFFE3E3" Text="拒绝 N"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= 电池状态通知层（与 PillLayer 同级同尺寸，互斥显示） ================= -->
                <Grid x:Name="BatteryNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：电池状态圆形微光徽标 -->
                    <Border x:Name="BatteryIconContainer" Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#2200FF88" BorderBrush="#3300FF88" BorderThickness="1">
                        <TextBlock x:Name="BatteryIcon" Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#00FF88"/>
                    </Border>

                    <!-- 中间：状态描述 -->
                    <TextBlock x:Name="BatteryStatusText" Grid.Column="1"
                               Margin="12,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               Text="已连接电源"/>

                    <!-- 右侧：电量百分比 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock x:Name="BatteryBoltIcon" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Foreground="#00FF88" Margin="0,0,4,0"/>
                        <TextBlock x:Name="BatteryPercentText" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"
                                   Text="85%"/>
                    </StackPanel>
                </Grid>

                <!-- ================= 剪切板通知层（与 PillLayer 同级同尺寸，互斥显示） ================= -->
                <Grid x:Name="ClipboardNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：剪切板圆形微光徽标 -->
                    <Border x:Name="ClipboardIconContainer" Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#2200F0FF" BorderBrush="#3300F0FF" BorderThickness="1">
                        <TextBlock x:Name="ClipboardIcon" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentCyan}"/>
                    </Border>

                    <!-- 中间：状态与摘要 -->
                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ClipboardStatusTitle" Text="已复制"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <Border x:Name="ClipboardModeBadge" Margin="6,0,0,0" Padding="4,1" CornerRadius="4"
                                    Background="#2600F0FF" VerticalAlignment="Center">
                                <TextBlock x:Name="ClipboardModeBadgeText" Text="文本" FontSize="9" Foreground="{StaticResource AccentCyan}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ClipboardPreviewText" FontSize="10" Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Text="内容预览"/>
                    </StackPanel>
                </Grid>

                <!-- ================= 文件中转站层（Tray 态专用，尺寸 360x72） ================= -->
                <Grid x:Name="FileTransferLayer" Opacity="0" Width="360" Height="72"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False" Visibility="Collapsed">
                    <!-- 1. 拖放投放分区 (左复制 / 右剪切) -->
                    <Grid x:Name="DropZoneGrid" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：复制此文件 -->
                        <Border x:Name="DropZoneCopy" Grid.Column="0" CornerRadius="14"
                                AllowDrop="True"
                                DragEnter="DropZoneCopy_DragEnter"
                                DragOver="DropZoneCopy_DragOver"
                                DragLeave="DropZoneCopy_DragLeave"
                                Drop="DropZoneCopy_Drop"
                                Background="#1A00F0FF" BorderBrush="#3300F0FF" BorderThickness="1.2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           VerticalAlignment="Center" Foreground="{StaticResource AccentCyan}"/>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="复制暂存" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="拖出时复制" FontSize="9.5" Foreground="{StaticResource TextTertiary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 右侧：剪切此文件 -->
                        <Border x:Name="DropZoneCut" Grid.Column="2" CornerRadius="14"
                                AllowDrop="True"
                                DragEnter="DropZoneCut_DragEnter"
                                DragOver="DropZoneCut_DragOver"
                                DragLeave="DropZoneCut_DragLeave"
                                Drop="DropZoneCut_Drop"
                                Background="#1AFF7043" BorderBrush="#33FF7043" BorderThickness="1.2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           VerticalAlignment="Center" Foreground="#FF8855"/>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="剪切暂存" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="拖出时移动" FontSize="9.5" Foreground="{StaticResource TextTertiary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 2. 有文件时的横向列表展示 -->
                    <Grid x:Name="FileListGrid" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <ItemsControl x:Name="TransferItemsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="56" Height="64" Margin="4,0" CornerRadius="10"
                                                Background="#22FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                                Cursor="Hand" ToolTip="{Binding FullPath}"
                                                PreviewMouseLeftButtonDown="TransferItem_PreviewMouseLeftButtonDown"
                                                PreviewMouseRightButtonUp="TransferItem_PreviewMouseRightButtonUp"
                                                MouseMove="TransferItem_MouseMove">
                                            <Grid Margin="3">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="36"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <!-- 文件图标 -->
                                                <Image Grid.Row="0" Source="{Binding IconSource}" Width="28" Height="28"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- 文件名 -->
                                                <TextBlock Grid.Row="1" Text="{Binding FileName}" FontSize="9.5"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                                <!-- 剪切模式小标签 -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Padding="2,1" CornerRadius="3" Background="#80FF7043"
                                                        Visibility="{Binding IsCut, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="剪切" FontSize="7" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 右侧快捷操作：收起与清空 -->
                        <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                            <Button x:Name="CloseFileTransferButton" Style="{StaticResource TransportButton}"
                                    FocusVisualStyle="{x:Null}" Focusable="False" Width="28" Height="28"
                                    ToolTip="直接收起中转站" Click="CloseFileTransferButton_Click">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#8CFFFFFF" HorizontalAlignment="Center"/>
                            </Button>
                            <Button x:Name="ClearFileTransferButton" Style="{StaticResource TransportButton}"
                                    FocusVisualStyle="{x:Null}" Focusable="False" Width="28" Height="28" Margin="0,3,0,0"
                                    ToolTip="清空中转站所有文件" Click="ClearFileTransferButton_Click">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#8CFFFFFF" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= 二级展开：卡片视口与分页指示器 (Win11 风格) ================= -->
                <!-- 固定尺寸 + 常驻 Visible：整棵卡片子树的测量/排列在岛体来回形变的全过程里都保持有效，
                     否则每次「收进小岛 → 展开」都要重新冷排版一次（实测 15~25ms，正好压在换态第一帧上，
                     用户感知为"点击后顿一下"）。隐藏靠 Opacity=0 + 岛体裁切 + IsHitTestVisible，不用 Collapsed。 -->
                <Grid x:Name="CardCarouselHost" Opacity="0" Margin="16,10,12,10" Width="402"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      PreviewMouseWheel="CardCarousel_PreviewMouseWheel">
                    <!-- 卡片视口：裁切边界，平滑垂直滑动 -->
                    <!-- 高度会被代码在抽屉展开时临时撑高（见 MainWindow.xaml.cs 的 SetCardDrawerExtra），
                         否则 194 的固定视口会把"输出设备/音量合成器"面板下半截连同命中测试一起裁掉。 -->
                    <Grid x:Name="CardViewport" Grid.Column="0" Height="194" ClipToBounds="True">
                        <!-- 第一层 (Page 0)：媒体播放器 -->
                        <Grid x:Name="CardLayer" VerticalAlignment="Center" Height="194">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="CardPage0Translate" Y="0"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>

                            <!-- 行 0：封面 + 曲目信息 + 传输控制 -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 封面槽：默认是 2D 圆角封面；开启「3D 封面」后换成 Viewport3D 里的
                                     3D 立体卡（场景在 MainWindow.Cover3D.cs 里用代码搭，方便调相机/光照）。
                                     两个子元素互斥显示，切换由 ApplyCover3DMode() 负责。 -->
                                <Grid x:Name="CardCoverHost" Grid.Column="0" Width="64" Height="64">
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14"/>
                                    </Grid.Clip>
                                    <Border x:Name="CardCover2D" CornerRadius="14"
                                            BorderBrush="#26FFFFFF" BorderThickness="1">
                                        <Border.Background>
                                            <ImageBrush x:Name="CardCoverBrush" Stretch="UniformToFill"/>
                                        </Border.Background>
                                        <TextBlock x:Name="CardMediaPlaceholder" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextTertiary}"/>
                                    </Border>
                                    <Viewport3D x:Name="CardCover3D" Visibility="Collapsed" ClipToBounds="True"/>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="12,2,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" Text="未在播放"/>
                                    <TextBlock x:Name="ArtistText" FontSize="11.5" Margin="0,3,0,0"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" Text=""/>
                                    <DockPanel Margin="0,2,0,0">
                                        <Button x:Name="MediaSourcesButton" DockPanel.Dock="Right" Width="20" Height="16" FontSize="10"
                                                Content="&#xE70D;" Style="{StaticResource TransportButton}" ToolTip="选择媒体来源"
                                                Click="MediaSourcesButton_Click" AutomationProperties.Name="选择媒体来源"/>
                                    <TextBlock x:Name="AlbumText" FontSize="10.5"
                                               Foreground="{StaticResource TextTertiary}"
                                               TextTrimming="CharacterEllipsis" Text=""/>
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PrevButton" Style="{StaticResource TransportButton}"
                                            FocusVisualStyle="{x:Null}" Focusable="False"
                                            Content="&#xE892;" Click="PrevButton_Click"/>
                                    <Button x:Name="PlayPauseButton" Style="{StaticResource TransportButton}"
                                            FocusVisualStyle="{x:Null}" Focusable="False"
                                            Margin="6,0" Click="PlayPauseButton_Click">
                                        <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;"/>
                                    </Button>
                                    <Button x:Name="NextButton" Style="{StaticResource TransportButton}"
                                            FocusVisualStyle="{x:Null}" Focusable="False"
                                            Content="&#xE893;" Click="NextButton_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- 行 1：歌词区 -->
                            <Grid x:Name="LyricsArea" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="26"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="LyricPrev" Grid.Row="0"
                                           FontSize="13" Foreground="#85FFFFFF" VerticalAlignment="Center"
                                           MaxWidth="370" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center">
                                    <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                    <TextBlock.Effect><BlurEffect Radius="2.2" RenderingBias="Performance"/></TextBlock.Effect>
                                </TextBlock>

                                <Grid x:Name="LyricCurrentHost" Grid.Row="1" MaxWidth="370" HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                                    <TextBlock x:Name="LyricCurrentDim"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="#BCFFFFFF"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LyricCurrentBright"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="#FAFFFFFF"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Grid>

                                <TextBlock x:Name="LyricTranslation" Grid.Row="2"
                                           FontSize="11" Foreground="#B3FFFFFF" Height="17" Visibility="Collapsed"
                                           MaxWidth="370" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center">
                                    <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                </TextBlock>

                                <TextBlock x:Name="LyricNext" Grid.Row="3"
                                           FontSize="13" Foreground="#85FFFFFF" VerticalAlignment="Center"
                                           MaxWidth="370" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center">
                                    <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                    <TextBlock.Effect><BlurEffect Radius="2.2" RenderingBias="Performance"/></TextBlock.Effect>
                                </TextBlock>
                            </Grid>

                            <!-- 行 2：波浪视区 -->

                            <!-- 行 3：进度条 -->
                            <Grid Grid.Row="3" Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="PositionText" Grid.Column="0" FontSize="10"
                                           VerticalAlignment="Center"
                                           Foreground="#8CFFFFFF" Text="0:00"/>

                                <Border x:Name="ProgressTrack" Grid.Column="1" Height="24" Margin="8,0"
                                        Background="Transparent" Cursor="Hand"
                                        MouseEnter="ProgressTrack_MouseEnter" MouseLeave="ProgressTrack_MouseLeave"
                                        MouseLeftButtonDown="ProgressTrack_MouseLeftButtonDown">
                                    <Grid x:Name="ProgressCapsule" Height="5" VerticalAlignment="Center"
                                          Background="#38FFFFFF" IsHitTestVisible="False"
                                          SizeChanged="ProgressCapsule_SizeChanged">
                                        <Border x:Name="ProgressFill" Background="#9FFFFFFF"
                                                HorizontalAlignment="Left" Width="0"/>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="10"
                                           VerticalAlignment="Center"
                                           Foreground="#8CFFFFFF" Text="0:00"/>
                            </Grid>
                        </Grid>

                        <!-- 第二层 (Page 1)：剪切板及历史 -->
                        <Grid x:Name="ClipboardCardLayer" VerticalAlignment="Center" Height="194"
                              Opacity="0" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="CardPage1Translate" Y="194"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="148"/>
                                <RowDefinition Height="16"/>
                            </Grid.RowDefinitions>

                            <!-- 行 0：头部（标题、数量、清空按钮） -->
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                                    <TextBlock Text="剪切板历史" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" Margin="8,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <Border CornerRadius="8" Background="#2600F0FF" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="ClipboardCountBadge" Text="0条" FontSize="9.5"
                                                   Foreground="{StaticResource AccentCyan}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- 清空所有记录 -->
                                    <Button x:Name="ClearClipboardButton"
                                            Width="28" Height="28" Cursor="Hand"
                                            FocusVisualStyle="{x:Null}" Focusable="False"
                                            ToolTip="清空剪切板历史" Click="ClearClipboardButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Width="28" Height="28" CornerRadius="14" Background="#18FFFFFF">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 行 1：列表区 / 空状态 -->
                            <Grid Grid.Row="1" Margin="0,4,0,2">
                                <!-- 历史列表 -->
                                <ScrollViewer x:Name="ClipboardHistoryScroll" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ItemsControl x:Name="ClipboardHistoryList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,2.5" Padding="8,5" CornerRadius="8"
                                                        Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                                        Cursor="Hand" ToolTip="点击直接粘贴"
                                                        MouseLeftButtonDown="ClipboardHistoryItem_MouseLeftButtonDown">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#2AFFFFFF"/>
                                                                    <Setter Property="BorderBrush" Value="#4400F0FF"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 图标 -->
                                                        <TextBlock Grid.Column="0" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="12" Foreground="{StaticResource AccentCyan}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                        <!-- 文本与时间 -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayText}" FontSize="11.5"
                                                                       Foreground="{StaticResource TextPrimary}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding TimeString}" FontSize="9"
                                                                       Foreground="{StaticResource TextTertiary}"
                                                                       Margin="0,1,0,0"/>
                                                        </StackPanel>

                                                        <!-- 粘贴按钮 -->
                                                        <Button Grid.Column="2" Margin="6,0,4,0" Cursor="Hand"
                                                                FocusVisualStyle="{x:Null}" Focusable="False"
                                                                ToolTip="立即粘贴" Click="PasteClipboardItem_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" CornerRadius="6" Background="#2600F0FF" BorderBrush="#3300F0FF" BorderThickness="1" Padding="7,3">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                                       Foreground="{StaticResource AccentCyan}" Margin="0,0,3,0"/>
                                                                            <TextBlock Text="粘贴" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#4400F0FF"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#6600F0FF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <!-- 删除单项按钮 -->
                                                        <Button Grid.Column="3" Width="24" Height="24" Margin="2,0,0,0" Cursor="Hand"
                                                                FocusVisualStyle="{x:Null}" Focusable="False"
                                                                ToolTip="删除此条" Click="DeleteClipboardItem_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Width="24" Height="24" CornerRadius="12" Background="Transparent">
                                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                                   Foreground="{StaticResource TextTertiary}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- 空状态提示 -->
                                <StackPanel x:Name="ClipboardEmptyState" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                               Foreground="#3DFFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock Text="暂无剪切板历史" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                               Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- 行 2：底部提示 -->
                            <TextBlock Grid.Row="2" Text="点击粘贴"
                                       FontSize="9" Foreground="{StaticResource TextTertiary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 第三层 (Page 2)：系统音量调节卡片 -->
                        <Grid x:Name="VolumeCardLayer" VerticalAlignment="Center" Height="194" Opacity="0" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="CardPage2Translate" Y="194"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 行 0：头部栏（音量图标、设备名、当前数值、静音切换） -->
                            <Grid Grid.Row="0" Margin="6,6,6,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左侧图标徽标 -->
                                <Border x:Name="CardVolumeIconContainer" Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                        Background="#2200E5FF" BorderBrush="#3300E5FF" BorderThickness="1">
                                    <TextBlock x:Name="CardVolumeIcon" Text="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentCyan}"/>
                                </Border>

                                <!-- 标题与当前音频输出设备 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="系统主音量" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="CardVolumeDeviceText" Text="默认输出设备" FontSize="10"
                                               Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- 右侧大字百分比与静音按钮 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="CardVolumePercentText" Text="50%" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <Button x:Name="CardVolumeMuteButton" Width="32" Height="32" Cursor="Hand"
                                            FocusVisualStyle="{x:Null}" Focusable="False"
                                            ToolTip="静音 / 恢复" Click="CardVolumeMuteButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Width="32" Height="32" CornerRadius="16" Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                    <TextBlock x:Name="MuteGlyph" Text="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 行 1：主体交互区（-5% 按钮 | 交互式拖动条 | +5% 按钮 + 预设组） -->
                            <Grid Grid.Row="1" Margin="6,0,6,0" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 主滑槽行（-5% 按钮 | 交互式拖动条 | +5% 按钮） -->
                                <Grid Grid.Row="0" Margin="0,6,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 减少音量微调按钮 -->
                                    <Button Grid.Column="0" Width="30" Height="30" Cursor="Hand"
                                            FocusVisualStyle="{x:Null}" Focusable="False"
                                            ToolTip="降低音量 (-5%)" Click="CardVolumeDown_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="15" Background="#1FFFFFFF" BorderBrush="#2FFFFFFF" BorderThickness="1">
                                                    <TextBlock Text="&#xE993;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- 交互式音量进度条槽（支持点击/拖拽定位） -->
                                    <Grid x:Name="CardVolumeSliderTrack" Grid.Column="1" Height="28" Margin="10,0" Cursor="Hand"
                                          Background="Transparent"
                                          PreviewMouseLeftButtonDown="CardVolumeSliderTrack_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="CardVolumeSliderTrack_MouseMove"
                                          PreviewMouseLeftButtonUp="CardVolumeSliderTrack_MouseLeftButtonUp"
                                          LostMouseCapture="CardVolumeSliderTrack_LostMouseCapture"
                                          MouseEnter="VolumeTrack_MouseEnter" MouseLeave="VolumeTrack_MouseLeave">
                                        <Grid x:Name="CardVolumeCapsule" Height="5" Background="#38FFFFFF" VerticalAlignment="Center"
                                              IsHitTestVisible="False" SizeChanged="VolumeCapsule_SizeChanged">
                                            <Border x:Name="CardVolumeSliderFill" Background="#9FFFFFFF" HorizontalAlignment="Left" Width="0"/>
                                        </Grid>
                                    </Grid>

                                    <!-- 增加音量微调按钮 -->
                                    <Button Grid.Column="2" Width="30" Height="30" Cursor="Hand"
                                            FocusVisualStyle="{x:Null}" Focusable="False"
                                            ToolTip="提高音量 (+5%)" Click="CardVolumeUp_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="15" Background="#1FFFFFFF" BorderBrush="#2FFFFFFF" BorderThickness="1">
                                                    <TextBlock Text="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- 快捷折叠控制区：切换输出设备与音量合成器 -->
                                <StackPanel Grid.Row="1" Margin="0,2,0,0">
                                    <!-- 折叠栏 1：声音输出设备快捷切换 -->
                                    <Border x:Name="AudioDeviceHeader" Margin="0,2" CornerRadius="6"
                                            Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonDown="AudioDeviceHeader_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#22FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#4400F0FF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Height="22" Margin="8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE7F6;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"
                                                           Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                                                <TextBlock Text="输出设备: " FontSize="9.5" Foreground="{StaticResource TextTertiary}" Margin="6,0,2,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="CurrentDeviceNameLabel" Text="默认输出设备" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="AudioDeviceChevron" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                       Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform x:Name="AudioDeviceChevronRotate" Angle="0"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- 输出设备展开面板 -->
                                    <Grid x:Name="AudioDevicePanel" Height="0" Opacity="0" ClipToBounds="True" Visibility="Collapsed">
                                        <Border CornerRadius="6" Background="#26000000" BorderBrush="#1FFFFFFF" BorderThickness="1" Margin="0,1,0,3" Padding="3">
                                            <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                                <ItemsControl x:Name="AudioDeviceList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,1" Padding="6,3" CornerRadius="4" Background="Transparent"
                                                                    Cursor="Hand" MouseLeftButtonDown="AudioDeviceItem_MouseLeftButtonDown">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#22FFFFFF"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" FontSize="9.5" Foreground="{StaticResource TextPrimary}"
                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9.5"
                                                                               Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"
                                                                               Visibility="{Binding CheckVisibility}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>

                                    <!-- 折叠栏 2：音量合成器快捷管理 -->
                                    <Border x:Name="VolumeMixerHeader" Margin="0,2" CornerRadius="6"
                                            Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonDown="VolumeMixerHeader_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#22FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#4400F0FF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Height="22" Margin="8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"
                                                           Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                                                <TextBlock Text="音量合成器与应用控制" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="VolumeMixerChevron" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                       Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform x:Name="VolumeMixerChevronRotate" Angle="0"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- 音量合成器展开面板 -->
                                    <Grid x:Name="VolumeMixerPanel" Height="0" Opacity="0" ClipToBounds="True" Visibility="Collapsed">
                                        <Border CornerRadius="6" Background="#26000000" BorderBrush="#1FFFFFFF" BorderThickness="1" Margin="0,1,0,3" Padding="4">
                                            <StackPanel>
                                                <Button Style="{StaticResource TransportButton}" Margin="0,1,0,3" Height="22"
                                                        Cursor="Hand" Focusable="False" Click="OpenSystemVolumeMixer_Click">
                                                    <Border CornerRadius="4" Background="#2000E5FF" BorderBrush="#3300E5FF" BorderThickness="1" Padding="6,2">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE7AC;" FontFamily="Segoe MDL2 Assets" FontSize="9.5" Foreground="{StaticResource AccentCyan}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="打开系统音量合成器设置" FontSize="9.5" Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Button>
                                                <ScrollViewer MaxHeight="46" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                                    <ItemsControl x:Name="VolumeAppSessionsList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="2,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" FontSize="9" Foreground="{StaticResource TextSecondary}"
                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    <Button Grid.Column="1" Height="18" Padding="6,1" Cursor="Hand" Margin="4,0,0,0"
                                                                            Focusable="False" Click="ToggleAppMute_Click">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border CornerRadius="3" Background="#1FFFFFFF" BorderBrush="#2FFFFFFF" BorderThickness="1" Padding="4,1">
                                                                                    <TextBlock Text="{Binding MuteText}" FontSize="8"
                                                                                               Foreground="{Binding MuteColorBrush}"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- 行 2：底部提示 -->
                        </Grid>

                        <!-- 第四层 (Page 3)：AI 对话卡片（B 组②）
                             高度 194 与另三层一致，展开阅读区由 SetCardDrawerExtra 撑高整卡与视口
                             （见 MainWindow.Ai.cs 的 AiGrow/AiShrink）。
                             气泡由代码建（Dispatcher 逐段追加），XAML 只留容器。 -->
                        <Grid x:Name="AiCardLayer" VerticalAlignment="Center" Height="194" Opacity="0" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="CardPage3Translate" Y="582"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 行 0：头部（状态徽标、模型/状态文字、复制/重试/停止/清空） -->
                            <Grid Grid.Row="0" Margin="6,6,6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                        Background="#2200E5FF" BorderBrush="#3300E5FF" BorderThickness="1">
                                    <TextBlock x:Name="AiStatusGlyph" Text="&#xE99A;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentCyan}"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="AI 对话" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="AiStatusText" Text="就绪" FontSize="9.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextTertiary}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="AiCopyButton" Style="{StaticResource TransportButton}"
                                            Width="26" Height="26" FontSize="11" Content="&#xE8C8;"
                                            ToolTip="复制最后一条回复" Click="AiCopyButton_Click"/>
                                    <Button x:Name="AiRetryButton" Style="{StaticResource TransportButton}"
                                            Width="26" Height="26" FontSize="11" Margin="4,0,0,0" Content="&#xE72C;"
                                            ToolTip="重试上一条提问" Click="AiRetryButton_Click"/>
                                    <Button x:Name="AiStopButton" Style="{StaticResource TransportButton}"
                                            Width="26" Height="26" FontSize="11" Margin="4,0,0,0" Content="&#xE71A;"
                                            ToolTip="停止生成" Visibility="Collapsed" Click="AiStopButton_Click"/>
                                    <Button x:Name="AiClearButton" Style="{StaticResource TransportButton}"
                                            Width="26" Height="26" FontSize="11" Margin="4,0,0,0" Content="&#xE74D;"
                                            ToolTip="清空对话" Click="AiClearButton_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- 行 1：气泡区（可滚动；空态提示浮在上面） -->
                            <Grid Grid.Row="1" Margin="6,0,6,0">
                                <ScrollViewer x:Name="AiScrollViewer" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <StackPanel x:Name="AiBubbleStack" Margin="0,2,4,2"/>
                                </ScrollViewer>
                                <TextBlock x:Name="AiEmptyText" Text="暂无对话"
                                           FontSize="10.5" Foreground="{StaticResource TextTertiary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="20,0"
                                           IsHitTestVisible="False"/>
                            </Grid>

                            <!-- 行 2：输入框 + 发送 -->
                            <Border x:Name="AiInputBorder" Grid.Row="2" Margin="6,4,6,6" CornerRadius="8"
                                    Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="AiInputBox" Background="Transparent" BorderThickness="0"
                                                 CaretBrush="{StaticResource TextPrimary}"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 FontSize="11.5" Padding="9,0" MaxLength="4000"
                                                 VerticalContentAlignment="Center" AcceptsReturn="False"
                                                 TextWrapping="NoWrap"
                                                 PreviewMouseLeftButtonDown="AiInputBox_PreviewMouseLeftButtonDown"
                                                 GotKeyboardFocus="AiInputBox_GotKeyboardFocus"
                                                 LostKeyboardFocus="AiInputBox_LostKeyboardFocus"
                                                 PreviewKeyDown="AiInputBox_PreviewKeyDown"
                                                 TextChanged="AiInputBox_TextChanged"/>
                                        <TextBlock x:Name="AiInputHint" Text="输入消息…（Enter 发送）"
                                                   FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                    </Grid>

                                    <Button x:Name="AiSendButton" Grid.Column="1" Style="{StaticResource TransportButton}"
                                            Width="28" Height="28" FontSize="12" Margin="4" Content="&#xE724;"
                                            ToolTip="发送 (Enter)" Click="AiSendButton_Click"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 第五层 (Page 4)：实时网速卡片（C 组②·需求①）
                             网速是"一直想看"的量：这里给实时上下行 + 最近 60 秒曲线；
                             细条上的常驻数字与「下载期间常显」的胶囊都由同一份采样驱动。 -->
                        <Grid x:Name="NetSpeedCardLayer" VerticalAlignment="Center" Height="194" Opacity="0" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="CardPage4Translate" Y="582"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 行 0：头部（图标 / 状态 / 峰值 / 网卡名） -->
                            <Grid Grid.Row="0" Margin="6,6,6,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                        Background="#2222D3EE" BorderBrush="#3322D3EE" BorderThickness="1">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#22D3EE"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="实时网速" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="NetSpeedCardStatusText" Text="采样中…" FontSize="9.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextTertiary}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="NetSpeedCardPeakText" Text="峰值 —" FontSize="9.5"
                                               Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="NetSpeedCardAdapterText" Text="—" FontSize="9"
                                               Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Right"
                                               Margin="0,2,0,0" MaxWidth="130" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                            <!-- 行 1：实时上下行大号数值 -->
                            <Grid Grid.Row="1" Margin="6,6,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="下行" FontSize="9.5" Foreground="{StaticResource TextTertiary}"/>
                                    <TextBlock x:Name="NetSpeedCardDownText" Text="—" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" Margin="0,1,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,2">
                                    <TextBlock Text="上行" FontSize="9.5"
                                               Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="NetSpeedCardUpText" Text="—" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 行 2：最近 60 秒曲线（每秒一个点，超过 60 个点整体左移） -->
                            <Grid Grid.Row="2" Margin="6,4,6,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <controls:Sparkline Grid.Row="0" x:Name="NetSpeedSparkline" VerticalAlignment="Stretch"
                                                    Stroke="{StaticResource AccentCyan}" Fill="#2200E5FF"
                                                    StrokeThickness="1.6" Capacity="60"/>
                                <TextBlock Grid.Row="1" x:Name="NetSpeedCardHintText" Text="近 60 秒"
                                           FontSize="9" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                            </Grid>
                        </Grid>

                        <!-- 第六层 (Page 5)：系统状态卡片（C 组②·需求①）
                             内存 / 功耗 / 飞行模式 / 隐私 合并成一页（用户拍板），四个格子各显示实时值；
                             对应服务没开时格子写"未开启"并指出去哪儿打开 —— 这一页本身始终能翻到、能看。 -->
                        <Grid x:Name="SystemCardLayer" VerticalAlignment="Center" Height="194" Opacity="0" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="CardPage5Translate" Y="582"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="6,6,6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                        Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentCyan}"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="系统状态" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="SystemCardSummaryText" Text="内存 · 功耗 · 飞行模式 · 隐私"
                                               FontSize="9.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextTertiary}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="6,0,6,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 内存 -->
                                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,3,3" CornerRadius="10"
                                        Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                    <Grid Margin="8,5,8,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE950;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="{StaticResource AccentCyan}"
                                                   VerticalAlignment="Top" Margin="0,1,6,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="内存占用" FontSize="9" Foreground="{StaticResource TextTertiary}"/>
                                            <TextBlock x:Name="SysCardMemValue" Text="—" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}" Margin="0,1,0,0"/>
                                            <TextBlock x:Name="SysCardMemDetail" Text="" FontSize="8.5"
                                                       Foreground="{StaticResource TextTertiary}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 功耗 -->
                                <Border Grid.Row="0" Grid.Column="1" Margin="3,0,0,3" CornerRadius="10"
                                        Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                    <Grid Margin="8,5,8,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE945;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="{StaticResource AccentCyan}"
                                                   VerticalAlignment="Top" Margin="0,1,6,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="放电功率" FontSize="9" Foreground="{StaticResource TextTertiary}"/>
                                            <TextBlock x:Name="SysCardPowerValue" Text="—" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}" Margin="0,1,0,0"/>
                                            <TextBlock x:Name="SysCardPowerDetail" Text="" FontSize="8.5"
                                                       Foreground="{StaticResource TextTertiary}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 飞行模式 -->
                                <Border Grid.Row="1" Grid.Column="0" Margin="0,3,3,0" CornerRadius="10"
                                        Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                    <Grid Margin="8,5,8,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE709;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="{StaticResource AccentCyan}"
                                                   VerticalAlignment="Top" Margin="0,1,6,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="飞行模式" FontSize="9" Foreground="{StaticResource TextTertiary}"/>
                                            <TextBlock x:Name="SysCardAirValue" Text="—" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}" Margin="0,1,0,0"/>
                                            <TextBlock x:Name="SysCardAirDetail" Text="" FontSize="8.5"
                                                       Foreground="{StaticResource TextTertiary}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 隐私（麦克风 / 摄像头占用） -->
                                <Border Grid.Row="1" Grid.Column="1" Margin="3,3,0,0" CornerRadius="10"
                                        Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                    <Grid Margin="8,5,8,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE720;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="{StaticResource AccentCyan}"
                                                   VerticalAlignment="Top" Margin="0,1,6,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="麦克风 / 摄像头" FontSize="9" Foreground="{StaticResource TextTertiary}"/>
                                            <TextBlock x:Name="SysCardPrivacyValue" Text="—" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}" Margin="0,1,0,0"/>
                                            <TextBlock x:Name="SysCardPrivacyDetail" Text="" FontSize="8.5"
                                                       Foreground="{StaticResource TextTertiary}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ============ 第 7 页：下载进度（浏览器 / Steam） ============
                         数据来自 MainWindow.Downloads.cs（只读浏览器 History 的 downloads 表 + Steam 的
                         appmanifest 清单）。固定三行，行内进度条宽度由代码按轨道实际宽度 × 比例设置。 -->
                    <Grid x:Name="DownloadCardLayer" VerticalAlignment="Center" Height="194" Opacity="0" IsHitTestVisible="False">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="CardPage6Translate" Y="582"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="6,6,6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                    Background="#2234D399" BorderBrush="#3334D399" BorderThickness="1">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#34D399"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="下载状态" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="DownloadCardSummaryText" Text=""
                                           FontSize="9.5" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextTertiary}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="6,0,6,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid x:Name="DlRow1" Grid.Row="0" Margin="0,0,0,3" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DlName1" Grid.Row="0" FontSize="10.5" Text=""
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <Border x:Name="DlTrack1" Grid.Row="1" Height="4" CornerRadius="2"
                                        Margin="0,3,0,2" Background="#1FFFFFFF">
                                    <Border x:Name="DlFill1" Height="4" CornerRadius="2" Width="0"
                                            HorizontalAlignment="Left" Background="#34D399"/>
                                </Border>
                                <TextBlock x:Name="DlMeta1" Grid.Row="2" FontSize="8.5" Text=""
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextTertiary}"/>
                            </Grid>

                            <Grid x:Name="DlRow2" Grid.Row="1" Margin="0,0,0,3" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DlName2" Grid.Row="0" FontSize="10.5" Text=""
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <Border x:Name="DlTrack2" Grid.Row="1" Height="4" CornerRadius="2"
                                        Margin="0,3,0,2" Background="#1FFFFFFF">
                                    <Border x:Name="DlFill2" Height="4" CornerRadius="2" Width="0"
                                            HorizontalAlignment="Left" Background="#34D399"/>
                                </Border>
                                <TextBlock x:Name="DlMeta2" Grid.Row="2" FontSize="8.5" Text=""
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextTertiary}"/>
                            </Grid>

                            <Grid x:Name="DlRow3" Grid.Row="2" Margin="0,0,0,3" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DlName3" Grid.Row="0" FontSize="10.5" Text=""
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <Border x:Name="DlTrack3" Grid.Row="1" Height="4" CornerRadius="2"
                                        Margin="0,3,0,2" Background="#1FFFFFFF">
                                    <Border x:Name="DlFill3" Height="4" CornerRadius="2" Width="0"
                                            HorizontalAlignment="Left" Background="#34D399"/>
                                </Border>
                                <TextBlock x:Name="DlMeta3" Grid.Row="2" FontSize="8.5" Text=""
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextTertiary}"/>
                            </Grid>

                            <TextBlock x:Name="DownloadEmptyText" Grid.Row="0" Grid.RowSpan="3"
                                       Text="暂无下载任务"
                                       FontSize="10" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="12,0,12,0"
                                       Foreground="{StaticResource TextTertiary}"/>
                        </Grid>
                    </Grid>

                </Grid>

                <!-- 收回动画中间态那颗球：默认显示**专辑封面**（圆形裁剪），取不到封面时退回 Siri 炫彩渐变。
                     外层名字保留 SiriOrb / SiriOrbTranslate，代码里的滑入与淡入淡出动画不用改。 -->
                <Grid x:Name="SiriOrb" Width="46" Height="46"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Opacity="0" IsHitTestVisible="False">
                    <Ellipse x:Name="OrbGradient">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#00F0FF" Offset="0"/>
                                <GradientStop Color="#7000FF" Offset="0.6"/>
                                <GradientStop Color="#FF007A" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse x:Name="OrbCover" Margin="5" Opacity="0">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="OrbCoverBrush" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="OrbCoverRing" Margin="5" Opacity="0"
                             Stroke="#4DFFFFFF" StrokeThickness="1"/>

                    <!-- 收缩过渡状态专属矢量图标（音量、外设、问候等） -->
                    <Border x:Name="OrbIconContainer" Margin="5" CornerRadius="18"
                            Opacity="0" ClipToBounds="True">
                        <TextBlock x:Name="OrbIcon"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#FFFFFFFF"/>
                    </Border>

                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SiriOrbTranslate" X="-40" Y="0"/>
                    </Grid.RenderTransform>
                </Grid>
            </Grid>
        </Border>
        </Grid>
            <!-- 外置切换线：独立于岛体裁切，共享岛体尺寸与挤压/位移，只在线条附近命中。 -->
            <Canvas Width="{Binding Width, ElementName=IslandBody}"
                    Height="{Binding Height, ElementName=IslandBody}"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    RenderTransform="{Binding RenderTransform, ElementName=IslandBody}"
                    RenderTransformOrigin="0.5,0.5" Panel.ZIndex="3">
                <controls:IslandContourHandle x:Name="ComponentHandle"
                    Canvas.Left="{Binding Width, ElementName=IslandBody}"
                    Width="34" Height="{Binding Height, ElementName=IslandBody}"
                    ContourCornerRadius="{Binding CornerRadius, ElementName=IslandBody}"
                    Visibility="Collapsed"/>
            </Canvas>

        <!-- 右侧置顶小胶囊提示（多岛分离胶囊动效） -->
        <Border x:Name="PinBubble"
                Width="84" Height="30"
                CornerRadius="15"
                Background="#E5101016"
                BorderBrush="{StaticResource GlassEdgeBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,21,0,0"
                Panel.ZIndex="2"
                ClipToBounds="True"
                Cursor="Arrow"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                  Color="#000000" Opacity="0.5"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PinBubbleScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="PinBubbleTranslate" X="160" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="PinBubbleIcon" Text="&#xE718;" FontFamily="Segoe MDL2 Assets"
                           FontSize="12" Foreground="{StaticResource AccentCyan}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="PinBubbleText" Text="已置顶" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" Margin="5,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 卡片旁的缩略岛：展示其他活跃组件；点击切换并保持卡片展开。
             几何由 Core/SatelliteRail.cs 的左侧车道管理，跟随岛宽变化并避免重叠。 -->
        <Border x:Name="SideBubble"
                Width="112" Height="28"
                CornerRadius="14"
                Background="{Binding Background, ElementName=IslandBody}"
                BorderBrush="{StaticResource GlassEdgeBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,21,0,0"
                Panel.ZIndex="2"
                ClipToBounds="True"
                Cursor="Hand"
                MouseLeftButtonUp="SideBubble_MouseLeftButtonUp"
                IsHitTestVisible="True"
                Visibility="Collapsed"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                  Color="#000000" Opacity="0.5"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SideBubbleScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="SideBubbleTranslate" X="-160" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
            <ContentControl x:Name="SideBubbleCustomContent" Visibility="Collapsed"/>
            <StackPanel x:Name="SideBubbleGeneric" Orientation="Horizontal" Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="SideBubbleArtwork" Width="24" Height="24" Visibility="Collapsed"/>
                <TextBlock x:Name="SideBubbleIcon" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                           FontSize="12" Foreground="{StaticResource AccentCyan}"
                           VerticalAlignment="Center"/>
                <StackPanel Margin="6,0,0,0">
                <TextBlock x:Name="SideBubbleText" Text="" FontSize="11" FontWeight="SemiBold"
                           MaxWidth="104" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SideBubbleDetail" FontSize="9" MaxWidth="104" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            </Grid>
        </Border>

        <!-- 动态卫星小岛挂载容器（多岛并行显示：音量/下载/蓝牙等缩小为小岛） -->
        <Grid x:Name="SatellitesHost" Panel.ZIndex="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"/>

        <!-- 左侧音乐收缩圆球（多岛分离动效：置顶/播放中其他模块弹出时，音乐向左缩小成圆） -->
        <Border x:Name="MusicOrbBubble"
                Width="36" Height="36"
                CornerRadius="18"
                Background="#E5101016"
                BorderBrush="{StaticResource GlassEdgeBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"
                Panel.ZIndex="2"
                ClipToBounds="True"
                Cursor="Hand"
                IsHitTestVisible="True"
                Visibility="Collapsed"
                Opacity="0"
                ToolTip="点击恢复媒体播放器（右键置顶/取消置顶）"
                MouseLeftButtonDown="MusicOrbBubble_MouseLeftButtonDown"
                PreviewMouseLeftButtonDown="MusicOrbBubble_MouseLeftButtonDown"
                PreviewMouseRightButtonUp="MusicOrbBubble_PreviewMouseRightButtonUp"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                  Color="#000000" Opacity="0.5"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MusicOrbScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="MusicOrbTranslate" X="-148" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <!-- 专辑封面底图（若无封面显示多彩微光渐变与音乐音符） -->
                <Ellipse x:Name="MusicOrbGradient">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#00F0FF" Offset="0"/>
                            <GradientStop Color="#7000FF" Offset="0.6"/>
                            <GradientStop Color="#FF007A" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock x:Name="MusicOrbPlaceholder" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                           FontSize="14" Foreground="#FFFFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse x:Name="MusicOrbCover" Margin="2" Opacity="0">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="MusicOrbCoverBrush" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Margin="2" Stroke="#4DFFFFFF" StrokeThickness="1"/>
                <TextBlock x:Name="MusicOrbPinIcon" Text="&#xE718;" FontFamily="Segoe MDL2 Assets"
                           FontSize="8" Foreground="{StaticResource AccentCyan}"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,3,3,0" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
