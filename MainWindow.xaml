<Window x:Class="alpha_island.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:alpha_island.Controls"
        Title="Alpha Island"
        Width="640" Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <!-- 根容器：岛体始终水平居中、贴屏幕顶部 -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">

        <!-- ============ 岛体本体：液态玻璃 ============
             所有材质层共用 IslandBody.CornerRadius（用 Binding 跟随），
             所以动画器只改一个 CornerRadius，内阴影/流光/高光全部同步变形。 -->
        <Border x:Name="IslandBody"
                Width="130" Height="10"
                CornerRadius="0,0,10,10"
                ClipToBounds="True"
                Cursor="Hand"
                BorderThickness="1"
                BorderBrush="{StaticResource GlassEdgeBrush}"
                MouseEnter="IslandBody_MouseEnter"
                MouseLeftButtonDown="IslandBody_MouseLeftButtonDown"
                RenderTransformOrigin="0.5,0.5">
            <Border.Background>
                <LinearGradientBrush x:Name="GlassGradient" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="GlassTopStop" Color="#D916161D" Offset="0"/>
                    <GradientStop x:Name="GlassBottomStop" Color="#E509090D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.RenderTransform>
                <!-- 顺序很重要：先挤压形变，再位移。
                     反过来的话 IsolaTranslate.Y 会被 ScaleY 在窗口坐标里缩放，
                     贴顶位置会随挤压量上下漂。 -->
                <TransformGroup>
                    <ScaleTransform x:Name="IslandSquash" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="IslandTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="IslandShadow" BlurRadius="26" ShadowDepth="7" Direction="270"
                                  Color="#000000" Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <!-- ⓪ 流体波浪层：整岛最底层，满幅出血。
                     必须放在"岛体根容器"里（而不是 CardLayer 里）——
                     放在 CardLayer 里时它的绘制区域会被 CardLayer 的 392 宽布局盒裁掉，
                     左右各剩 14px 的纯玻璃黑边（实测屏幕 764..1152 vs 岛体 750..1170）。
                     放在这里由 IslandBody.ClipToBounds 按圆角裁切，左右铺满、圆角自然。 -->
                <controls:WaveVisualizer x:Name="CardWave"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                         Margin="-2"
                                         IsHitTestVisible="False"
                                         Opacity="0"
                                         PointCount="56"
                                         Amplitude="1.25"
                                         BassBoost="0.68" Smoothing="0.35"
                                         Sensitivity="2.0"
                                         FillOpacity="0.50"
                                         GlowRadius="14" GlowOpacity="0.55"
                                         IsActive="False">
                    <!-- 下缘化开：波浪的色量本来就堆在底部，正好压着进度条。
                         用户要求"淡一点、融进其他元素"，所以整体再降一档 alpha。 -->
                    <controls:WaveVisualizer.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#B3FFFFFF" Offset="0.55"/>
                            <GradientStop Color="#59FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </controls:WaveVisualizer.OpacityMask>
                </controls:WaveVisualizer>

                <!-- ① 内层厚度：让玻璃看起来有壁厚而不是一张纸 -->
                <Border Margin="1"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBody}"
                        Background="{StaticResource GlassInnerShadowBrush}"
                        IsHitTestVisible="False"/>

                <!-- ② 折射流光：凝胶形变时横向扫过（IslandAnimator 驱动 SheenTranslate.X） -->
                <Border x:Name="SheenLayer"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBody}"
                        Background="{StaticResource GlassSheenBrush}"
                        Opacity="0.55"
                        IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SheenTranslate" X="0" Y="0"/>
                    </Border.RenderTransform>
                </Border>

                <!-- ③ 顶缘高光 -->
                <Rectangle Height="1" VerticalAlignment="Top" Margin="14,1,14,0"
                           Fill="{StaticResource GlassTopHighlightBrush}"
                           IsHitTestVisible="False"/>

                <!-- ③b 镜面高光条：凝胶形变时随形变量加长，并沿顶边滑行
                     （IslandAnimator 逐帧驱动 Width / Opacity / SpecularTranslate.X） -->
                <Rectangle x:Name="SpecularBar" Height="2" RadiusX="1" RadiusY="1"
                           Width="90" Opacity="0"
                           VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,1,0,0"
                           Fill="{StaticResource GlassTopHighlightBrush}"
                           IsHitTestVisible="False">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="SpecularTranslate" X="0" Y="0"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- ================= 一级展开：长椭圆 =================
                     左侧圆角封面 + 中间当前歌词 + 右侧可视化 -->
                <Grid x:Name="PillLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="PillCoverHost" Grid.Column="0"
                            Width="32" Height="32" CornerRadius="16"
                            BorderBrush="#33FFFFFF" BorderThickness="1">
                        <Border.Background>
                            <ImageBrush x:Name="PillCoverBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <!-- 中间歌词：放得下就居中静止，放不下就走马灯横向滚动。
                         宽度实测与动画由 MainWindow.UpdatePillLyricScroll() 负责。 -->
                    <Grid x:Name="PillLyricHost" Grid.Column="1" Margin="10,0"
                          ClipToBounds="True" VerticalAlignment="Center"
                          SizeChanged="PillLyricHost_SizeChanged">
                        <StackPanel x:Name="PillLyricTrack" Orientation="Horizontal"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="PillLyricScroll"/>
                            </StackPanel.RenderTransform>
                            <TextBlock x:Name="PillLyric"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Text="Alpha Island"/>
                            <!-- 跑马灯的第二份：接在第一份后面，形成无缝循环 -->
                            <TextBlock x:Name="PillLyricEcho"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="56,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- 一级胶囊右侧：iOS 风格的细柱频谱（柱体恒定胶囊形，两端半圆）。
                         颜色由 MainWindow.ApplyArtwork 从专辑封面主色调注入，半透叠在黑色底上。 -->
                    <Grid Grid.Column="2" Width="96" Height="26">
                        <controls:SpectrumVisualizer x:Name="PillSpectrum"
                                                     Width="96" Height="26"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     BarCount="19" BarGap="2"
                                                     MinBarHeight="2.5" CenterEmphasis="0.40"
                                                     GlowRadius="1.6" GlowOpacity="0.26"
                                                     IsActive="False"/>

                        <!-- 换曲 / 暂停提示：右侧状态指示 -->
                        <StackPanel x:Name="PillUpNext" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock x:Name="PillUpNextIcon" Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentCyan}"/>
                            <TextBlock x:Name="PillUpNextText" Text="接下来"
                                       FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= 启动问候层（与 PillLayer 同级同尺寸） ================= -->
                <Grid x:Name="GreetingLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：问候流光徽标 -->
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#2200E5FF" BorderBrush="#3300E5FF" BorderThickness="1">
                        <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#00E5FF"/>
                    </Border>

                    <!-- 中间：欢迎文字 -->
                    <TextBlock x:Name="GreetingText" Grid.Column="1"
                               Margin="12,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Text="欢迎回来"/>

                    <!-- 右侧：品牌徽标 -->
                    <Border Grid.Column="2" Padding="8,4" CornerRadius="10"
                            Background="#1AFFFFFF" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="Alpha Island" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </Border>
                </Grid>

                <!-- ================= 蓝牙通知层（与 PillLayer 同级同尺寸，互斥显示） =================
                     蓝牙设备连接时弹出：左侧 3D 旋转模型/矢量图标、中间设备名称、右侧电量。
                     布局尺寸与 PillLayer 完全一致，复用 Pill 形态的 IslandBody 尺寸。 -->
                <Grid x:Name="BtNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：3D 设备模型（耳机）或专属外设矢量图标（键鼠手柄） -->
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            ClipToBounds="True" Background="#1AFFFFFF" x:Name="BtIconContainer">
                        <Grid>
                            <controls:DeviceModelView x:Name="BtDeviceModel"
                                                      Width="32" Height="32"
                                                      IsRotating="False"/>
                            <TextBlock x:Name="BtDeviceIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimary}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- 中间：蓝牙设备名称 -->
                    <TextBlock x:Name="BtDeviceName" Grid.Column="1"
                               Margin="10,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               Text="蓝牙设备"/>

                    <!-- 右侧：电池图标 + 电量百分比 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="BtBatteryText"
                                   FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="--"/>
                    </StackPanel>
                </Grid>

                <!-- ================= 系统音量调节层（与 PillLayer 同级同尺寸，互斥显示） =================
                     音量调节时弹出：左侧自适应音量图标、中间音量进度条、右侧数字百分比。 -->
                <Grid x:Name="VolumeNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：音量状态圆形徽标（随音量大小和静音状态变化） -->
                    <Border x:Name="VolumeIconContainer" Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#2200E5FF" BorderBrush="#3300E5FF" BorderThickness="1">
                        <TextBlock x:Name="VolumeIcon" Text="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#00E5FF"/>
                    </Border>

                    <!-- 中间：音量大小进度条 -->
                    <Grid x:Name="VolumeTrackContainer" Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Height="20">
                        <!-- 背景槽 -->
                        <Border Height="6" CornerRadius="3" Background="#26FFFFFF" VerticalAlignment="Center"/>
                        <!-- 填充条 -->
                        <Border x:Name="VolumeProgressFill" Height="6" CornerRadius="3"
                                Background="{StaticResource AccentCyan}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Width="0"/>
                    </Grid>

                    <!-- 右侧：数字形式展现 -->
                    <TextBlock x:Name="VolumeText" Grid.Column="2"
                               Margin="0,0,4,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Text="50%"/>
                </Grid>

                <!-- ================= 二级展开：完整卡片 ================= -->
                <Grid x:Name="CardLayer" Opacity="0" Width="392" Margin="14,12,14,10"
                      HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="14"/>
                    </Grid.RowDefinitions>

                    <!-- 波浪层已上移到岛体根容器（CardLayer 会把它裁成 392 宽，左右留黑边） -->
                    <!-- 行 0：封面 + 曲目信息 + 传输控制 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="14"
                                BorderBrush="#26FFFFFF" BorderThickness="1">
                            <Border.Background>
                                <ImageBrush x:Name="CardCoverBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,2,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" FontSize="14.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis" Text="未在播放"/>
                            <TextBlock x:Name="ArtistText" FontSize="11.5" Margin="0,3,0,0"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" Text=""/>
                            <TextBlock x:Name="AlbumText" FontSize="10.5" Margin="0,2,0,0"
                                       Foreground="{StaticResource TextTertiary}"
                                       TextTrimming="CharacterEllipsis" Text=""/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PrevButton" Style="{StaticResource TransportButton}"
                                    FocusVisualStyle="{x:Null}" Focusable="False"
                                    Content="&#xE892;" Click="PrevButton_Click"/>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource TransportButton}"
                                    FocusVisualStyle="{x:Null}" Focusable="False"
                                    Margin="6,0" Click="PlayPauseButton_Click">
                                <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;"/>
                            </Button>
                            <Button x:Name="NextButton" Style="{StaticResource TransportButton}"
                                    FocusVisualStyle="{x:Null}" Focusable="False"
                                    Content="&#xE893;" Click="NextButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 行 1：歌词区（四级行高 15/24/14/15）。
                         用户要求：上下一句预览透明度更低，当前句略微透明但仍清晰可读。
                         卡拉OK 擦除 = Dim 全句打底 + Bright 同文本叠一层 + RectangleGeometry 裁剪。 -->
                    <Grid x:Name="LyricsArea" Grid.Row="1" Visibility="Collapsed" Margin="0,6,0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="15"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="LyricPrev" Grid.Row="0"
                                   FontSize="11" Foreground="#3DFFFFFF"
                                   MaxWidth="380" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"/>

                        <Grid Grid.Row="1" MaxWidth="380" HorizontalAlignment="Center">
                            <TextBlock x:Name="LyricCurrentDim"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="#59FFFFFF"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LyricCurrentBright"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="#EBFFFFFF"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="LyricTranslation" Grid.Row="2"
                                   FontSize="11" Foreground="#B300F0FF"
                                   MaxWidth="380" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"/>

                        <TextBlock x:Name="LyricNext" Grid.Row="3"
                                   FontSize="11" Foreground="#3DFFFFFF"
                                   MaxWidth="380" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                    </Grid>

                    <!-- 行 2：留空。用户要求完全展开态**只保留底层的流体波浪**，
                         不要离散柱状频谱和波浪并存（元素会显得混乱）。
                         这 34px 就是波浪露出来的主视区。 -->

                    <!-- 行 3：进度条 -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PositionText" Grid.Column="0" FontSize="10"
                                   VerticalAlignment="Center"
                                   Foreground="#8CFFFFFF" Text="0:00"/>

                        <Border x:Name="ProgressTrack" Grid.Column="1" Height="12" Margin="8,0"
                                Background="Transparent" Cursor="Hand"
                                MouseLeftButtonDown="ProgressTrack_MouseLeftButtonDown">
                            <Grid VerticalAlignment="Center">
                                <Border Height="4" CornerRadius="2" Background="#26FFFFFF"/>
                                <Border x:Name="ProgressFill" Height="4" CornerRadius="2"
                                        HorizontalAlignment="Left" Width="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00F0FF" Offset="0"/>
                                            <GradientStop Color="#7000FF" Offset="0.55"/>
                                            <GradientStop Color="#FF007A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="10"
                                   VerticalAlignment="Center"
                                   Foreground="#8CFFFFFF" Text="0:00"/>
                    </Grid>
                </Grid>

                <!-- 收回动画中间态那颗球：默认显示**专辑封面**（圆形裁剪），取不到封面时退回 Siri 炫彩渐变。
                     外层名字保留 SiriOrb / SiriOrbTranslate，代码里的滑入与淡入淡出动画不用改。 -->
                <Grid x:Name="SiriOrb" Width="46" Height="46"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Opacity="0" IsHitTestVisible="False">
                    <Ellipse x:Name="OrbGradient">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#00F0FF" Offset="0"/>
                                <GradientStop Color="#7000FF" Offset="0.6"/>
                                <GradientStop Color="#FF007A" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse x:Name="OrbCover" Margin="5" Opacity="0">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="OrbCoverBrush" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="OrbCoverRing" Margin="5" Opacity="0"
                             Stroke="#4DFFFFFF" StrokeThickness="1"/>

                    <!-- 收缩过渡状态专属矢量图标（音量、外设、问候等） -->
                    <Border x:Name="OrbIconContainer" Margin="5" CornerRadius="18"
                            Opacity="0" ClipToBounds="True">
                        <TextBlock x:Name="OrbIcon"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#FFFFFFFF"/>
                    </Border>

                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SiriOrbTranslate" X="-40" Y="0"/>
                    </Grid.RenderTransform>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
