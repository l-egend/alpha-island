<Window x:Class="alpha_island.Controls.QuickLauncherWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:icons="clr-namespace:AlphaIsland.PluginSdk;assembly=AlphaIsland.PluginSdk"
 Width="520" Height="440" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Title="快速启动器"
 Foreground="{DynamicResource ControlTextBrush}" FontFamily="{DynamicResource AppFontFamily}" UseLayoutRounding="True">
 <Border x:Name="LauncherShell" Background="{DynamicResource ControlPopupBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
         BorderThickness="1" CornerRadius="{DynamicResource WindowCornerRadius}" Padding="18">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="2,0,2,12">
    <TextBlock DockPanel.Dock="Right" Text="Esc 关闭" FontSize="11.5" Foreground="{DynamicResource ControlMutedTextBrush}" VerticalAlignment="Center"/>
    <TextBlock Text="快速启动" FontSize="15" FontWeight="SemiBold"/>
   </DockPanel>
   <Grid Grid.Row="1">
    <TextBox x:Name="SearchBox" Style="{StaticResource ThemedTextBox}" FontSize="15" Padding="34,9,10,9"
             AutomationProperties.Name="搜索应用、组件或助手" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}"/>
    <icons:GlyphIcon Text="" FontSize="15" Foreground="{DynamicResource ControlMutedTextBrush}"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
    <TextBlock x:Name="SearchPlaceholder" Text="搜索应用、组件或助手…" Margin="35,0,10,0" VerticalAlignment="Center"
               FontSize="13" Foreground="{DynamicResource ControlMutedTextBrush}" IsHitTestVisible="False">
     <TextBlock.Style>
      <Style TargetType="TextBlock">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
   </Grid>
   <ListBox x:Name="ResultList" Style="{StaticResource ThemedListBox}" Grid.Row="2" Margin="0,10,0,10" Padding="0" Background="Transparent" BorderThickness="0"
    ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource ControlMutedTextBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel Grid.Row="3" Margin="2,0">
    <TextBlock Text="↑↓ 选择 · Enter 打开" Foreground="{DynamicResource ControlMutedTextBrush}" FontSize="11.5"/>
    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ControlTextBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,0">
     <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
     </Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </StackPanel>
  </Grid>
 </Border>
</Window>
