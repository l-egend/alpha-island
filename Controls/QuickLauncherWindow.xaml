<Window x:Class="alpha_island.Controls.QuickLauncherWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="520" Height="440" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Title="快速启动器">
 <Border Background="#F0181820" BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="16" Padding="16">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="快速启动 · 搜索应用、组件或助手" Foreground="White" FontSize="14" Margin="2,0,0,10"/>
   <TextBox x:Name="SearchBox" Grid.Row="1" FontSize="17" Padding="9,7" Background="#16FFFFFF" Foreground="White"
    CaretBrush="White" BorderBrush="#40FFFFFF" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}"/>
   <ListBox x:Name="ResultList" Grid.Row="2" Margin="0,8,0,8" Background="Transparent" BorderThickness="0" Foreground="White"
    ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,5"><TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Detail}" FontSize="10" Opacity="0.65" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#BFFFFFFF" FontSize="10" TextWrapping="Wrap"/>
  </Grid>
 </Border>
</Window>
