<UserControl x:Class="alpha_island.Controls.WelcomeRabbitIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="32" Height="32" ClipToBounds="False" IsHitTestVisible="False">
    <!-- The badge stays 32px; the ears extend 7px above it, inside the 48px island. -->
    <Canvas ClipToBounds="False">
        <Border Width="32" Height="32" CornerRadius="16" BorderThickness="1">
            <Border.Background><SolidColorBrush Color="{Binding Color, Source={StaticResource AccentCyan}}" Opacity="0.133"/></Border.Background>
            <Border.BorderBrush><SolidColorBrush Color="{Binding Color, Source={StaticResource AccentCyan}}" Opacity="0.267"/></Border.BorderBrush>
        </Border>
        <Path Fill="#F5F8FF" Stroke="#B9CBDD" StrokeThickness="0.65"
              Data="M 9,17 C 6,12 5,-5 9,-7 C 13,-8 16,9 15,16 Z">
            <Path.RenderTransform><RotateTransform x:Name="LeftEarRotation" CenterX="12" CenterY="16"/></Path.RenderTransform>
        </Path>
        <Path Fill="#F5F8FF" Stroke="#B9CBDD" StrokeThickness="0.65"
              Data="M 18,16 C 16,9 19,-7 23,-6 C 27,-5 26,11 24,17 Z">
            <Path.RenderTransform><RotateTransform x:Name="RightEarRotation" CenterX="21" CenterY="16"/></Path.RenderTransform>
        </Path>
        <Path Fill="#F0A9C6" Data="M 10,12 C 8,6 8,-3 9,-4 C 11,-3 13,7 12,12 Z">
            <Path.RenderTransform><RotateTransform x:Name="LeftInnerRotation" CenterX="12" CenterY="16"/></Path.RenderTransform>
        </Path>
        <Path Fill="#F0A9C6" Data="M 21,12 C 20,7 21,-3 23,-3 C 25,-2 24,7 23,12 Z">
            <Path.RenderTransform><RotateTransform x:Name="RightInnerRotation" CenterX="21" CenterY="16"/></Path.RenderTransform>
        </Path>
        <Path Fill="#F5F8FF" Stroke="#B9CBDD" StrokeThickness="0.65"
              Data="M 16,10 C 7,10 3,14 3,21 C 3,28 8,31 16,31 C 24,31 29,28 29,21 C 29,14 25,10 16,10 Z"/>
        <Ellipse Canvas.Left="6" Canvas.Top="22" Width="5" Height="3" Fill="#F0A9C6" Opacity="0.75"/>
        <Ellipse Canvas.Left="21" Canvas.Top="22" Width="5" Height="3" Fill="#F0A9C6" Opacity="0.75"/>
        <Ellipse Canvas.Left="10" Canvas.Top="18" Width="2.5" Height="3.5" Fill="#243144" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><ScaleTransform x:Name="LeftEyeScale"/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Canvas.Left="20" Canvas.Top="18" Width="2.5" Height="3.5" Fill="#243144" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><ScaleTransform x:Name="RightEyeScale"/></Ellipse.RenderTransform>
        </Ellipse>
        <Path Fill="#DE88AC" Data="M 14,23 Q 16,21.5 18,23 L 16,25 Z"/>
        <Path Stroke="#526075" StrokeThickness="0.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M 16,25 L 16,26 M 16,26 Q 14,28 12.5,26.5 M 16,26 Q 18,28 19.5,26.5"/>
    </Canvas>
</UserControl>
