                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="工具权限审批通知"/>
                                        <TextBlock Style="{StaticResource W11RowHint}" Text="Y 允许，N 拒绝"/>
                                    </StackPanel>
                                    <CheckBox Checked="Setting_Changed" Grid.Column="2" IsChecked="True"
                                              Style="{StaticResource W11Switch}" Unchecked="Setting_Changed"
                                              VerticalAlignment="Center" x:Name="AgentApprovalToggle"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== 关于 ========== -->
                    <StackPanel Visibility="Collapsed" x:Name="Page_Plugins">
                        <TextBlock Style="{StaticResource W11PageTitle}" Text="插件"/>
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,12">
                            <Button Content="刷新插件列表" Click="RefreshPlugins_Click"/>
                            <Button Content="打开插件目录" Click="OpenPluginsFolder_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource W11RowHint}" TextWrapping="Wrap" Margin="2,0,2,16"
                                   Text="新插件默认关闭；更新已加载插件后需重启"/>
                        <StackPanel x:Name="PluginRows"/>
                    </StackPanel>

                    <StackPanel Visibility="Collapsed" x:Name="Page_About">
                        <TextBlock Style="{StaticResource W11PageTitle}" Text="关于"/>

                        <Border Margin="0,26,0,0" Style="{StaticResource W11Card}">
                            <Grid Style="{StaticResource W11Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource GlobeIcon}" Fill="{StaticResource W11AccentBrush}"
                                      Height="44" Stretch="Uniform" VerticalAlignment="Center" Width="44"/>
                                <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource W11TextPrimary}"
                                               Text="Alpha Island"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Margin="2,18,0,8" Style="{StaticResource W11CardTitle}" Text="运行环境"/>
                        <Border Style="{StaticResource W11Card}">
                            <TextBlock LineHeight="20" Margin="16,16,16,16" Style="{StaticResource W11RowHint}"
                                       Text="WPF · .NET 8 · 监听 SMTC + WASAPI 环回" TextWrapping="Wrap" x:Name="AboutText"/>
                        </Border>

                        <TextBlock Margin="2,18,0,8" Style="{StaticResource W11CardTitle}" Text="能力检测"/>
                        <Border Style="{StaticResource W11Card}">
                            <TextBlock LineHeight="20" Margin="16,14,16,14" Style="{StaticResource W11RowHint}"
                                       Text="读取中…" TextWrapping="Wrap" x:Name="CapabilityText"/>
                        </Border>

                        <TextBlock Margin="2,18,0,8" Style="{StaticResource W11CardTitle}" Text="服务状态"/>
                        <Border Style="{StaticResource W11Card}">
                            <TextBlock LineHeight="20" Margin="16,14,16,14" Style="{StaticResource W11RowHint}"
                                       Text="读取中…" TextWrapping="Wrap" x:Name="ServiceText"/>
                        </Border>

                        <TextBlock Margin="2,18,0,8" Style="{StaticResource W11CardTitle}" Text="最近日志"/>
                        <Border Style="{StaticResource W11Card}">
                            <TextBox AcceptsReturn="True" Background="Transparent" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="12" Foreground="{StaticResource W11TextTertiary}"
                                     HorizontalScrollBarVisibility="Auto" IsReadOnly="True" Margin="12"
                                     MaxHeight="200" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" x:Name="LogText"/>
                        </Border>

                        <WrapPanel Margin="0,16,0,4" Orientation="Horizontal">
                            <Button Click="CopyDiagnosticsButton_Click" Content="复制报告"
                                    Style="{StaticResource W11Button}" x:Name="CopyDiagnosticsButton"/>
                            <Button Click="OpenLogFolderButton_Click" Content="打开日志目录" Margin="10,0,0,0"
                                    Style="{StaticResource W11Button}" x:Name="OpenLogFolderButton"/>
                            <Button Click="ExportDiagnosticsButton_Click" Content="导出诊断包" Margin="10,0,0,0"
                                    Style="{StaticResource W11Button}" x:Name="ExportDiagnosticsButton"/>
                            <Button Click="OpenConfigFolderButton_Click" Content="打开配置目录" Margin="10,0,0,0"
                                    Style="{StaticResource W11Button}" x:Name="OpenConfigFolderButton"/>
                        </WrapPanel>

                        <TextBlock Margin="2,6,0,0" Style="{StaticResource W11RowHint}"
                                   Text="诊断包中的密钥已隐藏"
                                   TextWrapping="Wrap" x:Name="DiagnosticsHint"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
