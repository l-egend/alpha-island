<Window AllowsTransparency="False" Background="{StaticResource W11WindowBrush}" Closing="Window_Closing" FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" Foreground="{StaticResource W11TextPrimary}" Height="600" Icon="pack://application:,,,/alpha-island;component/Assets/alpha-island.ico" ResizeMode="NoResize" ShowInTaskbar="True" TextOptions.TextRenderingMode="Grayscale" Title="Alpha Island 设置" UseLayoutRounding="True" Width="880" WindowStartupLocation="Manual" WindowStyle="None" x:Class="alpha_island.Settings.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Windows 11 风格设置界面（框架版）
         版式：40px 自绘标题栏 + 244px 导航面板 + 内容滚动区
         卡片 = 32px 图标槽 + 标题/说明 + 右侧控件，行间缩进分隔线
         图标槽都是具名的 Border（Icon_xxx），后续直接把内容填进去即可。
         ============================================================ -->

    <Window.Resources>
        <SolidColorBrush x:Key="ControlAccentBrush" Color="#4DB1FF"/>
        <SolidColorBrush x:Key="ControlAccentSoftBrush" Color="#264DB1FF"/>
        <Style TargetType="Button" BasedOn="{StaticResource W11Button}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource W11TextBox}"/>
        <!-- 用户给的 globe 图标：SVG 里唯一一条 path 的 d 原样搬过来（WPF 路径迷你语言与 SVG 语法互通）。
             必须显式写 FillRule="Nonzero"：浏览器对没写 fill-rule 的 SVG 用非零规则，WPF 缺省是偶奇，不覆盖会画反。 -->
        <PathGeometry x:Key="GlobeIcon" FillRule="Nonzero" Figures="M64,126c34.2,0,62-27.8,62-62S98.2,2,64,2S2,29.8,2,64S29.8,126,64,126z M16,88.7l25.2-0.2c2.8,10.1,7.5,19.9,13.9,28.7C38,114.4,23.7,103.5,16,88.7z M47.6,47H79c2.3,11,2.3,22.3,0.2,33.3l-31.6,0.2C45.3,69.4,45.3,58,47.6,47z M63.3,114.9c-6.3-8.1-10.9-17-13.7-26.4l27.5-0.2C74.2,97.7,69.6,106.7,63.3,114.9z M71.3,117.5c6.6-9,11.3-18.9,14.1-29.3l26.9-0.2C104.5,103.7,89.3,115,71.3,117.5z M118,64c0,5.6-0.9,11-2.4,16l-28.3,0.2c2-11,1.9-22.2-0.2-33.2h28.1C117,52.3,118,58.1,118,64z M111.8,39H85.2c-2.9-10-7.5-19.7-13.9-28.5C89,12.9,103.9,23.8,111.8,39z M76.9,39H49.7c2.9-9.2,7.4-17.9,13.6-25.9C69.5,21.1,74,29.8,76.9,39z M55.1,10.8C48.8,19.5,44.2,29,41.4,39H16.2C23.9,24.3,38.1,13.6,55.1,10.8z M39.5,47c-2.1,11.1-2.1,22.4-0.1,33.5l-26.7,0.2C10.9,75.4,10,69.8,10,64c0-5.9,1-11.7,2.8-17H39.5z"/>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 标题栏 ================= -->
        <Grid Background="Transparent" Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource GlobeIcon}" Fill="{StaticResource W11AccentBrush}"
                      Height="16" Stretch="Uniform" VerticalAlignment="Center" Width="16"/>
                <TextBlock FontSize="12" Foreground="{StaticResource W11TextSecondary}" Margin="10,0,0,0"
                           Text="Alpha Island 设置" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Click="MinimizeButton_Click" Content="&#xE921;" Style="{StaticResource W11TitleBarButton}" x:Name="MinimizeButton"/>
                <Button Click="CloseButton_Click" Content="&#xE8BB;" Style="{StaticResource W11CloseButton}" x:Name="CloseButton"/>
            </StackPanel>
        </Grid>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 导航面板 ===== -->
            <!-- Width 由代码控制：展开 244 / 收起 48（只留图标） -->
            <Grid Background="{StaticResource W11NavBrush}" ClipToBounds="True" Grid.Column="0"
                  Width="244" x:Name="NavPane">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部：收起按钮（三横线）+ 搜索框 -->
                <Grid Grid.Row="0">
                    <Button Click="NavCollapse_Click" Height="32" HorizontalAlignment="Left"
                            Margin="10,4,0,12" Style="{StaticResource W11NavCollapse}"
                            ToolTip="收起导航栏" Width="32" x:Name="NavCollapseButton"/>

                    <Border Background="{StaticResource W11ControlFill}" BorderBrush="{StaticResource W11ControlBorder}"
                            BorderThickness="1" CornerRadius="4" Height="32" Margin="46,4,14,12" x:Name="SearchBorder">
                        <Grid>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource W11TextTertiary}"
                                       HorizontalAlignment="Left" Margin="11,0,0,0" Text="&#xE721;" VerticalAlignment="Center"/>
                            <TextBlock Foreground="{StaticResource W11TextTertiary}" FontSize="12.5" IsHitTestVisible="False"
                                       Margin="34,0,0,0" Text="搜索设置" VerticalAlignment="Center" x:Name="SearchPlaceholder"/>
                            <TextBox Style="{StaticResource W11SearchBox}" Margin="32,0,10,0"
                                     TextChanged="SearchBox_TextChanged" x:Name="SearchBox"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 导航项：Tag = 页面键，Uid = 搜索用的中文名 -->
                <ScrollViewer Grid.Row="1" Padding="10,0,10,10" VerticalScrollBarVisibility="Auto" x:Name="NavScroll">
                    <StackPanel Orientation="Vertical" x:Name="NavPanel">
                        <RadioButton Checked="Nav_Checked" GroupName="nav" IsChecked="True" Style="{StaticResource W11NavItem}"
                                     Tag="appearance" Uid="外观">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE790;" VerticalAlignment="Center" Width="22"/>
                                <TextBlock Text="外观" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}"
                                     Tag="island" Uid="岛屿与动效 展开 专辑封面">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" VerticalAlignment="Center" Width="22"/>
                                <TextBlock Text="岛屿与动效" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}"
                                     Tag="media" Uid="媒体与播放 音乐 播放 暂停 换曲 窗口 联动 动画 网易云 QQ Spotify 酷狗 酷我 Apple">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" VerticalAlignment="Center" Width="22"/>
                                <TextBlock Text="媒体与播放" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}"
                                     Tag="audio" Uid="音频可视化 频谱 灵敏度 设备">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9E9;" VerticalAlignment="Center" Width="22"/>
                                <TextBlock Text="音频可视化" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}"
                                     Tag="lyrics" Uid="歌词 翻译 数据源">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D2;" VerticalAlignment="Center" Width="22"/>
                                <TextBlock Text="歌词" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}"
                                     Tag="focus" Uid="番茄钟 专注 休息 计时 循环 提示音">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE916;" VerticalAlignment="Center" Width="22"/>
                                <TextBlock Text="番茄钟" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}"
                                     Tag="behavior" Uid="交互与工具 剪切板 热键 文件中转站 重置 维护">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" VerticalAlignment="Center" Width="22"/>
                                <TextBlock Text="交互与工具" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}"
                                     Tag="notifications" Uid="通知与提醒 消息 静默 权限 过滤 音量 蓝牙 连接 启动 问候">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" VerticalAlignment="Center" Width="22"/>
                                <TextBlock Text="通知与提醒" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}"
                                     Tag="system" Uid="系统状态 网速 下载 内存 功率 飞行模式 麦克风 摄像头 隐私指示灯">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" VerticalAlignment="Center" Width="22"/>
                                <TextBlock Text="系统状态" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}"
                                     Tag="ai" Uid="AI 对话 大模型 密钥 agent 桥接 审批 端口">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE99A;" VerticalAlignment="Center" Width="22"/>
                                <TextBlock Text="AI / Agent" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}"
                                     Tag="plugins" Uid="插件 模块 扩展 启用 禁用 开发">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA86;" VerticalAlignment="Center" Width="22"/>
                                <TextBlock Text="插件" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}"
                                     Tag="about" Uid="关于 版本 运行环境">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" VerticalAlignment="Center" Width="22"/>
                                <TextBlock Text="关于" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Foreground="{StaticResource W11TextTertiary}" FontSize="11" Grid.Row="2"
                           Margin="18,0,18,14" Text="左键托盘图标可再次打开" TextWrapping="Wrap" x:Name="NavFooter"/>
            </Grid>

            <!-- ===== 内容区 ===== -->
            <ScrollViewer x:Name="SettingsContentScroll" Grid.Column="1" Padding="30,20,30,28" VerticalScrollBarVisibility="Auto">
                <Grid>

                    <!-- ========== 外观 ========== -->
                    <StackPanel Visibility="Visible" x:Name="Page_Appearance">
                        <TextBlock Style="{StaticResource W11PageTitle}" Text="外观"/>

                        <TextBlock Margin="2,26,0,8" Style="{StaticResource W11CardTitle}" Text="玻璃"/>
                        <Border Style="{StaticResource W11Card}">
                            <StackPanel Orientation="Vertical">
                                <Grid Style="{StaticResource W11Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_GlassOpacity">
                                        <TextBlock Style="{StaticResource W11IconGlyph}" Text="&#xE790;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="玻璃不透明度"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider IsSnapToTickEnabled="False" LargeChange="0.05" Maximum="0.98" Minimum="0.05"
                                                SmallChange="0.01" Style="{StaticResource W11Slider}" Value="0.08"
                                                ValueChanged="Slider_Changed" Width="140" x:Name="GlassOpacitySlider"/>
                                        <TextBlock Style="{StaticResource W11Value}" x:Name="GlassOpacityValue"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource W11RowDivider}"/>

                                <Grid Style="{StaticResource W11Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_LiquidGlass">
                                        <TextBlock Style="{StaticResource W11IconGlyph}" Text="&#xE7F4;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="流动玻璃质感"/>
                                    </StackPanel>
                                    <CheckBox Checked="Setting_Changed" Grid.Column="2" IsChecked="True"
                                              Style="{StaticResource W11Switch}" Unchecked="Setting_Changed"
                                              VerticalAlignment="Center" x:Name="LiquidGlassToggle"/>
                                </Grid>

                                <Border Style="{StaticResource W11RowDivider}"/>

                                <Grid Style="{StaticResource W11Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_Gel">
                                        <TextBlock Style="{StaticResource W11IconGlyph}" Text="&#xE945;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="果冻弹性动画"/>
                                    </StackPanel>
                                    <CheckBox Checked="Setting_Changed" Grid.Column="2" IsChecked="True"
                                              Style="{StaticResource W11Switch}" Unchecked="Setting_Changed"
                                              VerticalAlignment="Center" x:Name="GelAnimationToggle"/>
                                </Grid>

                                <Border Style="{StaticResource W11RowDivider}"/>

                                <Grid Style="{StaticResource W11Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_ReduceMotion">
                                        <TextBlock Style="{StaticResource W11IconGlyph}" Text="&#xE7E8;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="减弱动效"/>
                                    </StackPanel>
                                    <CheckBox Checked="Setting_Changed" Grid.Column="2"
                                              Style="{StaticResource W11Switch}" Unchecked="Setting_Changed"
                                              VerticalAlignment="Center" x:Name="ReduceMotionToggle"/>
                                </Grid>

                                <Border Style="{StaticResource W11RowDivider}"/>

                                <Grid Style="{StaticResource W11Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_PowerSave">
                                        <TextBlock Style="{StaticResource W11IconGlyph}" Text="&#xE945;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="节能模式"/>
                                    </StackPanel>
                                    <CheckBox Checked="Setting_Changed" Grid.Column="2"
                                              Style="{StaticResource W11Switch}" Unchecked="Setting_Changed"
                                              VerticalAlignment="Center" x:Name="PowerSaveToggle"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== 岛屿与动效 ========== -->
                    <StackPanel Visibility="Collapsed" x:Name="Page_Island">
                        <TextBlock Style="{StaticResource W11PageTitle}" Text="岛屿与动效"/>

                        <TextBlock Margin="2,26,0,8" Style="{StaticResource W11CardTitle}" Text="展开行为"/>
                        <Border Style="{StaticResource W11Card}">
                            <StackPanel Orientation="Vertical">
                                <Grid Style="{StaticResource W11Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_TwoStep">
                                        <TextBlock Style="{StaticResource W11IconGlyph}" Text="&#xE8A9;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="两段式展开"/>
                                    </StackPanel>
                                    <CheckBox Checked="Setting_Changed" Grid.Column="2" IsChecked="True"
                                              Style="{StaticResource W11Switch}" Unchecked="Setting_Changed"
                                              VerticalAlignment="Center" x:Name="TwoStepExpandToggle"/>
                                </Grid>

                                <Border Style="{StaticResource W11RowDivider}"/>

                                <Grid Style="{StaticResource W11Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_Cover">
                                        <TextBlock Style="{StaticResource W11IconGlyph}" Text="&#xE91B;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="展示专辑封面"/>
                                    </StackPanel>
                                    <CheckBox Checked="Setting_Changed" Grid.Column="2" IsChecked="True"
                                              Style="{StaticResource W11Switch}" Unchecked="Setting_Changed"
                                              VerticalAlignment="Center" x:Name="ShowCoverToggle"/>
                                </Grid>

                                <Border Style="{StaticResource W11RowDivider}"/>

                                <Grid Style="{StaticResource W11Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_Cover3D">
                                        <TextBlock Style="{StaticResource W11IconGlyph}" Text="&#xE809;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="3D 封面"/>
                                        <TextBlock Style="{StaticResource W11RowHint}" Text="不支持时自动使用 2D 封面"/>
                                    </StackPanel>
                                    <CheckBox Checked="Setting_Changed" Grid.Column="2"
                                              Style="{StaticResource W11Switch}" Unchecked="Setting_Changed"
                                              VerticalAlignment="Center" x:Name="Cover3DToggle"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== 音频可视化 ========== -->
                    <StackPanel Visibility="Collapsed" x:Name="Page_Media">
                        <TextBlock Style="{StaticResource W11PageTitle}" Text="媒体与播放"/>

                        <TextBlock Margin="2,26,0,8" Style="{StaticResource W11CardTitle}" Text="播放行为"/>
                        <Border Style="{StaticResource W11Card}">
                            <StackPanel Orientation="Vertical">
                                <Grid Style="{StaticResource W11Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_KeepCompact">
                                        <TextBlock Style="{StaticResource W11IconGlyph}" Text="&#xE7C4;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="播放时保持紧凑"/>
                                    </StackPanel>
                                    <CheckBox Checked="Setting_Changed" Grid.Column="2" Style="{StaticResource W11Switch}"
                                              Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="KeepCompactToggle"/>
                                </Grid>

                                <Border Style="{StaticResource W11RowDivider}"/>

                                <Grid Style="{StaticResource W11Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_HidePausedMedia">
                                        <TextBlock Style="{StaticResource W11IconGlyph}" Text="&#xE769;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="媒体暂停时隐藏"/>
                                        <TextBlock Style="{StaticResource W11RowHint}" Text="暂停提醒结束后收起；置顶保持显示"/>
                                    </StackPanel>
                                    <CheckBox Checked="Setting_Changed" Grid.Column="2" Style="{StaticResource W11Switch}"
                                              Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="MediaHideWhenPausedToggle"/>
                                </Grid>

                                <Border Style="{StaticResource W11RowDivider}"/>
                                <Grid Style="{StaticResource W11Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_MediaHandoff">
                                        <TextBlock Style="{StaticResource W11IconGlyph}" Text="&#xE8A7;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="媒体窗口联动（试验）"/>
                                        <TextBlock Style="{StaticResource W11RowHint}" Text="网易云、QQ 音乐、Spotify、酷狗、酷我及 Apple Music；浏览器仅前台隐藏" TextWrapping="Wrap" MaxWidth="370"/>
                                    </StackPanel>
                                    <CheckBox x:Name="MediaWindowHandoffToggle" Grid.Column="2" Style="{StaticResource W11Switch}"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Style="{StaticResource W11RowDivider}"/>

                                <Grid Style="{StaticResource W11Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_UpNext">
                                        <TextBlock Style="{StaticResource W11IconGlyph}" Text="&#xE893;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="换曲提示"/>
                                    </StackPanel>
                                    <CheckBox Checked="Setting_Changed" Grid.Column="2" IsChecked="True"
                                              Style="{StaticResource W11Switch}" Unchecked="Setting_Changed"
                                              VerticalAlignment="Center" x:Name="UpNextToggle"/>
                                </Grid>

                                <Border Style="{StaticResource W11RowDivider}"/>

                                <Grid Style="{StaticResource W11Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
