<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="clr-namespace:AlphaIsland.PluginSdk;assembly=AlphaIsland.PluginSdk" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" AllowsTransparency="False" Background="{StaticResource W11WindowBrush}" Closing="Window_Closing" FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI, Microsoft YaHei" Foreground="{StaticResource W11TextPrimary}" Height="600" MinWidth="780" MinHeight="540" Icon="pack://application:,,,/alpha-island;component/Assets/alpha-island.ico" ResizeMode="CanResize" ShowInTaskbar="True" TextOptions.TextRenderingMode="Grayscale" Title="Alpha Island 设置" UseLayoutRounding="True" Width="880" WindowStartupLocation="Manual" WindowStyle="None" x:Class="alpha_island.Settings.SettingsWindow">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="5" GlassFrameThickness="1" CornerRadius="8" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/>
    </shell:WindowChrome.WindowChrome>
    <!-- Windows 11 风格设置：顶部固定搜索，左侧导航，内容按设置项独立成卡片。 -->
    <Window.Resources>
        <SolidColorBrush x:Key="ControlAccentBrush" Color="#4DB1FF"/>
        <SolidColorBrush x:Key="ControlAccentSoftBrush" Color="#264DB1FF"/>
        <Style TargetType="Button" BasedOn="{StaticResource W11Button}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource W11TextBox}"/>
        <!-- SVG 图标路径使用与浏览器一致的填充规则。
             必须显式写 FillRule="Nonzero"：浏览器对没写 fill-rule 的 SVG 用非零规则，WPF 缺省是偶奇，不覆盖会画反。 -->
        <PathGeometry x:Key="GlobeIcon" FillRule="Nonzero" Figures="M64,126c34.2,0,62-27.8,62-62S98.2,2,64,2S2,29.8,2,64S29.8,126,64,126z M16,88.7l25.2-0.2c2.8,10.1,7.5,19.9,13.9,28.7C38,114.4,23.7,103.5,16,88.7z M47.6,47H79c2.3,11,2.3,22.3,0.2,33.3l-31.6,0.2C45.3,69.4,45.3,58,47.6,47z M63.3,114.9c-6.3-8.1-10.9-17-13.7-26.4l27.5-0.2C74.2,97.7,69.6,106.7,63.3,114.9z M71.3,117.5c6.6-9,11.3-18.9,14.1-29.3l26.9-0.2C104.5,103.7,89.3,115,71.3,117.5z M118,64c0,5.6-0.9,11-2.4,16l-28.3,0.2c2-11,1.9-22.2-0.2-33.2h28.1C117,52.3,118,58.1,118,64z M111.8,39H85.2c-2.9-10-7.5-19.7-13.9-28.5C89,12.9,103.9,23.8,111.8,39z M76.9,39H49.7c2.9-9.2,7.4-17.9,13.6-25.9C69.5,21.1,74,29.8,76.9,39z M55.1,10.8C48.8,19.5,44.2,29,41.4,39H16.2C23.9,24.3,38.1,13.6,55.1,10.8z M39.5,47c-2.1,11.1-2.1,22.4-0.1,33.5l-26.7,0.2C10.9,75.4,10,69.8,10,64c0-5.9,1-11.7,2.8-17H39.5z"/>
    </Window.Resources>
    <Grid x:Name="RootGrid" Background="Transparent">
        <Border x:Name="SettingsShell" Background="{StaticResource W11WindowBrush}" BorderBrush="{StaticResource W11WindowBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid x:Name="SettingsLayout" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- ================= 标题栏 ================= -->
                <Grid Background="Transparent" Grid.Row="0" x:Name="SettingsTitleBar">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TitleNavigationColumn" Width="196"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="SettingsBrandIcon" Width="20" Height="20" Source="pack://application:,,,/alpha-island;component/Assets/alpha-island-source.png" Stretch="Uniform" VerticalAlignment="Center">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,20,20" RadiusX="4" RadiusY="4"/>
                            </Image.Clip>
                        </Image>
                        <TextBlock x:Name="SettingsBrandLabel" FontSize="12.5" Foreground="{StaticResource W11TextPrimary}" Margin="10,0,0,0" Text="Alpha Island 设置" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Grid.Column="2">
                        <Button Click="MinimizeButton_Click" Content="" ToolTip="最小化" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource W11TitleBarButton}" x:Name="MinimizeButton"/>
                        <Button Click="MaximizeButton_Click" Content="" ToolTip="最大化" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource W11TitleBarButton}" x:Name="MaximizeButton"/>
                        <Button Click="CloseButton_Click" Content="" ToolTip="关闭设置" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource W11CloseButton}" x:Name="CloseButton"/>
                    </StackPanel>
                    <Grid x:Name="SettingsSearchHost" Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                    <Border Background="{StaticResource W11ControlFill}" BorderBrush="{StaticResource W11ControlBorder}" BorderThickness="1" CornerRadius="6" Height="34" x:Name="SearchBorder" Width="380" MaxWidth="{Binding ActualWidth, ElementName=SettingsSearchHost}" HorizontalAlignment="Left" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <icons:GlyphIcon FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource W11TextSecondary}" HorizontalAlignment="Left" Margin="11,0,0,0" Text="" VerticalAlignment="Center"/>
                            <TextBlock Foreground="{StaticResource W11TextTertiary}" FontSize="12.5" IsHitTestVisible="False" Margin="34,0,0,0" Text="搜索设置" VerticalAlignment="Center" x:Name="SearchPlaceholder"/>
                            <TextBox Style="{StaticResource W11SearchBox}" Margin="32,0,10,0" TextChanged="SearchBox_TextChanged" x:Name="SearchBox" ToolTip="搜索设置（Ctrl+F）" AutomationProperties.Name="搜索设置"/>
                        </Grid>
                    </Border>
                    </Grid>
                </Grid>
                <!-- ================= 主体 ================= -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- ===== 导航面板 ===== -->
                    <!-- Width 由代码控制：展开 196 / 收起 48（只留图标） -->
                    <Grid Background="{StaticResource W11NavBrush}" ClipToBounds="True" Grid.Column="0" Margin="0,4,0,0" Width="196" SizeChanged="NavPane_SizeChanged" x:Name="NavPane">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 导航收起按钮；搜索固定在窗口顶部 -->
                        <Grid Grid.Row="0">
                            <Button Click="NavCollapse_Click" Height="32" HorizontalAlignment="Left" Margin="10,4,0,12" Style="{StaticResource W11NavCollapse}" ToolTip="收起导航栏" Width="32" x:Name="NavCollapseButton"/>
                        </Grid>
                        <!-- 导航项：Tag = 页面键，Uid = 搜索用的中文名 -->
                        <ScrollViewer Grid.Row="1" Padding="10,0,10,10" VerticalScrollBarVisibility="Auto" x:Name="NavScroll">
                            <Grid x:Name="NavItemsSurface">
                                <StackPanel Orientation="Vertical" x:Name="NavPanel">
                                    <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}" Tag="general" Uid="常规" IsChecked="True">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:GlyphIcon Text="" Width="22" VerticalAlignment="Center"/>
                                            <TextBlock Text="常规" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Checked="Nav_Checked" GroupName="nav" IsChecked="False" Style="{StaticResource W11NavItem}" Tag="appearance" Uid="外观与动效 音频 可视化 歌词 削减 动效 节能 玻璃 拉伸">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:GlyphIcon FontFamily="Segoe MDL2 Assets" Text="" VerticalAlignment="Center" Width="22"/>
                                            <TextBlock Text="外观与动效" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}" Tag="media" Uid="媒体与播放 音乐 播放 暂停 换曲 窗口 联动 动画 网易云 QQ Spotify 酷狗 酷我 Apple">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:GlyphIcon FontFamily="Segoe MDL2 Assets" Text="" VerticalAlignment="Center" Width="22"/>
                                            <TextBlock Text="媒体与播放" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}" Tag="focus" Uid="番茄钟 专注 休息 计时 循环 提示音">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:GlyphIcon FontFamily="Segoe MDL2 Assets" Text="" VerticalAlignment="Center" Width="22"/>
                                            <TextBlock Text="番茄钟" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}" Tag="behavior" Uid="交互与工具 剪切板 敏感内容 文件中转站 快速启动 统计">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:GlyphIcon FontFamily="Segoe MDL2 Assets" Text="" VerticalAlignment="Center" Width="22"/>
                                            <TextBlock Text="交互与工具" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}" Tag="notifications" Uid="通知与提醒 消息 静默 权限 过滤 音量 蓝牙 连接 启动 问候">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:GlyphIcon FontFamily="Segoe MDL2 Assets" Text="" VerticalAlignment="Center" Width="22"/>
                                            <TextBlock Text="通知与提醒" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}" Tag="system" Uid="系统状态 网速 下载 内存 功率 麦克风 摄像头 隐私指示灯">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:GlyphIcon FontFamily="Segoe MDL2 Assets" Text="" VerticalAlignment="Center" Width="22"/>
                                            <TextBlock Text="系统状态" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}" Tag="assistant" Uid="智能助手">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:GlyphIcon Text="" Width="22" VerticalAlignment="Center"/>
                                            <TextBlock Text="智能助手" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}" Tag="ai" Uid="AI 对话 大模型 密钥 agent 桥接 审批 端口">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:GlyphIcon FontFamily="Segoe MDL2 Assets" Text="" VerticalAlignment="Center" Width="22"/>
                                            <TextBlock Text="AI / Agent" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}" Tag="plugins" Uid="插件 模块 扩展 启用 禁用 开发">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:GlyphIcon FontFamily="Segoe MDL2 Assets" Text="" VerticalAlignment="Center" Width="22"/>
                                            <TextBlock Text="插件" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource W11NavItem}" Tag="about" Uid="关于 版本 运行环境">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:GlyphIcon FontFamily="Segoe MDL2 Assets" Text="" VerticalAlignment="Center" Width="22"/>
                                            <TextBlock Text="关于" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                                <Border x:Name="NavSelectionIndicator" Background="{StaticResource W11AccentBrush}" CornerRadius="1.5" Width="3" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <TranslateTransform/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    <!-- ===== 内容区 ===== -->
                    <ScrollViewer x:Name="SettingsContentScroll" Grid.Column="1" Padding="24,20,24,28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <StackPanel Visibility="Visible" x:Name="Page_General">
                                <TextBlock Style="{StaticResource W11PageTitle}" Text="常规"/>
                                <TextBlock Margin="0,26,0,12" Style="{StaticResource W11CardTitle}" Text="维护"/>
                                <Border Style="{StaticResource W11SettingCard}">
                                    <Grid Style="{StaticResource W11Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource W11IconTile}" x:Name="Icon_Reset">
                                            <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource W11RowLabel}" Text="重置所有设置"/>
                                        </StackPanel>
                                        <Button Click="ResetDefaultsButton_Click" Content="恢复默认设置" Grid.Column="2" Style="{StaticResource W11Button}" VerticalAlignment="Center" x:Name="ResetDefaultsButton"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <!-- ========== 外观 ========== -->
                            <StackPanel Visibility="Collapsed" x:Name="Page_Appearance">
                                <TextBlock Style="{StaticResource W11PageTitle}" Text="外观与动效"/>
                                <TextBlock Margin="0,26,0,12" Style="{StaticResource W11CardTitle}" Text="视觉效果"/>
                                <StackPanel>
                                    <StackPanel>
                                        <StackPanel x:Name="ReduceEffectsRows"/>
                                        <Border Style="{StaticResource W11SettingCard}">
                                            <Grid Style="{StaticResource W11Row}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource W11IconTile}" x:Name="Icon_GlassOpacity">
                                                    <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource W11RowLabel}" Text="玻璃不透明度"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Slider IsSnapToTickEnabled="False" LargeChange="0.05" Maximum="0.98" Minimum="0.05" SmallChange="0.01" Style="{StaticResource W11Slider}" Value="0.08" ValueChanged="Slider_Changed" Width="140" x:Name="GlassOpacitySlider"/>
                                                    <TextBlock Style="{StaticResource W11Value}" x:Name="GlassOpacityValue"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,24,0,0" x:Name="AppearanceAudioBranch">
                                    <TextBlock Text="音频可视化" Style="{StaticResource W11CardTitle}" Margin="0,0,0,12"/>
                                    <StackPanel x:Name="AppearanceAudioContent">
                                        <StackPanel Orientation="Vertical">
                                            <Border Style="{StaticResource W11SettingCard}">
                                                <Grid Style="{StaticResource W11Row}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_Visualizer">
                                                        <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="启用音频可视化"/>
                                                    </StackPanel>
                                                    <CheckBox Checked="Setting_Changed" Grid.Column="2" IsChecked="True" Style="{StaticResource W11Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="VisualizerToggle"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource W11SettingCard}">
                                                <Grid Style="{StaticResource W11Row}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_Wave">
                                                        <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="波形渲染层"/>
                                                    </StackPanel>
                                                    <CheckBox Checked="Setting_Changed" Grid.Column="2" IsChecked="True" Style="{StaticResource W11Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="ShowWaveToggle"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource W11SettingCard}">
                                                <Grid Style="{StaticResource W11Row}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_Sensitivity">
                                                        <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="律动灵敏度"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Slider IsSnapToTickEnabled="False" LargeChange="0.2" Maximum="2.6" Minimum="0.4" SmallChange="0.05" Style="{StaticResource W11Slider}" Value="1.0" ValueChanged="Slider_Changed" Width="140" x:Name="SensitivitySlider"/>
                                                        <TextBlock Style="{StaticResource W11Value}" x:Name="SensitivityValue"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,26,0,12" Style="{StaticResource W11CardTitle}" Text="设备"/>
                                        <Border Style="{StaticResource W11SettingCard}">
                                            <Grid Style="{StaticResource W11Row}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource W11IconTile}" x:Name="Icon_Device">
                                                    <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource W11RowLabel}" Text="监听设备"/>
                                                    <TextBlock Style="{StaticResource W11RowHint}" Text="默认系统输出设备" x:Name="AudioDeviceText"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,24,0,0" x:Name="AppearanceLyricsBranch">
                                    <TextBlock Text="歌词" Style="{StaticResource W11CardTitle}" Margin="0,0,0,12"/>
                                    <StackPanel x:Name="AppearanceLyricsContent">
                                        <StackPanel Orientation="Vertical">
                                            <Border Style="{StaticResource W11SettingCard}">
                                                <Grid Style="{StaticResource W11Row}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_Lyrics">
                                                        <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="启用实时歌词"/>
                                                    </StackPanel>
                                                    <CheckBox Checked="Setting_Changed" Grid.Column="2" IsChecked="True" Style="{StaticResource W11Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="LyricsToggle"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource W11SettingCard}">
                                                <Grid Style="{StaticResource W11Row}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_Translation">
                                                        <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="展示翻译歌词"/>
                                                    </StackPanel>
                                                    <CheckBox Checked="Setting_Changed" Grid.Column="2" IsChecked="True" Style="{StaticResource W11Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="TranslationToggle"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource W11SettingCard}">
                                                <Grid Style="{StaticResource W11Row}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource W11IconTile}" x:Name="Icon_LyricsOffset">
                                                        <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource W11RowLabel}" Text="歌词时间微调"/>
                                                        <TextBlock Style="{StaticResource W11RowHint}" Text="负数提前，正数延后"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Slider IsSnapToTickEnabled="True" LargeChange="100" Maximum="1500" Minimum="-1500" SmallChange="50" Style="{StaticResource W11Slider}" TickFrequency="50" Value="0" ValueChanged="Slider_Changed" Width="140" x:Name="LyricsOffsetSlider"/>
                                                        <TextBlock Style="{StaticResource W11Value}" x:Name="LyricsOffsetValue"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,26,0,12" Style="{StaticResource W11CardTitle}" Text="数据源"/>
                                        <Border Style="{StaticResource W11SettingCard}" x:Name="LyricsSourceCard">
                                            <Grid Style="{StaticResource W11Row}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource W11IconTile}" x:Name="Icon_Source">
                                                    <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource W11RowLabel}" Text="歌词源"/>
                                                    <TextBlock Style="{StaticResource W11RowHint}" Text="未连接" x:Name="LyricsSourceText"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
