<Window AllowsTransparency="False" Background="{StaticResource WindowBackgroundBrush}" Closing="Window_Closing" FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" Foreground="White" Height="420" ResizeMode="NoResize" ShowInTaskbar="True" TextOptions.TextRenderingMode="Grayscale" Title="Alpha Island 设置" UseLayoutRounding="True" Width="760" WindowStartupLocation="Manual" WindowStyle="None" x:Class="alpha_island.Settings.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自绘标题栏 -->
        <Grid Background="Transparent" Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Fill="{StaticResource AccentCyan}" Height="10" Margin="0,0,10,0" Width="10"/>
                <TextBlock FontSize="14" Style="{StaticResource PageTitle}" Text="Alpha Island 设置" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Click="CloseButton_Click" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" Height="28" HorizontalAlignment="Right" Margin="0,0,8,0" Style="{StaticResource TransportButton}" VerticalAlignment="Center" Width="36" x:Name="CloseButton"/>
        </Grid>

        <!-- 主体区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="172"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0" Grid.Column="0" Padding="12,12,12,12">
                <StackPanel Orientation="Vertical">
                    <RadioButton Checked="Nav_Checked" GroupName="nav" IsChecked="True" Style="{StaticResource SettingsNavItem}" Tag="appearance">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE790;" VerticalAlignment="Center" Width="20"/>
                            <TextBlock Text="外观" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource SettingsNavItem}" Tag="island">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" VerticalAlignment="Center" Width="20"/>
                            <TextBlock Text="岛屿与动效" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource SettingsNavItem}" Tag="audio">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9E9;" VerticalAlignment="Center" Width="20"/>
                            <TextBlock Text="音频可视化" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource SettingsNavItem}" Tag="lyrics">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D2;" VerticalAlignment="Center" Width="20"/>
                            <TextBlock Text="歌词" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource SettingsNavItem}" Tag="behavior">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" VerticalAlignment="Center" Width="20"/>
                            <TextBlock Text="行为" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Checked="Nav_Checked" GroupName="nav" Style="{StaticResource SettingsNavItem}" Tag="about">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" VerticalAlignment="Center" Width="20"/>
                            <TextBlock Text="关于" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- 右侧内容 -->
            <ScrollViewer Grid.Column="1" Padding="28,16,28,24" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- 外观 -->
                    <Grid Visibility="Visible" x:Name="Page_Appearance">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Style="{StaticResource PageTitle}" Text="外观"/>
                            <TextBlock Margin="0,4,0,16" Style="{StaticResource PageSubtitle}" Text="自定义毛玻璃与视觉渲染效果"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="玻璃不透明度"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="调节悬浮岛主体的半透明模糊深度"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider IsSnapToTickEnabled="False" LargeChange="0.05" Maximum="0.96" Minimum="0.45" SmallChange="0.01" Value="0.85" ValueChanged="Slider_Changed" VerticalAlignment="Center" Width="140" x:Name="GlassOpacitySlider"/>
                                            <TextBlock Margin="8,0,0,0" Style="{StaticResource SettingsValue}" TextAlignment="Right" Width="45" x:Name="GlassOpacityValue"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="流动玻璃质感"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="启用液态玻璃高光与边缘微光折射"/>
                                        </StackPanel>
                                        <CheckBox Checked="Setting_Changed" Grid.Column="1" IsChecked="True" Style="{StaticResource Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="LiquidGlassToggle"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="果冻弹性动画"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="在展开和收起时应用非线性回弹果冻动效"/>
                                        </StackPanel>
                                        <CheckBox Checked="Setting_Changed" Grid.Column="1" IsChecked="True" Style="{StaticResource Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="GelAnimationToggle"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 岛屿与动效 -->
                    <Grid Visibility="Collapsed" x:Name="Page_Island">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Style="{StaticResource PageTitle}" Text="岛屿与动效"/>
                            <TextBlock Margin="0,4,0,16" Style="{StaticResource PageSubtitle}" Text="调整灵动岛的展开逻辑与元素显示"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="两段式展开"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="支持紧凑态到胶囊态、胶囊态到大卡片的分级交互"/>
                                        </StackPanel>
                                        <CheckBox Checked="Setting_Changed" Grid.Column="1" IsChecked="True" Style="{StaticResource Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="TwoStepExpandToggle"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="展示专辑封面"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="在扩展区域展示当前播放音轨的封面图"/>
                                        </StackPanel>
                                        <CheckBox Checked="Setting_Changed" Grid.Column="1" IsChecked="True" Style="{StaticResource Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="ShowCoverToggle"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 音频可视化 -->
                    <Grid Visibility="Collapsed" x:Name="Page_Audio">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Style="{StaticResource PageTitle}" Text="音频可视化"/>
                            <TextBlock Margin="0,4,0,16" Style="{StaticResource PageSubtitle}" Text="WASAPI 环回实时音频能量捕获与呈现"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="启用音频可视化"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="开启频谱律动及能量条反馈"/>
                                        </StackPanel>
                                        <CheckBox Checked="Setting_Changed" Grid.Column="1" IsChecked="True" Style="{StaticResource Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="VisualizerToggle"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="波形渲染层"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="渲染平滑动态波纹背景层"/>
                                        </StackPanel>
                                        <CheckBox Checked="Setting_Changed" Grid.Column="1" IsChecked="True" Style="{StaticResource Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="ShowWaveToggle"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="律动灵敏度"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="调整音频捕获幅度增益"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider IsSnapToTickEnabled="False" LargeChange="0.2" Maximum="2.6" Minimum="0.4" SmallChange="0.05" Value="1.0" ValueChanged="Slider_Changed" VerticalAlignment="Center" Width="140" x:Name="SensitivitySlider"/>
                                            <TextBlock Margin="8,0,0,0" Style="{StaticResource SettingsValue}" TextAlignment="Right" Width="45" x:Name="SensitivityValue"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="监听设备"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="默认系统输出设备" x:Name="AudioDeviceText"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 歌词 -->
                    <Grid Visibility="Collapsed" x:Name="Page_Lyrics">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Style="{StaticResource PageTitle}" Text="歌词"/>
                            <TextBlock Margin="0,4,0,16" Style="{StaticResource PageSubtitle}" Text="配置歌词解析与双语对照展示"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="启用实时歌词"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="在岛屿扩展态中滚动展示动态歌词"/>
                                        </StackPanel>
                                        <CheckBox Checked="Setting_Changed" Grid.Column="1" IsChecked="True" Style="{StaticResource Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="LyricsToggle"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="展示翻译歌词"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="如果源歌词包含译文，则同时显示双语"/>
                                        </StackPanel>
                                        <CheckBox Checked="Setting_Changed" Grid.Column="1" IsChecked="True" Style="{StaticResource Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="TranslationToggle"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="歌词源"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="未连接" x:Name="LyricsSourceText"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 行为 -->
                    <Grid Visibility="Collapsed" x:Name="Page_Behavior">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Style="{StaticResource PageTitle}" Text="行为"/>
                            <TextBlock Margin="0,4,0,16" Style="{StaticResource PageSubtitle}" Text="交互逻辑与运行配置"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="播放时保持紧凑"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="媒体播放时不自动扩展为胶囊状态"/>
                                        </StackPanel>
                                        <CheckBox Checked="Setting_Changed" Grid.Column="1" Style="{StaticResource Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="KeepCompactToggle"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="换曲提示"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="切歌时弹出胶囊，显示新曲名和「接下来」"/>
                                        </StackPanel>
                                        <CheckBox Checked="Setting_Changed" Grid.Column="1" IsChecked="True" Style="{StaticResource Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="UpNextToggle"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="提示停留时长"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="超过这个时间没有操作就自动收回细条"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider IsSnapToTickEnabled="True" LargeChange="1" Maximum="20" Minimum="2" SmallChange="1" TickFrequency="1" Value="5" ValueChanged="Slider_Changed" VerticalAlignment="Center" Width="140" x:Name="UpNextSlider"/>
                                            <TextBlock Margin="8,0,0,0" Style="{StaticResource SettingsValue}" TextAlignment="Right" Width="45" x:Name="UpNextValue"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="重置所有设置"/>
                                            <TextBlock Style="{StaticResource SettingsRowHint}" Text="将偏好设置还原至系统默认初始状态"/>
                                        </StackPanel>
                                        <Button Background="#1FFFFFFF" Click="ResetDefaultsButton_Click" Content="恢复默认设置" Foreground="White" Grid.Column="1" Padding="14,7" VerticalAlignment="Center" x:Name="ResetDefaultsButton">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="9"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 关于 -->
                    <Grid Visibility="Collapsed" x:Name="Page_About">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Style="{StaticResource PageTitle}" Text="关于"/>
                            <TextBlock Margin="0,4,0,16" Style="{StaticResource PageSubtitle}" Text="软件与运行时信息"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock LineHeight="20" Style="{StaticResource SettingsRowHint}" Text="Alpha Island — Windows 灵动岛原型 / WPF · .NET 8 / 监听 SMTC + WASAPI 环回" TextWrapping="Wrap" x:Name="AboutText"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>