                                        <Grid Style="{StaticResource W11Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource W11IconTile}" x:Name="Icon_PowerWatts">
                                                <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource W11RowLabel}" Text="功耗提示阈值"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2">
                                                <TextBox Style="{StaticResource W11TextBox}" Width="98" MinHeight="32" VerticalContentAlignment="Center" TextAlignment="Right" TextChanged="NumericSetting_Changed" MaxLength="16" x:Name="PowerNotifyWattsBox"/>
                                                <TextBlock Text="W" Style="{StaticResource W11RowHint}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,24,0,12" Style="{StaticResource W11CardTitle}" Text="隐私"/>
                                <StackPanel>
                                    <Border Style="{StaticResource W11SettingCard}">
                                        <Grid Style="{StaticResource W11Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource W11IconTile}" x:Name="Icon_SystemTodo">
                                                <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource W11RowLabel}" Text="麦克风 / 摄像头占用灯"/>
                                            </StackPanel>
                                            <CheckBox Checked="Setting_Changed" Grid.Column="2" Style="{StaticResource W11Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="PrivacyIndicatorToggle"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,24,0,12" Style="{StaticResource W11CardTitle}" Text="每日流量"/>
                                <StackPanel>
                                    <Border Style="{StaticResource W11SettingCard}">
                                        <Grid Style="{StaticResource W11Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource W11IconTile}" x:Name="Icon_TrafficMonitorLink">
                                                <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource W11RowLabel}" Text="记录每日流量"/>
                                                <TextBlock Style="{StaticResource W11RowHint}" Text="在本机保存每日上传和下载总量，重启后继续统计" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Checked="Setting_Changed" Grid.Column="2" Style="{StaticResource W11Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="DailyTrafficToggle"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,24,0,12" Style="{StaticResource W11CardTitle}" Text="下载进度"/>
                                <StackPanel>
                                    <Border Style="{StaticResource W11SettingCard}">
                                        <Grid Style="{StaticResource W11Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource W11IconTile}" x:Name="Icon_DownloadMonitor">
                                                <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource W11RowLabel}" Text="下载状态（浏览器 / Steam）"/>
                                            </StackPanel>
                                            <CheckBox Checked="Setting_Changed" Grid.Column="2" Style="{StaticResource W11Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="DownloadMonitorToggle"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <!-- ========== AI / Agent ========== -->
                            <StackPanel Visibility="Collapsed" x:Name="Page_Ai">
                                <TextBlock Style="{StaticResource W11PageTitle}" Text="AI / Agent"/>
                                <TextBlock Text="对话和本机 Agent 已移至插件设置，可独立启用或卸载。" Style="{StaticResource W11RowHint}"/>
                                <Button Content="打开插件设置" Click="OpenAiPluginSettings_Click" HorizontalAlignment="Left" Margin="0,12,0,4"/>
                                <TextBlock Margin="0,24,0,12" Style="{StaticResource W11CardTitle}" Text="Agent"/>
                                <StackPanel>
                                    <Border Style="{StaticResource W11SettingCard}">
                                        <Grid Style="{StaticResource W11Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource W11IconTile}" x:Name="Icon_AgentStatus">
                                                <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource W11RowLabel}" Text="agent 状态"/>
                                            </StackPanel>
                                            <CheckBox Checked="Setting_Changed" Grid.Column="2" IsChecked="True" Style="{StaticResource W11Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="AgentStatusToggle"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource W11SettingCard}">
                                        <Grid Style="{StaticResource W11Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource W11IconTile}" x:Name="Icon_AgentBridge">
                                                <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource W11RowLabel}" Text="agent 桥接"/>
                                                <TextBlock Style="{StaticResource W11RowHint}" Text="仅接受本机连接"/>
                                            </StackPanel>
                                            <CheckBox Checked="Setting_Changed" Grid.Column="2" Style="{StaticResource W11Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="AgentBridgeToggle"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource W11SettingCard}">
                                        <Grid Style="{StaticResource W11Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource W11IconTile}" x:Name="Icon_AgentBridgePort">
                                                <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource W11RowLabel}" Text="桥接端口"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                <TextBox x:Name="AgentBridgePortBox" Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource W11TextPrimary}" Foreground="{StaticResource W11TextPrimary}" FontSize="12" Width="70" TextChanged="TextBox_Changed"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource W11SettingCard}">
                                        <Grid Style="{StaticResource W11Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource W11IconTile}" x:Name="Icon_AgentApproval">
                                                <icons:GlyphIcon Style="{StaticResource W11IconGlyph}" Text=""/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource W11RowLabel}" Text="工具权限审批通知"/>
                                                <TextBlock Style="{StaticResource W11RowHint}" Text="Y 允许，N 拒绝"/>
                                            </StackPanel>
                                            <CheckBox Checked="Setting_Changed" Grid.Column="2" IsChecked="True" Style="{StaticResource W11Switch}" Unchecked="Setting_Changed" VerticalAlignment="Center" x:Name="AgentApprovalToggle"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <!-- ========== 关于 ========== -->
                            <StackPanel Visibility="Collapsed" x:Name="Page_Plugins">
                                <TextBlock Style="{StaticResource W11PageTitle}" Text="插件"/>
                                <StackPanel Orientation="Horizontal" Margin="0,22,0,12">
                                    <Button Content="刷新插件列表" Click="RefreshPlugins_Click"/>
                                    <Button Content="打开插件目录" Click="OpenPluginsFolder_Click" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource W11RowHint}" TextWrapping="Wrap" Margin="2,0,2,16" Text="新插件默认关闭；更新已加载插件后需重启"/>
                                <StackPanel x:Name="PluginRows"/>
                            </StackPanel>
                            <StackPanel Visibility="Collapsed" x:Name="Page_About">
                                <TextBlock Style="{StaticResource W11PageTitle}" Text="关于"/>
                                <Border Margin="0,26,0,0" Style="{StaticResource W11SettingCard}">
                                    <Grid Style="{StaticResource W11Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image x:Name="AboutBrandIcon" Width="48" Height="48" Source="pack://application:,,,/alpha-island;component/Assets/alpha-island-source.png" Stretch="Uniform" VerticalAlignment="Center">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,48,48" RadiusX="10" RadiusY="10"/>
                                            </Image.Clip>
                                        </Image>
                                        <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource W11TextPrimary}" Text="Alpha Island"/>
                                            <TextBlock x:Name="AboutVersionText" FontSize="12.5" Foreground="{StaticResource W11TextSecondary}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="0,24,0,12" Style="{StaticResource W11CardTitle}" Text="运行环境"/>
                                <Border Style="{StaticResource W11Card}">
                                    <TextBlock LineHeight="20" Margin="16,16,16,16" Style="{StaticResource W11RowHint}" Text="WPF · .NET 8 · 监听 SMTC + WASAPI 环回" TextWrapping="Wrap" x:Name="AboutText"/>
                                </Border>
                                <TextBlock Margin="0,24,0,12" Style="{StaticResource W11CardTitle}" Text="能力检测"/>
                                <Border Style="{StaticResource W11Card}">
                                    <TextBlock LineHeight="20" Margin="16,14,16,14" Style="{StaticResource W11RowHint}" Text="读取中…" TextWrapping="Wrap" x:Name="CapabilityText"/>
                                </Border>
                                <TextBlock Margin="0,24,0,12" Style="{StaticResource W11CardTitle}" Text="服务状态"/>
                                <Border Style="{StaticResource W11Card}">
                                    <TextBlock LineHeight="20" Margin="16,14,16,14" Style="{StaticResource W11RowHint}" Text="读取中…" TextWrapping="Wrap" x:Name="ServiceText"/>
                                </Border>
                                <TextBlock Margin="0,24,0,12" Style="{StaticResource W11CardTitle}" Text="最近日志"/>
                                <Border Style="{StaticResource W11Card}">
                                    <TextBox AcceptsReturn="True" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource W11TextTertiary}" HorizontalScrollBarVisibility="Auto" IsReadOnly="True" Margin="12" MaxHeight="200" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" x:Name="LogText"/>
                                </Border>
                                <WrapPanel Margin="0,16,0,4" Orientation="Horizontal">
                                    <Button Click="CopyDiagnosticsButton_Click" Content="复制报告" Style="{StaticResource W11Button}" x:Name="CopyDiagnosticsButton"/>
                                    <Button Click="OpenLogFolderButton_Click" Content="打开日志目录" Margin="10,0,0,0" Style="{StaticResource W11Button}" x:Name="OpenLogFolderButton"/>
                                    <Button Click="ExportDiagnosticsButton_Click" Content="导出诊断包" Margin="10,0,0,0" Style="{StaticResource W11Button}" x:Name="ExportDiagnosticsButton"/>
                                    <Button Click="OpenConfigFolderButton_Click" Content="打开配置目录" Margin="10,0,0,0" Style="{StaticResource W11Button}" x:Name="OpenConfigFolderButton"/>
                                </WrapPanel>
                                <TextBlock Margin="2,6,0,0" Style="{StaticResource W11RowHint}" Text="诊断包中的密钥已隐藏" TextWrapping="Wrap" x:Name="DiagnosticsHint"/>
                            </StackPanel>
                            <StackPanel Visibility="Collapsed" x:Name="Page_Assistant">
                                <TextBlock Style="{StaticResource W11PageTitle}" Text="智能助手"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
        <Border BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed" IsHitTestVisible="False" x:Name="SettingsSaveStatus">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource W11ControlFill}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource W11ControlBorder}"/>
                    <Style.Triggers>
                        <Trigger Property="Tag" Value="saved">
                            <Setter Property="Background" Value="#1F563A"/>
                            <Setter Property="BorderBrush" Value="#3B9A68"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="已保存" Foreground="{StaticResource W11TextPrimary}" FontSize="12" x:Name="SettingsSaveStatusText"/>
        </Border>
    </Grid>
</Window>
