<Window xmlns:loc="clr-namespace:AlphaIsland.PluginSdk.Localization;assembly=AlphaIsland.PluginSdk" x:Class="alpha_island.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="clr-namespace:AlphaIsland.PluginSdk;assembly=AlphaIsland.PluginSdk"
        xmlns:controls="clr-namespace:alpha_island.Controls"
        xmlns:animation="clr-namespace:alpha_island.Animation"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:pluginUi="clr-namespace:AlphaIsland.PluginSdk;assembly=AlphaIsland.PluginSdk"
        Title="Alpha Island"
        Icon="/alpha-island;component/Assets/alpha-island.ico"
        Width="1200" Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewDragEnter="Window_DragEnter"
        PreviewDragOver="Window_DragOver"
        PreviewDragLeave="Window_DragLeave"
        PreviewDrop="Window_Drop"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <!-- 根容器：包含岛附近的顶部拖放感应区与居中岛体 -->
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <AdornerDecorator>
       <Grid x:Name="IslandScene">
        <!-- 只在岛外拖动靠近时临时启用；实际文件载荷经 OLE 验证后才展开。 -->
        <Border x:Name="TopDropZone"
                Height="60"
                Width="560"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Background="{x:Null}"
                AllowDrop="True"
                IsHitTestVisible="False"
                Panel.ZIndex="0"/>

        <!-- 岛体容器：岛体始终水平居中、贴屏幕顶部 -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="1">
            <!-- ============ 岛体本体：液态玻璃 ============
                 所有材质层共用 IslandBody.CornerRadius（用 Binding 跟随），
                 所以动画器只改一个 CornerRadius，内阴影/流光/高光全部同步变形。 -->
            <Border x:Name="IslandBody"
                Width="130" Height="10"
                CornerRadius="0,0,10,10"
                ClipToBounds="True"
                Cursor="Hand"
                BorderThickness="1"
                BorderBrush="{StaticResource GlassEdgeBrush}"
                AllowDrop="True"
                MouseEnter="IslandBody_MouseEnter"
                MouseLeftButtonDown="IslandBody_MouseLeftButtonDown"
                PreviewMouseLeftButtonDown="IslandBody_PreviewMouseLeftButtonDown"
                PreviewMouseMove="IslandBody_PreviewMouseMove"
                PreviewMouseLeftButtonUp="IslandBody_PreviewMouseLeftButtonUp"
                PreviewMouseRightButtonUp="IslandBody_PreviewMouseRightButtonUp"
                PreviewMouseWheel="IslandBody_PreviewMouseWheel"
                RenderTransformOrigin="0.5,0.5">
            <Border.Background>
                <LinearGradientBrush x:Name="GlassGradient" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="GlassTopStop" Color="#D916161D" Offset="0"/>
                    <GradientStop x:Name="GlassBottomStop" Color="#E509090D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.RenderTransform>
                <!-- 顺序很重要：先挤压形变，再位移。
                     反过来的话 IsolaTranslate.Y 会被 ScaleY 在窗口坐标里缩放，
                     贴顶位置会随挤压量上下漂。 -->
                <TransformGroup>
                    <ScaleTransform x:Name="IslandSquash" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="IslandTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <!-- 以圆角内阴影和高光表现厚度。外投影会在圆角外重新产生淡色像素。 -->

            <controls:RoundedClipGrid x:Name="IslandSurface"
                                      CornerRadius="{Binding CornerRadius, ElementName=IslandBody}"
                                      BorderInset="{Binding BorderThickness, ElementName=IslandBody}">
                <!-- ⓪ 流体波浪层：整岛最底层，满幅出血。
                     必须放在"岛体根容器"里（而不是 CardLayer 里）——
                     放在 CardLayer 里时它的绘制区域会被 CardLayer 的 392 宽布局盒裁掉，
                     左右各剩 14px 的纯玻璃黑边（实测屏幕 764..1152 vs 岛体 750..1170）。
                     由 IslandSurface 的真实圆角几何裁切；ClipToBounds 只能裁矩形。 -->
                <controls:WaveVisualizer x:Name="CardWave"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                         Margin="-2"
                                         IsHitTestVisible="False"
                                         Opacity="0"
                                         PointCount="56"
                                         Amplitude="1.25"
                                         BassBoost="0.68" Smoothing="0.35"
                                         Sensitivity="2.0"
                                         FillOpacity="0.50"
                                         GlowRadius="14" GlowOpacity="0.55"
                                         IsActive="False">
                    <!-- 下缘化开：波浪的色量本来就堆在底部，正好压着进度条。
                         使用较低透明度与背景融合。 -->
                    <controls:WaveVisualizer.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#B3FFFFFF" Offset="0.55"/>
                            <GradientStop Color="#59FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </controls:WaveVisualizer.OpacityMask>
                </controls:WaveVisualizer>

                <!-- 充放电动态光波纹特效（全岛体底层背景展开，不遮挡任何内容层） -->
                <controls:BatteryRippleEffect x:Name="BatteryRipple" IsHitTestVisible="False"/>

                <!-- ① 内层厚度：让玻璃看起来有壁厚而不是一张纸 -->
                <Border Margin="1"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBody}"
                        Background="{StaticResource GlassInnerShadowBrush}"
                        IsHitTestVisible="False"/>

                <!-- ② 折射流光：凝胶形变时横向扫过（IslandAnimator 驱动 SheenTranslate.X） -->
                <Border x:Name="SheenLayer"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBody}"
                        Background="{StaticResource GlassSheenBrush}"
                        Opacity="0.55"
                        IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SheenTranslate" X="0" Y="0"/>
                    </Border.RenderTransform>
                </Border>

                <!-- ③ 顶缘高光 -->
                <Rectangle Height="1" VerticalAlignment="Top" Margin="14,1,14,0"
                           Fill="{StaticResource GlassTopHighlightBrush}"
                           IsHitTestVisible="False"/>

                <!-- ③b 镜面高光条：凝胶形变时随形变量加长，并沿顶边滑行
                     （IslandAnimator 逐帧驱动 Width / Opacity / SpecularTranslate.X） -->
                <Rectangle x:Name="SpecularBar" Height="2" RadiusX="1" RadiusY="1"
                           Width="90" Opacity="0"
                           VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,1,0,0"
                           Fill="{StaticResource GlassTopHighlightBrush}"
                           IsHitTestVisible="False">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="SpecularTranslate" X="0" Y="0"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- ③c 细条常驻指示（网速 / 内存）：细条态右/中侧常驻数字。
                     细条只有 10px 高，字号压到 8px 才放得下（数字与箭头都没有下伸部，不会被裁）；
                     显隐由 MainWindow.SyncBarIndicators() 控制（只有 Bar 态 + 主弹簧收满 + 至少一侧有内容时才画），
                     整层不参与命中测试，细条整条仍是拖拽/点击热区。 -->
                <Grid x:Name="BarSpeedLayer" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="BarSpeedDownText" FontSize="8" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Text=""/>
                        <TextBlock x:Name="BarSpeedUpText" FontSize="8" FontWeight="SemiBold" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextSecondary}" Text=""/>
                        <!-- 内存占用百分比：没有流量时它就是细条上唯一的内容 -->
                        <TextBlock x:Name="BarMemText" FontSize="8" FontWeight="SemiBold" Margin="8,0,0,0"
                                   Foreground="{StaticResource TextTertiary}" Text=""/>
                        <!-- 麦克风 / 摄像头占用小圆点：各自独立亮灭。
                             颜色与屏幕右上角那盏灯一致（橙=麦克风 / 绿=摄像头，对齐 iOS 17）。 -->
                        <StackPanel x:Name="BarPrivacyDots" Margin="8,0,0,0" Orientation="Horizontal"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <Ellipse x:Name="BarMicDot" Fill="#FFFF9F0A" Height="4" Visibility="Collapsed" Width="4"/>
                            <Ellipse x:Name="BarCamDot" Fill="#FF30D158" Height="4" Margin="4,0,0,0"
                                     Visibility="Collapsed" Width="4"/>
                        </StackPanel>
                        <!-- agent 运行状态色点：颜色随状态走（思考紫/输出青/等授权黄/出错红），
                             空闲时整点收起 —— 细条上不能常驻一个"什么也没干"的点。 -->
                        <Ellipse x:Name="BarAgentDot" Fill="#FF8A5CFF" Height="6" Margin="8,0,0,0"
                                 Visibility="Collapsed" Width="6"/>
                    </StackPanel>
                </Grid>

                <!-- ================= 一级展开：长椭圆 =================
                     左侧圆角封面 + 中间当前歌词 + 右侧可视化 -->
                <Grid x:Name="PillLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PillLayerScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="PillLayerTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="PillCoverHost" Grid.Column="0"
                            Width="32" Height="32" CornerRadius="8"
                            BorderBrush="#33FFFFFF" BorderThickness="1"
                            Background="#1AFFFFFF" ClipToBounds="True">
                        <Grid>
                            <icons:GlyphIcon x:Name="PillCoverPlaceholder" Text="&#xE767;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="#8CFFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <ImageBrush x:Name="PillCoverBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 中间歌词：放得下就居中静止，放不下就先让岛体变宽、实在放不下再走马灯。
                         宽度实测、换行过场与伸缩动画由 MainWindow.UpdatePillLyricScroll() 负责。
                         两层结构：Stage 负责换行的"上移 + 淡入"，Track 负责跑马灯的横向位移，
                         两个通道各用一条 TranslateTransform，互不打断。 -->
                    <Grid x:Name="PillLyricHost" Grid.Column="1" Margin="10,0"
                          ClipToBounds="True" VerticalAlignment="Center"
                          SizeChanged="PillLyricHost_SizeChanged">
                        <Grid x:Name="PillLyricStage" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <!-- 换行过场：新歌词从下方 +RollDistance 处上移到 0 -->
                                    <TranslateTransform x:Name="PillLyricRoll"/>
                                    <!-- 跑马灯：整条轨道的横向位移（含居中偏移） -->
                                    <TranslateTransform x:Name="PillLyricScroll"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <StackPanel x:Name="PillLyricTrack" Orientation="Horizontal"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="PillLyric"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="Alpha Island"/>
                                <!-- 跑马灯的第二份：接在第一份后面，形成无缝循环 -->
                                <TextBlock x:Name="PillLyricEcho"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="56,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>

                        <controls:LyricBeatDots x:Name="PillBeatDots" Width="48" Height="20"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="{StaticResource TextPrimary}" Visibility="Collapsed"/>
                        <!-- 上一句歌词：换行时留在原处继续上移并淡出。单独一层，
                             所以淡出过程中新歌词已经可以同时从下方上移淡入（交叉过场）。 -->
                        <TextBlock x:Name="PillLyricGhost"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Opacity="0" IsHitTestVisible="False">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="PillLyricGhostRoll"/>
                                    <TranslateTransform x:Name="PillLyricGhostScroll"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>

                    <!-- 一级胶囊右侧：音频频谱（缩减至五段，统一色相无渐变，柱体胶囊形，多出宽度留给歌词） -->
                    <Grid Grid.Column="2" Width="Auto" Height="26">
                        <controls:SpectrumVisualizer x:Name="PillSpectrum"
                                                     Width="28" Height="22"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     BarCount="5" BarGap="2.5" UniformColor="True"
                                                     MinBarHeight="2.5" CenterEmphasis="0.40"
                                                     GlowRadius="1.6" GlowOpacity="0.26"
                                                     IsActive="False"/>

                        <!-- 换曲 / 暂停提示：右侧状态指示 -->
                        <StackPanel x:Name="PillUpNext" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed" IsHitTestVisible="False" Opacity="0">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="PillUpNextTranslate" Y="0"/>
                            </StackPanel.RenderTransform>
                            <controls:SemanticIcon x:Name="PillUpNextIcon" animation:ActionIconMotion.Kind="Pulse" Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentCyan}"/>
                            <TextBlock x:Name="PillUpNextText" Text="{loc:Text Key=SA52D704CC3AC}"
                                       FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="ResourceStatusNotifyLayer" Opacity="0" Width="212" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <controls:SystemStatusPill x:Name="ResourceStatusRates"/>
                </Grid>
                <Grid x:Name="ChargingNotifyLayer" Opacity="0" Width="132" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <controls:BatteryChargePill x:Name="ChargingPrimary"/>
                </Grid>
                <!-- ================= 启动问候层（与 PillLayer 同级同尺寸） ================= -->
                <Grid x:Name="GreetingLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <controls:WelcomeLogoIcon x:Name="GreetingIcon" Grid.Column="0"/>
                    <Image x:Name="GreetingCustomImage" Grid.Column="0" Width="32" Height="32"
                           Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"/>


                    <!-- 中间：欢迎文字 -->
                    <TextBlock x:Name="GreetingText" Grid.Column="0" Grid.ColumnSpan="3" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Text="{loc:Text Key=SCB1D97794707}"/>

                    <!-- 右侧：品牌徽标 -->
                    <Border Grid.Column="2" Padding="8,4" CornerRadius="10"
                            Background="#1AFFFFFF" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="Alpha Island" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </Border>
                </Grid>

                <!-- ================= 蓝牙通知层（与 PillLayer 同级同尺寸，互斥显示） =================
                     蓝牙设备连接时弹出：左侧二维设备图片/矢量图标、中间设备名称、右侧电量。
                     布局尺寸与 PillLayer 完全一致，复用 Pill 形态的 IslandBody 尺寸。 -->
                <Grid x:Name="BtNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：缓存的二维音频设备图片或专属外设图标 -->
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            ClipToBounds="True" Background="#1AFFFFFF" x:Name="BtIconContainer"
                            animation:ActionIconMotion.Kind="Connect" IsHitTestVisible="False">
                        <Grid>
                            <Image x:Name="BtDeviceArt" Width="27" Height="27" Stretch="Uniform"
                                   IsHitTestVisible="False" Visibility="Collapsed"/>
                            <controls:SemanticIcon x:Name="BtDeviceIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="27" Width="27" Height="27"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimary}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- 中间：蓝牙设备名称 -->
                    <TextBlock x:Name="BtDeviceName" Grid.Column="1"
                               Margin="10,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               Text="{loc:Text Key=SBDEA4F0A1CCC}"/>

                    <!-- 右侧：连接状态 + 电池图标 + 电量百分比 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock x:Name="BtStatusText" Text="{loc:Text Key=S5BE0323E8ADC}" FontSize="11" Margin="0,0,6,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                        <pluginUi:DeviceBatteryIndicator x:Name="BtBatteryIcon" Width="28" Height="16"
                                                        VerticalAlignment="Center"/>
                        <TextBlock x:Name="BtBatteryText"
                                   FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="—"/>
                    </StackPanel>
                </Grid>

                <!-- ================= 系统音量调节层（与 PillLayer 同级同尺寸，互斥显示） =================
                     音量调节时弹出：左侧自适应音量图标、中间音量进度条、右侧数字百分比。 -->
                <Grid x:Name="VolumeNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Cursor="Hand" ToolTip="{loc:Text Key=S36FDEF39C56F}"
                      MouseLeftButtonDown="VolumeNotifyLayer_MouseLeftButtonDown"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：音量状态圆形徽标（随音量大小和静音状态变化） -->
                    <Border x:Name="VolumeIconContainer" Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#2200E5FF" BorderBrush="#3300E5FF" BorderThickness="1">
                        <controls:SemanticIcon x:Name="VolumeIcon" animation:ActionIconMotion.Kind="Pulse" Text="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#00E5FF"/>
                    </Border>

                    <!-- 中间：音量大小进度条 -->
                    <Grid x:Name="VolumeTrackContainer" Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Height="24"
                          Background="Transparent" Cursor="Hand"
                          PreviewMouseLeftButtonDown="CardVolumeSliderTrack_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="CardVolumeSliderTrack_MouseMove"
                          PreviewMouseLeftButtonUp="CardVolumeSliderTrack_MouseLeftButtonUp"
                          LostMouseCapture="CardVolumeSliderTrack_LostMouseCapture"
                          MouseEnter="VolumeTrack_MouseEnter" MouseLeave="VolumeTrack_MouseLeave">
                        <Grid x:Name="VolumeCapsule" Height="5" Background="{DynamicResource IslandTrackBrush}" VerticalAlignment="Center"
                              IsHitTestVisible="False" SizeChanged="VolumeCapsule_SizeChanged">
                            <Border x:Name="VolumeProgressFill" Background="{DynamicResource AccentCyan}" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                    </Grid>

                    <!-- 右侧：数字形式展现 -->
                    <TextBlock x:Name="VolumeText" Grid.Column="2"
                               Margin="0,0,4,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Text="50%"/>
                </Grid>

                <!-- ================= 完整系统状态栏（手动展开或置顶，异常另用精简提醒） ================= -->
                <Grid x:Name="NetSpeedNotifyLayer" Opacity="0" Width="284" Height="36"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <controls:NetworkSpeedPill x:Name="NetSpeedRates"/>
                </Grid>

                <Grid x:Name="ChargingPreviewNotifyLayer" Opacity="0" Width="132" Height="40"
                      HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <controls:BatteryChargePill x:Name="ChargingPreviewPrimary"/>
                </Grid>

                <!-- ================= 下载进度提示层（浏览器 / Steam 下载期间常显） =================
                     数据来自 MainWindow.Downloads.cs：下载中每拍（2s）续期一次，所以它是**常显**的；
                     下载完成时同一层换成「下载完成」再挂 6 秒。进度百分比放在右侧大字上，一眼能看到。 -->
                <Grid x:Name="DownloadNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#2234D399" BorderBrush="#3334D399" BorderThickness="1">
                        <controls:SemanticIcon x:Name="DownloadNotifyGlyph" Shape="Download" animation:ActionIconMotion.Kind="Tick" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#34D399"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DownloadNotifyTitle" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Text="{loc:Text Key=S06B2117D58CC}"/>
                        <TextBlock x:Name="DownloadNotifyDetail" FontSize="10.5" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSecondary}" Text=""/>
                    </StackPanel>

                    <TextBlock x:Name="DownloadNotifyValue" Grid.Column="2" Margin="0,0,4,0"
                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                               Foreground="#34D399" Text=""/>
                </Grid>

                <!-- ================= 系统状态通用提示层（共用） =================
                     网速异常/内存偏高/功率/无线开关/隐私灯都用这一层：图标字形、标题、说明、右侧数值
                     全部由代码在弹出前写入（SysNotifyGlyph/Title/Detail/Value），
                     所以加新提示不需要再加 XAML 层，只要 _layers.ShowSeconds("system", n)。 -->
                <Grid x:Name="SystemNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#2222D3EE" BorderBrush="#3322D3EE" BorderThickness="1">
                        <controls:SemanticIcon x:Name="SysNotifyGlyph" animation:ActionIconMotion.Kind="Pulse" Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#22D3EE"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SysNotifyTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextPrimary}" Text=""/>
                        <TextBlock x:Name="SysNotifyDetail" FontSize="10.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSecondary}" Text=""/>
                    </StackPanel>

                    <TextBlock x:Name="SysNotifyValue" Grid.Column="2" Margin="0,0,4,0"
                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Text=""/>
                </Grid>

                <!-- ================= agent 运行状态层（思考 / 输出 / 等待授权 / 出错） =================
                     状态由 Core\AgentStatus.cs 统一持有（AI 卡片页与将来的桥接都写它）。
                     这一层是被 AgentStatus.Changed 与 1 秒 ticker 共同驱动的：只要状态不是 Idle 就占住胶囊，
                     音乐图层自动让位（IslandLayerHost 的 ForceActive 语义），归零时由 SyncNotificationLayers 收回。 -->
                <Grid x:Name="AgentNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#228A5CFF" BorderBrush="#338A5CFF" BorderThickness="1">
                        <controls:SemanticIcon x:Name="AgentNotifyGlyph" Shape="Agent" animation:ActionIconMotion.Kind="Pulse" Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#8A5CFF"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AgentNotifyTitle" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Text="{loc:Text Key=S43CE458CAE49}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="AgentNotifyDetail" FontSize="10.5" Margin="0,1,0,0"
                                   Foreground="{StaticResource TextSecondary}" Text=""
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock x:Name="AgentNotifyValue" Grid.Column="2" Margin="0,0,4,0"
                               VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}" Text=""/>
                </Grid>

                <!-- ================= agent 工具权限审批层 =================
                     外部 agent 通过本机回环 HTTP（Services\AgentBridgeService.cs）发起审批，
                     这里只负责"显示 + 收 Y/N + 把裁决回传"。标准 Button 负责按下、捕获与松手点击，
                     整层由 IslandLayerHost 在可见时才打开 IsHitTestVisible（见 SyncNotificationLayers）。 -->
                <Grid x:Name="ApprovalLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#228A5CFF" BorderBrush="#338A5CFF" BorderThickness="1">
                        <controls:SemanticIcon x:Name="ApprovalGlyph" animation:ActionIconMotion.Kind="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#8A5CFF"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ApprovalTitle" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Text="{loc:Text Key=S1013F506764E}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ApprovalDetail" FontSize="10" Margin="0,1,0,0"
                                   Foreground="{StaticResource TextSecondary}" Text=""
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ApprovalAllowButton" Style="{StaticResource ThemedButton}"
                                Background="#3334C759" BorderBrush="#6634C759"
                                BorderThickness="1" Margin="0,0,6,0" Padding="9,3" MinHeight="24"
                                ToolTip="{loc:Text Key=SE88E602BD959}" Click="ApprovalAllow_Click">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FFDFFFE6" Text="{loc:Text Key=S871A65227CCA}"/>
                        </Button>
                        <Button x:Name="ApprovalDenyButton" Style="{StaticResource ThemedButton}"
                                Background="#33FF5A5F" BorderBrush="#66FF5A5F"
                                BorderThickness="1" Padding="9,3" MinHeight="24"
                                Click="ApprovalDeny_Click">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FFFFE3E3" Text="{loc:Text Key=SBCB31FB4536F}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= 电池状态通知层（与 PillLayer 同级同尺寸，互斥显示） ================= -->
                <Grid x:Name="BatteryNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：电池状态圆形微光徽标 -->
                    <Border x:Name="BatteryIconContainer" Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#2200FF88" BorderBrush="#3300FF88" BorderThickness="1">
                        <controls:SemanticIcon x:Name="BatteryIcon" animation:ActionIconMotion.Kind="None" Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#00FF88"/>
                    </Border>

                    <!-- 中间：状态描述 -->
                    <TextBlock x:Name="BatteryStatusText" Grid.Column="1"
                               Margin="12,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               Text="{loc:Text Key=S04342BD4C5F6}"/>

                    <!-- 右侧：电量百分比 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <icons:GlyphIcon x:Name="BatteryBoltIcon" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Foreground="#00FF88" Margin="0,0,4,0"/>
                        <TextBlock x:Name="BatteryPercentText" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"
                                   Text="85%"/>
                    </StackPanel>
                </Grid>

                <!-- ================= 剪切板通知层（与 PillLayer 同级同尺寸，互斥显示） ================= -->
                <Grid x:Name="ClipboardNotifyLayer" Opacity="0" Width="328" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：剪切板圆形微光徽标 -->
                    <Border x:Name="ClipboardIconContainer" Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#2200F0FF" BorderBrush="#3300F0FF" BorderThickness="1">
                        <controls:SemanticIcon x:Name="ClipboardIcon" animation:ActionIconMotion.Kind="Tick" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentCyan}"/>
                    </Border>

                    <!-- 中间：状态与摘要 -->
                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ClipboardStatusTitle" Text="{loc:Text Key=S8F6F8D979C98}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <Border x:Name="ClipboardModeBadge" Margin="6,0,0,0" Padding="4,1" CornerRadius="4"
                                    Background="#2600F0FF" VerticalAlignment="Center">
                                <TextBlock x:Name="ClipboardModeBadgeText" Text="{loc:Text Key=SDD81861811E5}" FontSize="9" Foreground="{StaticResource AccentCyan}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ClipboardPreviewText" FontSize="10" Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Text="{loc:Text Key=SFB12AF752240}"/>
                    </StackPanel>
                </Grid>

                <!-- ================= 文件中转站层（Tray 态专用，尺寸 360x72） ================= -->
                <Grid x:Name="FileTransferLayer" Opacity="0" Width="360" Height="72"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False" Visibility="Collapsed">
                    <!-- 1. 拖放投放分区 (左复制 / 右剪切) -->
                    <Grid x:Name="DropZoneGrid" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：复制此文件 -->
                        <Border x:Name="DropZoneCopy" Grid.Column="0" CornerRadius="14"
                                AllowDrop="True"
                                DragEnter="DropZoneCopy_DragEnter"
                                DragOver="DropZoneCopy_DragOver"
                                DragLeave="DropZoneCopy_DragLeave"
                                Drop="DropZoneCopy_Drop"
                                Background="#1A00F0FF" BorderBrush="#3300F0FF" BorderThickness="1.2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <icons:GlyphIcon Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           VerticalAlignment="Center" Foreground="{StaticResource AccentCyan}"/>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Text Key=SBDE998EEDFE6}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{loc:Text Key=SBB1D6F6F7976}" FontSize="9.5" Foreground="{StaticResource TextTertiary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 右侧：剪切此文件 -->
                        <Border x:Name="DropZoneCut" Grid.Column="2" CornerRadius="14"
                                AllowDrop="True"
                                DragEnter="DropZoneCut_DragEnter"
                                DragOver="DropZoneCut_DragOver"
                                DragLeave="DropZoneCut_DragLeave"
                                Drop="DropZoneCut_Drop"
                                Background="#1AFF7043" BorderBrush="#33FF7043" BorderThickness="1.2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <icons:GlyphIcon Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           VerticalAlignment="Center" Foreground="#FF8855"/>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Text Key=SE193B6120119}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{loc:Text Key=S9D3569E10CF9}" FontSize="9.5" Foreground="{StaticResource TextTertiary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 2. 有文件时的横向列表展示 -->
                    <Grid x:Name="FileListGrid" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <ItemsControl x:Name="TransferItemsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="56" Height="64" Margin="4,0" CornerRadius="10"
                                                Background="#22FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                                Cursor="Hand" ToolTip="{Binding FullPath}"
                                                PreviewMouseLeftButtonDown="TransferItem_PreviewMouseLeftButtonDown"
                                                PreviewMouseRightButtonUp="TransferItem_PreviewMouseRightButtonUp"
                                                MouseMove="TransferItem_MouseMove">
                                            <Grid Margin="3">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="36"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <!-- 文件图标 -->
                                                <Image Grid.Row="0" Source="{Binding IconSource}" Width="28" Height="28"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- 文件名 -->
                                                <TextBlock Grid.Row="1" Text="{Binding FileName}" FontSize="9.5"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                                <!-- 剪切模式小标签 -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Padding="2,1" CornerRadius="3" Background="#80FF7043"
                                                        Visibility="{Binding IsCut, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="{loc:Text Key=S410A8E8A6BF2}" FontSize="7" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <WrapPanel Grid.Column="1" Width="60" Margin="4,0,0,0" VerticalAlignment="Center">
                            <Button x:Name="SendTransferFilesToAgentButton" Style="{StaticResource TransportButton}"
                                    Width="28" Height="28" Focusable="False" ToolTip="{loc:Text Key=S17CA54EBA6D7}"
                                    AutomationProperties.Name="{loc:Text Key=S0C7AABBCBE1E}" Click="SendTransferFilesToAgent_Click">
                                <icons:GlyphIcon Text="&#xE99A;" FontSize="17" Foreground="{StaticResource AccentCyan}"/>
                            </Button>
                            <Button x:Name="CloseFileTransferButton" Style="{StaticResource TransportButton}"
                                    FocusVisualStyle="{x:Null}" Focusable="False" Width="28" Height="28" Margin="4,0,0,0"
                                    ToolTip="{loc:Text Key=SFCF8FC0A543F}" Click="CloseFileTransferButton_Click">
                                <icons:GlyphIcon Text="&#xE711;" FontSize="11" Foreground="#8CFFFFFF"/>
                            </Button>
                            <Button x:Name="ClearFileTransferButton" Style="{StaticResource TransportButton}"
                                    FocusVisualStyle="{x:Null}" Focusable="False" Width="28" Height="28" Margin="0,4,0,0"
                                    ToolTip="{loc:Text Key=S07A72D6C2200}" Click="ClearFileTransferButton_Click">
                                <icons:GlyphIcon Text="&#xE74D;" FontSize="17" Foreground="#8CFFFFFF"/>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Grid>

                <!-- ================= 二级展开：卡片视口与分页指示器 (Win11 风格) ================= -->
                <!-- 固定尺寸 + 常驻 Visible：整棵卡片子树的测量/排列在岛体来回形变的全过程里都保持有效，
                     否则每次「收进小岛 → 展开」都要重新冷排版一次（实测 15~25ms，正好压在换态第一帧上，
                     用户感知为"点击后顿一下"）。隐藏靠 Opacity=0 + 岛体裁切 + IsHitTestVisible，不用 Collapsed。 -->
                <Grid x:Name="CardCarouselHost" Opacity="0" Margin="16,10,12,10" Width="402"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <!-- 卡片视口：裁切边界，平滑垂直滑动 -->
                    <!-- 高度会被代码在抽屉展开时临时撑高（见 MainWindow.xaml.cs 的 SetCardDrawerExtra），
                         否则 194 的固定视口会把"输出设备/音量合成器"面板下半截连同命中测试一起裁掉。 -->
                    <Grid x:Name="CardViewport" Grid.Column="0" Height="194" ClipToBounds="True">
                        <!-- 第一层 (Page 0)：媒体播放器 -->
                        <Grid x:Name="CardLayer" VerticalAlignment="Center" Height="164" Margin="6,4,6,4">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="CardPage0Translate" Y="0"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="52"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>

                            <!-- 行 0：封面和曲目信息独占头部，长歌名不再与播放控制争抢宽度。 -->
                            <Grid x:Name="MusicHeader" Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 封面槽：默认是 2D 圆角封面；开启「3D 封面」后换成 Viewport3D 里的
                                     3D 立体卡（场景在 MainWindow.Cover3D.cs 里用代码搭，方便调相机/光照）。
                                     两个子元素互斥显示，切换由 ApplyCover3DMode() 负责。 -->
                                <Grid x:Name="CardCoverHost" Grid.Column="0" Width="64" Height="64">
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14"/>
                                    </Grid.Clip>
                                    <Border x:Name="CardCover2D" CornerRadius="14"
                                            BorderBrush="#26FFFFFF" BorderThickness="1">
                                        <Border.Background>
                                            <ImageBrush x:Name="CardCoverBrush" Stretch="UniformToFill"/>
                                        </Border.Background>
                                        <icons:GlyphIcon x:Name="CardMediaPlaceholder" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextTertiary}"/>
                                    </Border>
                                    <Viewport3D x:Name="CardCover3D" Visibility="Collapsed" ClipToBounds="True"/>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               TextTrimming="CharacterEllipsis" Text="{loc:Text Key=S770DE45DF4A8}"/>
                                    <TextBlock x:Name="ArtistText" FontSize="12.5" Margin="0,4,0,0"
                                               Foreground="{StaticResource TextSecondary}"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               TextTrimming="CharacterEllipsis" Text=""/>
                                    <TextBlock x:Name="AlbumText" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{StaticResource TextTertiary}"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               TextTrimming="CharacterEllipsis" Text=""/>
                                </StackPanel>
                            </Grid>

                            <!-- 行 1：模式在左、传输居中、来源在右；侧边功能显隐不移动中央控制。 -->
                            <Grid x:Name="MusicControls" Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PlaybackOrderButton" Grid.Column="0" HorizontalAlignment="Left"
                                        Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="16"
                                        VerticalAlignment="Center" Visibility="Collapsed"
                                        FocusVisualStyle="{x:Null}" Focusable="False" Content="&#xE8EF;"
                                        ToolTip="{loc:Text Key=S5BBCAC595BC6}" Click="PlaybackOrderButton_Click"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PrevButton" Style="{StaticResource TransportButton}"
                                            Width="36" Height="36" FontSize="16" VerticalAlignment="Center"
                                            FocusVisualStyle="{x:Null}" Focusable="False"
                                            ToolTip="{loc:Text Key=SEECDC85924D6}" Content="&#xE892;" Click="PrevButton_Click"/>
                                    <Button x:Name="PlayPauseButton" Style="{StaticResource TransportButton}"
                                            Width="42" Height="42" VerticalAlignment="Center"
                                            FocusVisualStyle="{x:Null}" Focusable="False"
                                            Margin="14,0" Click="PlayPauseButton_Click">
                                        <controls:SemanticIcon x:Name="PlayPauseGlyph" animation:ActionIconMotion.Kind="Tick" FontSize="20" Text="&#xE768;"/>
                                    </Button>
                                    <Button x:Name="NextButton" Style="{StaticResource TransportButton}"
                                            Width="36" Height="36" FontSize="16" VerticalAlignment="Center"
                                            FocusVisualStyle="{x:Null}" Focusable="False"
                                            ToolTip="{loc:Text Key=S33AAF56B23A8}" Content="&#xE893;" Click="NextButton_Click"/>
                                </StackPanel>
                                <Button x:Name="MediaSourcesButton" Grid.Column="2" HorizontalAlignment="Right"
                                        Width="36" Height="36" FontSize="16" VerticalAlignment="Center"
                                        Content="&#xE70D;" Style="{StaticResource TransportButton}" ToolTip="{loc:Text Key=S88CF17B7FD6E}"
                                        Click="MediaSourcesButton_Click" AutomationProperties.Name="{loc:Text Key=S88CF17B7FD6E}"/>
                            </Grid>

                            <!-- 行 2：歌词区，与控制行保留清晰的间隔。 -->
                            <Grid x:Name="LyricsArea" Grid.Row="2" Visibility="Collapsed" Margin="0,8,0,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="26"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="LyricPrev" Grid.Row="0"
                                           FontSize="13" Foreground="#85FFFFFF" VerticalAlignment="Center"
                                           MaxWidth="370" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center">
                                    <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                    <TextBlock.Effect><BlurEffect Radius="2.2" RenderingBias="Performance"/></TextBlock.Effect>
                                </TextBlock>

                                <Grid x:Name="LyricCurrentHost" Grid.Row="1" MaxWidth="370" HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                                    <TextBlock x:Name="LyricCurrentDim"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="#BCFFFFFF"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LyricCurrentBright"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="#FAFFFFFF"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    <controls:LyricBeatDots x:Name="CardBeatDots" Width="64" Height="26"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Foreground="{StaticResource TextPrimary}" Visibility="Collapsed"/>
                                </Grid>

                                <TextBlock x:Name="LyricTranslation" Grid.Row="2"
                                           FontSize="11" Foreground="#B3FFFFFF" Height="17" Visibility="Collapsed"
                                           MaxWidth="370" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center">
                                    <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                </TextBlock>

                                <TextBlock x:Name="LyricNext" Grid.Row="3"
                                           FontSize="13" Foreground="#85FFFFFF" VerticalAlignment="Center"
                                           MaxWidth="370" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center">
                                    <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                    <TextBlock.Effect><BlurEffect Radius="2.2" RenderingBias="Performance"/></TextBlock.Effect>
                                </TextBlock>
                            </Grid>

                            <!-- 行 3：波浪视区 -->

                            <!-- 行 4：进度条 -->
                            <Grid Grid.Row="4" Margin="2,0,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="PositionText" Grid.Column="0" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="#8CFFFFFF" Text="0:00"/>

                                <Border x:Name="ProgressTrack" Grid.Column="1" Height="28" Margin="12,0"
                                        Background="Transparent" Cursor="Hand"
                                        MouseEnter="ProgressTrack_MouseEnter" MouseLeave="ProgressTrack_MouseLeave"
                                        MouseLeftButtonDown="ProgressTrack_MouseLeftButtonDown">
                                    <Grid x:Name="ProgressCapsule" Height="5" VerticalAlignment="Center"
                                          Background="{DynamicResource IslandTrackBrush}" IsHitTestVisible="False"
                                          SizeChanged="ProgressCapsule_SizeChanged">
                                        <Border x:Name="ProgressFill" Background="{DynamicResource AccentCyan}"
                                                HorizontalAlignment="Left" Width="0"/>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="#8CFFFFFF" Text="0:00"/>
                            </Grid>
                        </Grid>

                        <!-- 第二层 (Page 1)：剪切板及历史 -->
                        <Grid x:Name="ClipboardCardLayer" VerticalAlignment="Center" Height="194" Margin="4,0"
                              Opacity="0" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="CardPage1Translate" Y="194"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="148"/>
                                <RowDefinition Height="16"/>
                            </Grid.RowDefinitions>

                            <!-- 行 0：头部（标题、数量、清空按钮） -->
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <icons:GlyphIcon Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Text Key=S0E6A80351D44}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" Margin="8,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <Border CornerRadius="8" Background="#2600F0FF" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="ClipboardCountBadge" Text="{loc:Text Key=S797ECD1B8B14}" FontSize="9.5"
                                                   Foreground="{StaticResource AccentCyan}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- 清空所有记录 -->
                                    <Button x:Name="ClearClipboardButton"
                                            Width="28" Height="28" Cursor="Hand"
                                            FocusVisualStyle="{x:Null}" Focusable="False"
                                            ToolTip="{loc:Text Key=SFA7634376F65}" Click="ClearClipboardButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Width="28" Height="28" CornerRadius="14" Background="#18FFFFFF">
                                                    <icons:GlyphIcon Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 行 1：列表区 / 空状态 -->
                            <Grid Grid.Row="1" Margin="0,4,0,2">
                                <!-- 历史列表 -->
                                <ScrollViewer x:Name="ClipboardHistoryScroll" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ItemsControl x:Name="ClipboardHistoryList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="2,3,4,3" Padding="10,6" CornerRadius="8"
                                                        Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                                        Cursor="Hand" ToolTip="{loc:Text Key=S876A1818BF94}"
                                                        MouseLeftButtonDown="ClipboardHistoryItem_MouseLeftButtonDown">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#2AFFFFFF"/>
                                                                    <Setter Property="BorderBrush" Value="#4400F0FF"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 图标 -->
                                                        <icons:GlyphIcon Grid.Column="0" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="12" Foreground="{StaticResource AccentCyan}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                        <!-- 文本与时间 -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayText}" FontSize="11.5"
                                                                       Foreground="{StaticResource TextPrimary}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding TimeString}" FontSize="9"
                                                                       Foreground="{StaticResource TextTertiary}"
                                                                       Margin="0,1,0,0"/>
                                                        </StackPanel>

                                                        <!-- 复制历史内容 -->
                                                        <Button Grid.Column="2" Margin="6,0,4,0" Cursor="Hand"
                                                                FocusVisualStyle="{x:Null}" Focusable="False"
                                                                ToolTip="{loc:Text Key=S15A22A401549}" Click="CopyClipboardItem_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" CornerRadius="6" Background="#2600F0FF" BorderBrush="#3300F0FF" BorderThickness="1" Padding="7,3">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <icons:GlyphIcon Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                                       Foreground="{StaticResource AccentCyan}" Margin="0,0,3,0"/>
                                                                            <TextBlock Text="{loc:Text Key=S63D90D977348}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#4400F0FF"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#6600F0FF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <!-- 删除单项按钮 -->
                                                        <Button Grid.Column="3" Width="24" Height="24" Margin="2,0,0,0" Cursor="Hand"
                                                                FocusVisualStyle="{x:Null}" Focusable="False"
                                                                ToolTip="{loc:Text Key=SB435D3B56699}" Click="DeleteClipboardItem_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Width="24" Height="24" CornerRadius="12" Background="Transparent">
                                                                        <icons:GlyphIcon Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                                                   Foreground="{StaticResource TextTertiary}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- 空状态提示 -->
                                <StackPanel x:Name="ClipboardEmptyState" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                    <icons:GlyphIcon Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                               Foreground="#3DFFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{loc:Text Key=SFF7DC599517C}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                               Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- 行 2：底部提示 -->
                            <TextBlock x:Name="ClipboardHistoryHint" Grid.Row="2" Text="{loc:Text Key=S92C4FD86560B}"
                                       FontSize="9" Foreground="{StaticResource TextTertiary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 第三层 (Page 2)：系统音量调节卡片 -->
                        <Grid x:Name="VolumeCardLayer" VerticalAlignment="Center" Height="194" Opacity="0" IsHitTestVisible="False"
                              TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="CardPage2Translate" Y="194"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 行 0：头部栏（音量图标、设备名、当前数值、静音切换） -->
                            <Grid Grid.Row="0" Margin="6,6,6,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左侧图标徽标 -->
                                <Border x:Name="CardVolumeIconContainer" Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                        Background="#2200E5FF" BorderBrush="#3300E5FF" BorderThickness="1">
                                    <controls:SemanticIcon x:Name="CardVolumeIcon" animation:ActionIconMotion.Kind="Pulse" Text="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentCyan}"/>
                                </Border>

                                <!-- 标题与当前音频输出设备 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{loc:Text Key=S23FED14992D4}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="CardVolumeDeviceText" Text="{loc:Text Key=S97D3EF8AE7A9}" FontSize="10"
                                               Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- 右侧大字百分比与静音按钮 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="CardVolumePercentText" Text="50%" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <Button x:Name="CardVolumeMuteButton" Width="32" Height="32" Cursor="Hand"
                                            FocusVisualStyle="{x:Null}" Focusable="False"
                                            ToolTip="{loc:Text Key=SE3BC045003D3}" Click="CardVolumeMuteButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Width="32" Height="32" CornerRadius="16" Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                    <icons:GlyphIcon x:Name="MuteGlyph" Text="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 行 1：主体交互区（-5% 按钮 | 交互式拖动条 | +5% 按钮 + 预设组） -->
                            <Grid Grid.Row="1" Margin="6,0,6,0" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 主滑槽行（-5% 按钮 | 交互式拖动条 | +5% 按钮） -->
                                <Grid Grid.Row="0" Margin="0,6,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 减少音量微调按钮 -->
                                    <Button Grid.Column="0" Width="30" Height="30" Cursor="Hand"
                                            FocusVisualStyle="{x:Null}" Focusable="False"
                                            ToolTip="{loc:Text Key=S078231F0C727}" Click="CardVolumeDown_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="15" Background="#1FFFFFFF" BorderBrush="#2FFFFFFF" BorderThickness="1">
                                                    <icons:GlyphIcon Text="&#xE993;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- 交互式音量进度条槽（支持点击/拖拽定位） -->
                                    <Grid x:Name="CardVolumeSliderTrack" Grid.Column="1" Height="28" Margin="10,0" Cursor="Hand"
                                          Background="Transparent"
                                          PreviewMouseLeftButtonDown="CardVolumeSliderTrack_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="CardVolumeSliderTrack_MouseMove"
                                          PreviewMouseLeftButtonUp="CardVolumeSliderTrack_MouseLeftButtonUp"
                                          LostMouseCapture="CardVolumeSliderTrack_LostMouseCapture"
                                          MouseEnter="VolumeTrack_MouseEnter" MouseLeave="VolumeTrack_MouseLeave">
                                        <Grid x:Name="CardVolumeCapsule" Height="5" Background="{DynamicResource IslandTrackBrush}" VerticalAlignment="Center"
                                              IsHitTestVisible="False" SizeChanged="VolumeCapsule_SizeChanged">
                                            <Border x:Name="CardVolumeSliderFill" Background="{DynamicResource AccentCyan}" HorizontalAlignment="Left" Width="0"/>
                                        </Grid>
                                    </Grid>

                                    <!-- 增加音量微调按钮 -->
                                    <Button Grid.Column="2" Width="30" Height="30" Cursor="Hand"
                                            FocusVisualStyle="{x:Null}" Focusable="False"
                                            ToolTip="{loc:Text Key=S85A727CE0611}" Click="CardVolumeUp_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="15" Background="#1FFFFFFF" BorderBrush="#2FFFFFFF" BorderThickness="1">
                                                    <icons:GlyphIcon Text="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- 快捷折叠控制区：切换输出设备与音量合成器 -->
                                <StackPanel Grid.Row="1" Margin="0,2,0,0">
                                    <!-- 折叠栏 1：声音输出设备快捷切换 -->
                                    <Border x:Name="AudioDeviceHeader" Margin="0,2" CornerRadius="6"
                                            Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonDown="AudioDeviceHeader_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#22FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#4400F0FF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Height="34" Margin="10,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <icons:GlyphIcon Text="&#xE7F6;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                           Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{loc:Text Key=SD3A4DE1DAFE6}" FontSize="13" Foreground="{StaticResource TextTertiary}" Margin="8,0,2,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="CurrentDeviceNameLabel" Text="{loc:Text Key=S97D3EF8AE7A9}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" MaxWidth="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <icons:GlyphIcon x:Name="AudioDeviceChevron" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <icons:GlyphIcon.RenderTransform>
                                                    <RotateTransform x:Name="AudioDeviceChevronRotate" Angle="0"/>
                                                </icons:GlyphIcon.RenderTransform>
                                            </icons:GlyphIcon>
                                        </Grid>
                                    </Border>

                                    <!-- 输出设备展开面板 -->
                                    <Grid x:Name="AudioDevicePanel" Height="0" Opacity="0" ClipToBounds="True" Visibility="Collapsed">
                                        <Border CornerRadius="6" Background="#26000000" BorderBrush="#1FFFFFFF" BorderThickness="1" Margin="0,1,0,3" Padding="3">
                                            <ScrollViewer x:Name="AudioDeviceScroll" MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                                <ItemsControl x:Name="AudioDeviceList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,2" Padding="8,6" CornerRadius="8" Background="Transparent"
                                                                    Cursor="Hand" MouseLeftButtonDown="AudioDeviceItem_MouseLeftButtonDown">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#22FFFFFF"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextPrimary}"
                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    <icons:GlyphIcon Grid.Column="1" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9.5"
                                                                               Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"
                                                                               Visibility="{Binding CheckVisibility}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>

                                    <!-- 折叠栏 2：音量合成器快捷管理 -->
                                    <Border x:Name="VolumeMixerHeader" Margin="0,2" CornerRadius="6"
                                            Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonDown="VolumeMixerHeader_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#22FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#4400F0FF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Height="34" Margin="10,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <icons:GlyphIcon Text="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                           Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{loc:Text Key=S602A88354BB9}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <icons:GlyphIcon x:Name="VolumeMixerChevron" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <icons:GlyphIcon.RenderTransform>
                                                    <RotateTransform x:Name="VolumeMixerChevronRotate" Angle="0"/>
                                                </icons:GlyphIcon.RenderTransform>
                                            </icons:GlyphIcon>
                                        </Grid>
                                    </Border>

                                    <!-- 音量合成器展开面板 -->
                                    <Grid x:Name="VolumeMixerPanel" Height="0" Opacity="0" ClipToBounds="True" Visibility="Collapsed">
                                        <Border CornerRadius="10" Background="#26000000" BorderBrush="#1FFFFFFF" BorderThickness="1" Margin="0,1,0,3" Padding="6">
                                            <StackPanel>
                                                <Button Margin="0,1,0,6" Height="36" HorizontalAlignment="Stretch"
                                                        Cursor="Hand" Focusable="False" Click="OpenSystemVolumeMixer_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="MixerButtonBorder" CornerRadius="8" Background="#2000E5FF" BorderBrush="#3300E5FF" BorderThickness="1">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MixerButtonBorder" Property="Background" Value="#3500E5FF"/></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Border Padding="8,4">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <icons:GlyphIcon Text="&#xE7AC;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource AccentCyan}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{loc:Text Key=SD1E5A876DF56}" FontSize="13" Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Button>
                                                <ScrollViewer x:Name="VolumeAppSessionsScroll" MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                                    <ItemsControl x:Name="VolumeAppSessionsList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="8" Background="#0FFFFFFF" Margin="0,2" Padding="8,4">
                                                                <Grid>
                                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextPrimary}"
                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    <Button Grid.Column="1" Height="28" MinWidth="56" Cursor="Hand" Margin="8,0,0,0"
                                                                            Focusable="False" Click="ToggleAppMute_Click">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border CornerRadius="7" Background="#1FFFFFFF" BorderBrush="#2FFFFFFF" BorderThickness="1" Padding="8,3">
                                                                                    <TextBlock Text="{Binding MuteText}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                               Foreground="{Binding MuteColorBrush}"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <Slider Style="{StaticResource W11Slider}" Foreground="{DynamicResource AccentCyan}" Background="{DynamicResource IslandTrackBrush}" Grid.Row="1" Height="28" Margin="0,2,8,0" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                            IsMoveToPointEnabled="True" Value="{Binding VolumePercent, Mode=OneWay}" ToolTip="{Binding PercentText}"
                                                                            ValueChanged="AppVolumeSlider_ValueChanged" PreviewMouseWheel="AppVolumeSlider_PreviewMouseWheel"
                                                                            primitives:Thumb.DragStarted="AppVolumeSlider_DragStarted" primitives:Thumb.DragCompleted="AppVolumeSlider_DragCompleted"/>
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PercentText}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- 行 2：底部提示 -->
                        </Grid>

                        <!-- 第五层 (Page 4)：实时网速卡片
                             网速是"一直想看"的量：这里给实时上下行 + 最近 60 秒曲线；
                             细条上的常驻数字与「下载期间常显」的胶囊都由同一份采样驱动。 -->
                        <Grid x:Name="NetSpeedCardLayer" VerticalAlignment="Center" Height="224" Opacity="0" IsHitTestVisible="False">
                            <Grid.RenderTransform><TranslateTransform x:Name="CardPage4Translate" Y="582"/></Grid.RenderTransform>
                            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="6,4,6,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{loc:Text Key=SCA97BBC64F3D}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="NetSpeedCardStatusText" Text="{loc:Text Key=SA3CF429BD3C2}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="NetSpeedCardAdapterText" Text="—" FontSize="9.5" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="60" Height="60" CornerRadius="16" Background="#26223861">
                                    <controls:SemanticIcon x:Name="NetworkCardIcon" Shape="Network" Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center" animation:ActionIconMotion.Kind="Pulse"/>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="6,5,6,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Text Key=S7505B01C96A0}" FontSize="10.5" Foreground="#FF745D"/>
                                    <TextBlock x:Name="NetSpeedCardDownText" Text="—" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{loc:Text Key=SCA383B18E769}" FontSize="10.5" Foreground="#3D9CF5" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="NetSpeedCardUpText" Text="—" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Margin="6,4,6,6" CornerRadius="12" Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1">
                                <Grid Margin="8,5">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="NetSpeedCardPeakText" Text="{loc:Text Key=S69D0C0851269}" FontSize="9" Foreground="#FF745D" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="NetSpeedCardUpPeakText" Grid.Column="1" Text="{loc:Text Key=S724664D21A39}" FontSize="9" Foreground="#3D9CF5" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <controls:Sparkline x:Name="NetSpeedSparkline" Stroke="#FF745D" Fill="#16FF745D" StrokeThickness="1.6" Capacity="60"/>
                                        <controls:Sparkline x:Name="NetSpeedUpSparkline" Stroke="#3D9CF5" StrokeThickness="1.6" Capacity="60"/>
                                    </Grid>
                                    <TextBlock x:Name="NetSpeedCardHintText" Grid.Row="2" Text="{loc:Text Key=SC0962B106FA8}" FontSize="9" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 第六层 (Page 5)：系统状态卡片
                             内存 / 功耗 / 无线开关 / 隐私 合并成一页（用户拍板），四个格子各显示实时值；
                             对应服务没开时格子写"未开启"并指出去哪儿打开 —— 这一页本身始终能翻到、能看。 -->
                        <Grid x:Name="SystemCardLayer" VerticalAlignment="Center" Height="250" Opacity="0" IsHitTestVisible="False">
                            <Grid.RenderTransform><TranslateTransform x:Name="CardPage5Translate" Y="582"/></Grid.RenderTransform>
                            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="130"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="6,3,6,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Text Key=S9C073BBFE1AC}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="SystemCardSummaryText" Text="{loc:Text Key=SE53C16D1D56B}" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <controls:BatteryChargePill x:Name="SystemBatterySummary" Grid.Column="1" Compact="True" Height="32" VerticalAlignment="Center" Background="Transparent" Cursor="Hand"/>
                            </Grid>
                            <Border Grid.Row="1" Margin="6,0,6,6" CornerRadius="14" Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                                <Grid Margin="12,8">
                                    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Text Key=S4AD3901567CA}" FontSize="10" Foreground="{StaticResource TextTertiary}"/>
                                        <TextBlock x:Name="SysCardCpuValue" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Text Key=S5A2E604F7679}" FontSize="10" Foreground="{StaticResource TextTertiary}"/>
                                        <TextBlock x:Name="SysCardMemValue" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock x:Name="SysCardMemDetail" Text="{loc:Text Key=SA3CF429BD3C2}" FontSize="9" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text Key=S4AFA5374D5BD}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock x:Name="SysCardPowerDetail" Text="{loc:Text Key=S4E5277A2CE83}" FontSize="9" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SysCardBatteryDetail" Text="{loc:Text Key=S1BC98D7B8F01}" FontSize="9" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock x:Name="SysCardPowerValue" Grid.Column="1" Text="— W" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="2" Margin="6,0,6,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border CornerRadius="12" Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" Margin="0,0,3,0">
                                    <StackPanel Margin="10,7">
                                        <TextBlock Text="{loc:Text Key=S49FCF64DF81A}" FontSize="10" Foreground="{StaticResource TextTertiary}"/>
                                        <TextBlock x:Name="SysCardWirelessValue" Text="—" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0"/>
                                        <TextBlock x:Name="SysCardWirelessDetail" Text="" FontSize="9" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="12" Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" Margin="3,0,0,0">
                                    <StackPanel Margin="10,7">
                                        <TextBlock Text="{loc:Text Key=S2734C1C7846E}" FontSize="10" Foreground="{StaticResource TextTertiary}"/>
                                        <TextBlock x:Name="SysCardPrivacyValue" Text="—" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0"/>
                                        <TextBlock x:Name="SysCardPrivacyDetail" Text="" FontSize="9" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ============ 第 7 页：下载进度（浏览器 / Steam） ============
                         数据来自 MainWindow.Downloads.cs（只读浏览器 History 的 downloads 表 + Steam 的
                         appmanifest 清单）。固定三行，行内进度条宽度由代码按轨道实际宽度 × 比例设置。 -->
                    <Grid x:Name="DownloadCardLayer" VerticalAlignment="Center" Height="194" Opacity="0" IsHitTestVisible="False">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="CardPage6Translate" Y="582"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="6,6,6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                    Background="#2234D399" BorderBrush="#3334D399" BorderThickness="1">
                                <icons:GlyphIcon Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#34D399"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Text Key=S3A09E3140742}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="DownloadCardSummaryText" Text=""
                                           FontSize="9.5" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextTertiary}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="6,0,6,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid x:Name="DlRow1" Grid.Row="0" Margin="0,0,0,3" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DlName1" Grid.Row="0" FontSize="10.5" Text=""
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <Border x:Name="DlTrack1" Grid.Row="1" Height="4" CornerRadius="2"
                                        Margin="0,3,0,2" Background="#1FFFFFFF">
                                    <Border x:Name="DlFill1" Height="4" CornerRadius="2" Width="0"
                                            HorizontalAlignment="Left" Background="#34D399"/>
                                </Border>
                                <TextBlock x:Name="DlMeta1" Grid.Row="2" FontSize="8.5" Text=""
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextTertiary}"/>
                            </Grid>

                            <Grid x:Name="DlRow2" Grid.Row="1" Margin="0,0,0,3" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DlName2" Grid.Row="0" FontSize="10.5" Text=""
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <Border x:Name="DlTrack2" Grid.Row="1" Height="4" CornerRadius="2"
                                        Margin="0,3,0,2" Background="#1FFFFFFF">
                                    <Border x:Name="DlFill2" Height="4" CornerRadius="2" Width="0"
                                            HorizontalAlignment="Left" Background="#34D399"/>
                                </Border>
                                <TextBlock x:Name="DlMeta2" Grid.Row="2" FontSize="8.5" Text=""
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextTertiary}"/>
                            </Grid>

                            <Grid x:Name="DlRow3" Grid.Row="2" Margin="0,0,0,3" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DlName3" Grid.Row="0" FontSize="10.5" Text=""
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <Border x:Name="DlTrack3" Grid.Row="1" Height="4" CornerRadius="2"
                                        Margin="0,3,0,2" Background="#1FFFFFFF">
                                    <Border x:Name="DlFill3" Height="4" CornerRadius="2" Width="0"
                                            HorizontalAlignment="Left" Background="#34D399"/>
                                </Border>
                                <TextBlock x:Name="DlMeta3" Grid.Row="2" FontSize="8.5" Text=""
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextTertiary}"/>
                            </Grid>

                            <TextBlock x:Name="DownloadEmptyText" Grid.Row="0" Grid.RowSpan="3"
                                       Text="{loc:Text Key=SA760B56A062A}"
                                       FontSize="10" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="12,0,12,0"
                                       Foreground="{StaticResource TextTertiary}"/>
                        </Grid>
                    </Grid>

                </Grid>

                <!-- 收回动画中间态那颗球：默认显示**专辑封面**（圆形裁剪），取不到封面时退回 Siri 炫彩渐变。
                     外层名字保留 SiriOrb / SiriOrbTranslate，代码里的滑入与淡入淡出动画不用改。 -->
                <Grid x:Name="SiriOrb" Width="46" Height="46"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Opacity="0" IsHitTestVisible="False">
                    <Ellipse x:Name="OrbGradient">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#00F0FF" Offset="0"/>
                                <GradientStop Color="#7000FF" Offset="0.6"/>
                                <GradientStop Color="#FF007A" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse x:Name="OrbCover" Margin="5" Opacity="0">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="OrbCoverBrush" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="OrbCoverRing" Margin="5" Opacity="0"
                             Stroke="#4DFFFFFF" StrokeThickness="1"/>

                    <!-- 收缩过渡状态专属矢量图标（音量、外设、问候等） -->
                    <Border x:Name="OrbIconContainer" Margin="5" CornerRadius="18"
                            Opacity="0" ClipToBounds="True">
                        <icons:GlyphIcon x:Name="OrbIcon"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#FFFFFFFF"/>
                    </Border>

                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SiriOrbTranslate" X="-40" Y="0"/>
                    </Grid.RenderTransform>
                </Grid>
            </controls:RoundedClipGrid>
        </Border>
        </Grid>
            <!-- 外置切换线：独立于岛体裁切，共享岛体尺寸与挤压/位移，只在线条附近命中。 -->
            <Canvas Width="{Binding Width, ElementName=IslandBody}"
                    Height="{Binding Height, ElementName=IslandBody}"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    RenderTransform="{Binding RenderTransform, ElementName=IslandBody}"
                    RenderTransformOrigin="0.5,0.5" Panel.ZIndex="3">
                <controls:IslandContourHandle x:Name="ComponentHandle"
                    Canvas.Left="{Binding Width, ElementName=IslandBody}"
                    Width="28" Height="{Binding Height, ElementName=IslandBody}"
                    ContourCornerRadius="{Binding CornerRadius, ElementName=IslandBody}"
                    Visibility="Collapsed"/>
            </Canvas>

        <!-- 右侧置顶小胶囊提示（多岛分离胶囊动效） -->
        <Border x:Name="PinBubble"
                Width="84" Height="30"
                CornerRadius="15"
                Background="#E5101016"
                BorderBrush="{StaticResource GlassEdgeBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,21,0,0"
                Panel.ZIndex="2"
                ClipToBounds="True"
                Cursor="Arrow"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PinBubbleScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="PinBubbleTranslate" X="160" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <controls:RoundedClipGrid CornerRadius="{Binding CornerRadius, ElementName=PinBubble}"
                                      BorderInset="{Binding BorderThickness, ElementName=PinBubble}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <icons:GlyphIcon x:Name="PinBubbleIcon" Text="&#xE718;" FontFamily="Segoe MDL2 Assets"
                           FontSize="12" Foreground="{StaticResource AccentCyan}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="PinBubbleText" Text="{loc:Text Key=SFB47DB5E65FF}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" Margin="5,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            </controls:RoundedClipGrid>
        </Border>

        <!-- 卡片旁的缩略岛：展示其他活跃组件；点击切换并保持卡片展开。
             几何由 Core/SatelliteRail.cs 的左侧车道管理，跟随岛宽变化并避免重叠。 -->
        <Border x:Name="SideBubble"
                Width="112" Height="28"
                CornerRadius="14"
                Background="{Binding Background, ElementName=IslandBody}"
                BorderBrush="{StaticResource GlassEdgeBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,21,0,0"
                Panel.ZIndex="2"
                ClipToBounds="True"
                Cursor="Hand"
                PreviewMouseRightButtonUp="SideBubble_PreviewMouseRightButtonUp"
                IsHitTestVisible="True"
                Visibility="Collapsed"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SideBubbleScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="SideBubbleTranslate" X="-160" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <controls:RoundedClipGrid CornerRadius="{Binding CornerRadius, ElementName=SideBubble}"
                                      BorderInset="{Binding BorderThickness, ElementName=SideBubble}">
            <ContentControl x:Name="SideBubbleCustomContent" Visibility="Collapsed"/>
            <StackPanel x:Name="SideBubbleGeneric" Orientation="Horizontal" Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="SideBubbleIconSlot" Width="24" Height="24" VerticalAlignment="Center"
                      IsHitTestVisible="False" animation:ActionIconMotion.Kind="Pulse">
                    <Image x:Name="SideBubbleArtwork" Width="24" Height="24" Stretch="Uniform" Visibility="Collapsed"/>
                    <controls:SemanticIcon x:Name="SideBubbleIcon" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                               FontSize="22" Width="24" Height="24" Foreground="{StaticResource AccentCyan}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Margin="6,0,0,0">
                <TextBlock x:Name="SideBubbleText" Text="" FontSize="11" FontWeight="SemiBold"
                           MaxWidth="104" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SideBubbleDetail" FontSize="9" MaxWidth="104" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            </controls:RoundedClipGrid>
        </Border>

        <!-- 动态卫星小岛挂载容器（多岛并行显示：音量/下载/蓝牙等缩小为小岛） -->
        <Grid x:Name="SatellitesHost" Panel.ZIndex="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"/>

        <!-- 左侧音乐收缩圆球（多岛分离动效：置顶/播放中其他模块弹出时，音乐向左缩小成圆） -->
        <Border x:Name="MusicOrbBubble"
                Width="36" Height="36"
                CornerRadius="18"
                Background="#E5101016"
                BorderBrush="{StaticResource GlassEdgeBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"
                Panel.ZIndex="2"
                ClipToBounds="True"
                Cursor="Hand"
                IsHitTestVisible="True"
                Visibility="Collapsed"
                Opacity="0"
                ToolTip="{loc:Text Key=S999703C97DFE}"
                PreviewMouseRightButtonUp="MusicOrbBubble_PreviewMouseRightButtonUp"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MusicOrbScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="MusicOrbTranslate" X="-148" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <controls:RoundedClipGrid CornerRadius="{Binding CornerRadius, ElementName=MusicOrbBubble}"
                                      BorderInset="{Binding BorderThickness, ElementName=MusicOrbBubble}">
                <!-- 专辑封面底图（若无封面显示多彩微光渐变与音乐音符） -->
                <Ellipse x:Name="MusicOrbGradient">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#00F0FF" Offset="0"/>
                            <GradientStop Color="#7000FF" Offset="0.6"/>
                            <GradientStop Color="#FF007A" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <icons:GlyphIcon x:Name="MusicOrbPlaceholder" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                           FontSize="14" Foreground="#FFFFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse x:Name="MusicOrbCover" Margin="2" Opacity="0">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="MusicOrbCoverBrush" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Margin="2" Stroke="#4DFFFFFF" StrokeThickness="1"/>
                <icons:GlyphIcon x:Name="MusicOrbPinIcon" Text="&#xE718;" FontFamily="Segoe MDL2 Assets"
                           FontSize="8" Foreground="{StaticResource AccentCyan}"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,3,3,0" Visibility="Collapsed"/>
            </controls:RoundedClipGrid>
        </Border>
       </Grid>
      </AdornerDecorator>
    </Grid>
</Window>
